          const getRes = await fetch(apiUrl, {
            headers: { 'Authorization': `Bearer ${token}`, 'Accept': 'application/vnd.github+json' },
            cache: 'no-store'
          });
          if (getRes.ok) {
            const getData = await getRes.json();
            const decoded = decodeURIComponent(escape(atob(getData.content.replace(/\s/g, ''))));
            const liveConfig = JSON.parse(decoded);
            if (liveConfig.modules) {
              const m = liveConfig.modules;
              if (m.form !== undefined) conf.switches.form = m.form !== false && m.contactForm !== false;
              if (m.maps !== undefined) conf.switches.maps = m.maps !== false && m.googleMaps !== false;
