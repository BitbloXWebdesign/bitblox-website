    function getVaultClients() {
      try {
        const stored = localStorage.getItem('bitblox_vault_clients');
        if (!stored) {
          localStorage.setItem('bitblox_vault_clients', JSON.stringify(defaultVaultClients));
          return defaultVaultClients;
        }
        const parsed = JSON.parse(stored);
        if (!Array.isArray(parsed)) {
          localStorage.setItem('bitblox_vault_clients', JSON.stringify(defaultVaultClients));
          return defaultVaultClients;
        }

        const defaultMap = new Map(defaultVaultClients.map(c => [c.id, c]));
        const merged = defaultVaultClients.map(dc => {
          const storedItem = parsed.find(p => p.id === dc.id);
          if (storedItem) {
            const portalUrl = (storedItem.portalUrl && !storedItem.portalUrl.endsWith('/admin'))
              ? storedItem.portalUrl
              : dc.portalUrl;
            return {
              ...dc,
              ...storedItem,
              portalUrl: portalUrl || dc.portalUrl,
              username: storedItem.username || dc.username || 'admin',
              cfProject: storedItem.cfProject || dc.cfProject,
              kvNamespace: storedItem.kvNamespace || dc.kvNamespace,
              githubRepo: storedItem.githubRepo || dc.githubRepo
            };
          }
          return dc;
        });

        parsed.forEach(p => {
          if (!defaultMap.has(p.id)) merged.push(p);
        });

        localStorage.setItem('bitblox_vault_clients', JSON.stringify(merged));
        return merged;
      } catch (e) {
        return defaultVaultClients;
      }
    }

