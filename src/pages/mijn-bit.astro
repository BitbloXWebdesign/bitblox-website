    async function pushDirectToGitHub(repo, filePath, contentString, commitMsg) {
      const token = localStorage.getItem('bitblox_gh_token') || AUTO_GH_TOKEN;
      if (!token) return false;
      try {
        const apiUrl = `https://api.github.com/repos/${repo}/contents/${filePath}`;
        let sha = null;
        let existingConfig = {};
        try {
          const getRes = await fetch(apiUrl, {
            headers: { 'Authorization': `Bearer ${token}`, 'Accept': 'application/vnd.github+json' }
          });
          if (getRes.ok) {
            const getData = await getRes.json();
            sha = getData.sha;
            try {
              const decoded = decodeURIComponent(escape(atob(getData.content.replace(/\s/g, ''))));
              existingConfig = JSON.parse(decoded);
            } catch (e) {}
          }
        } catch (e) {}

        let finalPayload = contentString;
        if (filePath.endsWith('site-config.json') && existingConfig && typeof existingConfig === 'object') {
          try {
            const parsedNew = JSON.parse(contentString);
            const merged = { ...existingConfig, ...parsedNew, modules: { ...existingConfig.modules, ...parsedNew.modules }, updatedAt: new Date().toISOString() };
            finalPayload = JSON.stringify(merged, null, 2);
          } catch (e) {}
        }

        const base64Content = btoa(unescape(encodeURIComponent(finalPayload)));
        const putBody = {
          message: commitMsg || "Update schuifjes via BitbloX Admin Dashboard",
          content: base64Content,
          branch: "main"
        };
        if (sha) putBody.sha = sha;

        const putRes = await fetch(apiUrl, {
          method: 'PUT',
          headers: {
            'Authorization': `Bearer ${token}`,
            'Accept': 'application/vnd.github+json',
            'Content-Type': 'application/json'
          },
          body: JSON.stringify(putBody)
        });
        return putRes.ok;
      } catch (err) {
        console.warn('GitHub API Push Error:', err);
        return false;
      }
    }

