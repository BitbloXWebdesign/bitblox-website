        else if (compVal) displayLoc = compVal;
        else if (cityVal) displayLoc = cityVal;

        const initials = nameVal.split(' ').map(n => n[0]).join('').substring(0, 2).toUpperCase();

        const jsonObj = {
          id: Date.now(),
          name: nameVal,
          author: nameVal,
          location: displayLoc,
          rating: Number(ratingVal),
          text: textVal,
          initials: initials || 'G',
          date: 'Google Beoordeling'
        };

        const conf = clientConfigs[currentSelectedClient] || clientConfigs.bitblox;

        saveReviewBtn.textContent = '⏳ Opslaan & Publiceren...';
        saveReviewBtn.disabled = true;

        let ghPushed = false;
        const targetRepo = clientGithubRepoMap[currentSelectedClient];
        if (targetRepo) {
          try {
            const token = localStorage.getItem('bitblox_gh_token') || AUTO_GH_TOKEN;
            const apiUrl = `https://api.github.com/repos/${targetRepo}/contents/src/data/reviews.json`;
            let currentReviews = [];
            let sha = null;
            const getRes = await fetch(apiUrl, {
              headers: { 'Authorization': `Bearer ${token}`, 'Accept': 'application/vnd.github+json' }
            });
            if (getRes.ok) {
              const getData = await getRes.json();
              sha = getData.sha;
              try {
                const decoded = decodeURIComponent(escape(atob(getData.content.replace(/\s/g, ''))));
                currentReviews = JSON.parse(decoded);
              } catch (e) {}
            }

            // Unshift new review to the front
            currentReviews.unshift(jsonObj);

            // Direct Cloudflare KV API Push
            if (conf && conf.pagesUrl && clientPasswordMap[currentSelectedClient]) {
              try {
                await fetch(`${conf.pagesUrl}/api/content`, {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({
                    password: clientPasswordMap[currentSelectedClient],
                    key: 'reviews',
                    value: currentReviews
                  })
                });
              } catch(e) {
                console.warn('KV review push error:', e);
              }
            }

            ghPushed = await pushDirectToGitHub(
              targetRepo,
              'src/data/reviews.json',
              JSON.stringify(currentReviews, null, 2),
              `Google Review toegevoegd van ${nameVal}`
            );

            if (ghPushed) {
              if (!conf.reviews) conf.reviews = [];
              conf.reviews.unshift(jsonObj);
              updateClientUI(currentSelectedClient);

              reviewName.value = '';
              reviewText.value = '';
              if (reviewCompany) reviewCompany.value = '';
              if (reviewCity) reviewCity.value = '';

              if (saveReviewStatus) saveReviewStatus.textContent = `✅ Review van ${nameVal} direct opgeslagen & gepubliceerd! (Cloudflare bouwt nu)`;
              saveReviewBtn.textContent = '✅ Review Live Gepubliceerd!';
              setTimeout(() => {
                saveReviewBtn.textContent = '⭐ Bewaar Review';
              }, 4000);
            }
          } catch (err) {
            console.warn('Review save error:', err);
          }
        }

        if (!ghPushed) {
          // Local fallback
          if (!conf.reviews) conf.reviews = [];
          conf.reviews.unshift(jsonObj);
          updateClientUI(currentSelectedClient);

          try {
            const res = await fetch('/api/save-review', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                name: nameVal,
                company: compVal,
                city: cityVal,
                rating: ratingVal,
                text: textVal,
                date: 'Google Beoordeling',
                client: currentSelectedClient
              })
            });
            const resData = await res.json();
            if (resData.success) {
              if (saveReviewStatus) saveReviewStatus.textContent = `✅ Review toegevoegd!`;
              saveReviewBtn.textContent = '✅ Gepubliceerd!';
            } else {
              throw new Error();
            }
          } catch (e) {
            navigator.clipboard.writeText(reviewJsonString);
            if (saveReviewStatus) saveReviewStatus.textContent = `📋 Review opgeslagen in overzicht! (JSON gekopieerd)`;
            saveReviewBtn.textContent = '📋 Review Gekopieerd!';
          }
        }

        saveReviewBtn.disabled = false;
      });
    }

    // Run auth check and UI synchronization after full setup
    if (typeof window.checkBitbloxAuth === 'function') {
      window.checkBitbloxAuth();
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initBitbloxAdmin);
  } else {
    initBitbloxAdmin();
  }
})();
</script>
