---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm.astro';
---

<Layout 
  title="Wat kost een website laten maken? Transparant Kostenoverzicht 2026"
  description="Eerlijk overzicht van website kosten voor ZZP en MKB. Starter €295, Compleet €495, Pro €850 en zorgeloos beheer vanaf €149/jr bij BitbloX."
>
  <section class="page-hero">
    <div class="hero-grid-bg"></div>
    <div class="container page-hero-inner">
      <nav class="breadcrumb" aria-label="Kruimelpad"><a href="/">Home</a> <span>/</span> <span>Website Kosten</span></nav>
      <span class="kicker">Eerlijk &amp; Transparant</span>
      <h1>Wat kost een website <span class="text-gradient">laten maken?</span></h1>
      <p class="lead">De kosten voor het laten maken van een website lopen enorm uiteen: van €500 tot meer dan €5.000 bij traditionele bureaus. Bij BitbloX hanteren we vaste, overzichtelijke pakketprijzen zonder verrassingen achteraf.</p>
    </div>
  </section>

  <section class="section">
    <div class="container" style="max-width: 840px;">
      <div class="card" style="padding: 36px; background: var(--surface); border: 1px solid var(--border-gold); border-radius: var(--radius); margin-bottom: 32px;">
        <h2 style="font-size: 1.6rem; margin-bottom: 20px;">Onze transparante pakketprijzen:</h2>
        <ul style="display: flex; flex-direction: column; gap: 18px; font-size: 1.05rem;">
          <li style="border-bottom: 1px solid var(--border); padding-bottom: 12px;">
            <strong style="color: var(--gold);">Starter (€ 295,- eenmalig):</strong> 1-page converterende landingspagina, ideaal voor startende ZZP'ers met een heldere boodschap.
          </li>
          <li style="border-bottom: 1px solid var(--border); padding-bottom: 12px;">
            <strong style="color: var(--gold);">Compleet (€ 495,- eenmalig - Meest gekozen):</strong> Complete website tot 5 pagina's inclusief blog/kennisbank module, reviews, FAQ accordions en contactformulier.
          </li>
          <li style="border-bottom: 1px solid var(--border); padding-bottom: 12px;">
            <strong style="color: var(--gold);">Pro / Maatwerk (€ 850,- eenmalig):</strong> Uitgebreide website met meerdere stedenpagina's (microsites), maatwerk en geavanceerde AI-vindbaarheid.
          </li>
          <li style="border-bottom: 1px solid var(--border); padding-bottom: 12px;">
            <strong style="color: var(--gold);">Basis Beheer &amp; Domein (€ 149,- / jaar):</strong> Zeer snelle Cloudflare Edge hosting, .nl domein, tot 3 e-mailadressen en dagelijkse backups.
          </li>
          <li>
            <strong style="color: var(--gold);">Zorgeloos Beveiliging &amp; Conversie (€ 245,- / jaar):</strong> Alles van Basis + 24/7 Watchdog storingsmonitoring, interactieve Bel-Me-Terug widget, WhatsApp direct chat, meldingenbalk en 30 min kwartaalsupport.
          </li>
        </ul>

        <div style="margin-top: 28px; text-align: center;">
          <a href="/prijzen/" class="btn btn--gold">Bekijk het complete prijzenoverzicht →</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--alt" id="contact">
    <div class="container" style="max-width: 760px;">
      <ContactForm title="Bereken direct uw prijsopgave" />
    </div>
  </section>
</Layout>
