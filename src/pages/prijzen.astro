---
import Layout from '../layouts/Layout.astro';
import FAQ from '../components/FAQ.astro';
import ContactForm from '../components/ContactForm.astro';
import { pricing } from '../data/pricing';
---

<Layout 
  title="Tarieven & Prijzen 2026 — Webdesign, Beheer & SEO | BitbloX"
  description="Transparante tarieven voor webdesign (Brons €100, Zilver €250, Goud €450, Platina €650+), hosting (€149 - €195/jr), Conversie Suite (€119/jr) en SEO-onderhoud bij BitbloX. Prijzen excl. btw, 2 maanden opzegtermijn."
>
  <!-- ============ Page hero ============ -->
  <section class="page-hero">
    <div class="hero-grid-bg"></div>
    <div class="container page-hero-inner">
      <nav class="breadcrumb" aria-label="Kruimelpad"><a href="/">Home</a> <span>/</span> <span>Prijzen</span></nav>
      <span class="kicker">Transparante tarieven • Excl. BTW</span>
      <h1>Duidelijke prijzen, <span class="text-gradient">geen verrassingen</span></h1>
      <p class="lead">Van een converterende one-pager tot een complete website met meerdere stedenpagina's en actieve leadfuncties. Alle tarieven zijn exclusief btw. Doorlopende beheer- en onderhoudsdiensten hebben een heldere opzegtermijn van 2 maanden.</p>
    </div>
  </section>

  <!-- ============ 1. Webdesign Realisatie (Eenmalige Bouw) ============ -->
  <section class="section--tight" id="webdesign-prijzen">
    <div class="container">
      <div class="section-head reveal" style="margin-bottom: 48px;">
        <span class="kicker">Pijler 1 — Eenmalige Realisatie (Excl. BTW)</span>
        <h2>Website <span class="gold">ontwerp &amp; bouw</span></h2>
        <p class="lead">Eenmalige investering voor het professioneel ontwerpen, bouwen en inrichten van uw nieuwe website.</p>
      </div>

      <div class="grid grid--4">
        {pricing.webdesign.map((item, index) => (
          <article class={`price-card reveal ${item.featured ? 'featured' : ''} ${index > 0 ? 'reveal-delay-' + index : ''}`}>
            {item.featured && (
              <span class="price-badge">Meest gekozen</span>
            )}
            <div class="price-name">{item.name}</div>
            <div class="price-for">{item.subtitle}</div>
            <div class="price-amount">
              <span class="currency">€</span>
              <span class="amount">{item.amount}</span>
              <span class="per">{item.unit} <br/><small style="font-size: 0.72rem; color: var(--muted);">(excl. btw)</small></span>
            </div>
            <ul class="price-features">
              {item.features.map((feat) => (
                <li>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                  {feat}
                </li>
              ))}
            </ul>
            {item.roi && <p class="price-roi">{item.roi}</p>}
            <a href="#contact" class={`btn ${item.featured ? 'btn--gold' : 'btn--ghost'} btn--block`}>Offerte aanvragen</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ 2. Jaarlijkse Beheerdiensten, Hosting & Conversie ============ -->
  <section class="section section--alt" id="hosting-prijzen">
    <div class="container">
      <div class="section-head reveal" style="margin-bottom: 40px;">
        <span class="kicker">Pijler 2 — Jaarlijkse Fundering &amp; Conversie (Excl. BTW)</span>
        <h2>Hosting, beheer &amp; <span class="gold">conversie suite</span></h2>
        <p class="lead">Kies eerst uw gewenste hostingniveau (Stap 1) en voeg optioneel de krachtige Conversie Suite toe voor maximale leads (Stap 2). Prijzen excl. btw, per jaar gefactureerd met 2 maanden opzegtermijn.</p>
      </div>

      <!-- STAP 1: Hosting Fundering -->
      <div style="margin-bottom: 48px;">
        <div style="text-align: center; margin-bottom: 24px;">
          <span style="background: rgba(222, 193, 72, 0.15); color: var(--gold); border: 1px solid rgba(222, 193, 72, 0.3); padding: 6px 16px; border-radius: 999px; font-weight: 700; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.08em;">
            Stap 1: Kies uw Hosting Fundering
          </span>
        </div>
        <div class="grid grid--2" style="max-width: 900px; margin: 0 auto;">
          {pricing.hosting.map((item, index) => (
            <article class={`price-card reveal ${item.featured ? 'featured' : ''} ${index > 0 ? 'reveal-delay-' + index : ''}`}>
              {item.featured && (
                <span class="price-badge">⭐ Meest gekozen</span>
              )}
              <div class="price-name">{item.name}</div>
              <div class="price-for">{item.subtitle}</div>
              <div class="price-amount">
                <span class="currency">€</span>
                <span class="amount">{item.amount}</span>
                <span class="per">{item.unit} <br/><small style="font-size: 0.72rem; color: var(--muted);">(jaarlijks gefactureerd • excl. btw)</small></span>
              </div>
              <ul class="price-features">
                {item.features.map((feat) => (
                  <li>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                    {feat}
                  </li>
                ))}
              </ul>
              {item.roi && <p class="price-roi">{item.roi}</p>}
              <a href="#contact" class={`btn ${item.featured ? 'btn--gold' : 'btn--ghost'} btn--block`}>Kies {item.name}</a>
            </article>
          ))}
        </div>
      </div>

      <!-- STAP 2: Optionele Conversie & Interactie Suite Upgrade -->
      <div style="max-width: 900px; margin: 0 auto 48px auto;">
        <div style="text-align: center; margin-bottom: 24px;">
          <span style="background: rgba(222, 193, 72, 0.15); color: var(--gold); border: 1px solid rgba(222, 193, 72, 0.3); padding: 6px 16px; border-radius: 999px; font-weight: 700; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.08em;">
            Stap 2: Optionele Commerciële Upgrade
          </span>
        </div>

        <article class="price-card featured reveal" style="background: linear-gradient(180deg, rgba(222, 193, 72, 0.06) 0%, rgba(20, 22, 28, 0.95) 100%); border: 1px solid var(--gold); padding: 36px 32px;">
          <span class="price-badge">🚀 Meer Klanten &amp; Aanvragen</span>
          <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-start; gap: 20px; margin-bottom: 20px;">
            <div>
              <div class="price-name" style="font-size: 1.5rem; color: #fff;">{pricing.conversion.name}</div>
              <div class="price-for" style="max-width: 500px;">{pricing.conversion.subtitle}</div>
            </div>
            <div class="price-amount" style="margin: 0;">
              <span class="currency">€</span>
              <span class="amount">{pricing.conversion.amount}</span>
              <span class="per">{pricing.conversion.unit} <br/><small style="font-size: 0.72rem; color: var(--muted);">(jaarlijks gefactureerd • excl. btw)</small></span>
            </div>
          </div>

          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 14px; margin: 24px 0;">
            {pricing.conversion.features.map((feat) => (
              <div style="display: flex; align-items: flex-start; gap: 10px; font-size: 0.92rem; color: var(--text);">
                <svg viewBox="0 0 24 24" fill="none" stroke="var(--gold)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="width: 18px; height: 18px; flex-shrink: 0; margin-top: 2px;"><path d="M20 6 9 17l-5-5"/></svg>
                <span>{feat}</span>
              </div>
            ))}
          </div>

          {pricing.conversion.roi && (
            <p class="price-roi" style="margin-bottom: 20px;">
              💡 <strong>Rendement:</strong> {pricing.conversion.roi}
            </p>
          )}

          <a href="#contact" class="btn btn--gold btn--block" style="font-weight: 700;">Conversie Suite toevoegen aan aanvraag</a>
        </article>
      </div>

      <!-- Overzichtelijke Combinatietabel -->
      <div class="reveal" style="max-width: 900px; margin: 0 auto; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 28px 24px;">
        <h3 style="font-size: 1.15rem; margin-bottom: 16px; text-align: center; color: #fff;">Overzicht van de Hosting &amp; Conversie combinaties</h3>
        <div style="overflow-x: auto;">
          <table style="width: 100%; border-collapse: collapse; font-size: 0.92rem; text-align: left;">
            <thead>
              <tr style="border-bottom: 1px solid var(--border-gold); color: var(--gold);">
                <th style="padding: 10px 12px;">Gekozen combinatie</th>
                <th style="padding: 10px 12px;">Tarief</th>
                <th style="padding: 10px 12px; text-align: right;">Facturatie</th>
              </tr>
            </thead>
            <tbody>
              <tr style="border-bottom: 1px solid rgba(255,255,255,0.06);">
                <td style="padding: 12px;">Alleen Basis Hosting &amp; Domein</td>
                <td style="padding: 12px; font-weight: 600; color: #fff;">€ 12,40 / mnd</td>
                <td style="padding: 12px; text-align: right; color: var(--muted);">Jaarlijks gefactureerd</td>
              </tr>
              <tr style="border-bottom: 1px solid rgba(255,255,255,0.06);">
                <td style="padding: 12px;">Alleen Zorgeloos Bewaakt (incl. 24/7 Watchdog &amp; support)</td>
                <td style="padding: 12px; font-weight: 600; color: #fff;">€ 16,25 / mnd</td>
                <td style="padding: 12px; text-align: right; color: var(--muted);">Jaarlijks gefactureerd</td>
              </tr>
              <tr style="border-bottom: 1px solid rgba(255,255,255,0.06);">
                <td style="padding: 12px;">Basis Hosting + Conversie &amp; Interactie Suite</td>
                <td style="padding: 12px; font-weight: 600; color: #fff;">€ 22,35 / mnd</td>
                <td style="padding: 12px; text-align: right; color: var(--muted);">Jaarlijks gefactureerd</td>
              </tr>
              <tr style="background: rgba(222, 193, 72, 0.08); font-weight: 700;">
                <td style="padding: 12px; color: var(--gold);">⭐ Zorgeloos Bewaakt + Conversie Suite (All-in Favoriet)</td>
                <td style="padding: 12px; color: var(--gold);">€ 26,20 / mnd</td>
                <td style="padding: 12px; text-align: right; color: var(--gold);">Jaarlijks gefactureerd</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

    </div>
  </section>

  <!-- ============ 3. SEO & Vindbaarheid Onderhoud ============ -->
  <section class="section" id="seo-prijzen">
    <div class="container">
      <div class="section-head reveal" style="margin-bottom: 48px;">
        <span class="kicker">Pijler 3 — SEO Onderhoud &amp; Frequenties (Excl. BTW)</span>
        <h2>Vindbaarheid <span class="gold">onderhoud &amp; groei</span></h2>
        <p class="lead">Laat uw zoekmachine- en AI-posities periodiek bijsturen en optimaliseren. Prijzen excl. btw, per maand met jaarlijkse facturatie en 2 maanden opzegtermijn.</p>
      </div>

      <div class="grid grid--3">
        {pricing.seo.map((item, index) => (
          <article class={`price-card reveal ${item.featured ? 'featured' : ''} ${index > 0 ? 'reveal-delay-' + index : ''}`}>
            {item.featured && (
              <span class="price-badge">Populaire keuze</span>
            )}
            <div class="price-name">{item.name}</div>
            <div class="price-for">{item.subtitle}</div>
            <div class="price-amount">
              <span class="currency">€</span>
              <span class="amount">{item.amount}</span>
              <span class="per">{item.unit} <br/><small style="font-size: 0.72rem; color: var(--muted);">(jaarlijks gefactureerd • excl. btw)</small></span>
            </div>
            <ul class="price-features">
              {item.features.map((feat) => (
                <li>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                  {feat}
                </li>
              ))}
            </ul>
            {item.roi && <p class="price-roi">{item.roi}</p>}
            <a href="#contact" class={`btn ${item.featured ? 'btn--gold' : 'btn--ghost'} btn--block`}>Kies frequentie</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ 4. Microsites & Uitbreidingen ============ -->
  <section class="section section--alt" id="uitbreidingen">
    <div class="container">
      <div class="section-head reveal">
        <span class="kicker">Pijler 4 — Uitbreidingen (Excl. BTW)</span>
        <h2>Microsites &amp; <span class="gold">content modules</span></h2>
        <p class="lead">Breid uw website uit met extra lokale stedenpagina's of professioneel geschreven artikelen.</p>
      </div>

      <div class="grid grid--3">
        {pricing.addons.map((item, index) => (
          <article class={`price-card reveal ${index > 0 ? 'reveal-delay-' + index : ''}`}>
            <div class="price-name">{item.name}</div>
            <div class="price-for">{item.subtitle}</div>
            <div class="price-amount">
              <span class="currency">€</span>
              <span class="amount">{item.amount}</span>
              <span class="per">{item.unit} <br/><small style="font-size: 0.72rem; color: var(--muted);">(excl. btw)</small></span>
            </div>
            <ul class="price-features">
              {item.features.map((feat) => (
                <li>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                  {feat}
                </li>
              ))}
            </ul>
            <a href="#contact" class="btn btn--ghost btn--block">Informatie aanvragen</a>
          </article>
        ))}
      </div>

      <!-- Transparante Voorwaarden Melding -->
      <div class="pricing-note reveal" style="margin-top: 48px; max-width: 900px; margin-left: auto; margin-right: auto; text-align: center;">
        <div>
          <strong>Transparante voorwaarden:</strong> Alle genoemde tarieven zijn <strong>exclusief 21% btw</strong>. Jaarlijkse hosting-, beheer- en onderhoudsdiensten worden vooraf per jaar gefactureerd en zijn flexibel opzegbaar met een <strong>opzegtermijn van 2 maanden</strong> voor de jaarlijkse verlengingsdatum.
        </div>
      </div>
    </div>
  </section>

  <!-- ============ FAQ Section ============ -->
  <FAQ title="Veelgestelde vragen over tarieven en werkwijze" />

  <!-- ============ Contact Section ============ -->
  <section class="section" id="contact">
    <div class="container" style="max-width: 760px;">
      <ContactForm />
    </div>
  </section>
</Layout>
