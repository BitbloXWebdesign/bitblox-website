---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm.astro';
import FAQ from '../components/FAQ.astro';
import { pricing } from '../data/pricing';
---

<Layout 
  title="Duidelijke tarieven & pakketten — Webdesign & Beheer | BitbloX Assen"
  description="Transparante tarieven voor webdesign (Starter €295, Compleet €495, Pro €850), zorgeloos beheer & hosting (€149 - €245/jr) en SEO-onderhoud bij BitbloX."
>
  <!-- ============ Page hero ============ -->
  <section class="page-hero">
    <div class="hero-grid-bg"></div>
    <div class="container page-hero-inner">
      <nav class="breadcrumb" aria-label="Kruimelpad"><a href="/">Home</a> <span>/</span> <span>Prijzen</span></nav>
      <span class="kicker">Transparante tarieven</span>
      <h1>Duidelijke prijzen, <span class="text-gradient">geen verrassingen</span></h1>
      <p class="lead">Van een converterende one-pager tot een complete website met meerdere stedenpagina's en actieve leadfuncties. Kies het pakket dat past bij uw doelen en budget.</p>
    </div>
  </section>

  <!-- ============ 1. Webdesign Realisatie (Eenmalige Bouw) ============ -->
  <section class="section--tight" id="webdesign-prijzen">
    <div class="container">
      <div class="section-head reveal" style="margin-bottom: 48px;">
        <span class="kicker">Pijler 1 — Eenmalige Realisatie</span>
        <h2>Website <span class="gold">ontwerp &amp; bouw</span></h2>
        <p class="lead">Eenmalige investering voor het professioneel ontwerpen, bouwen en inrichten van uw nieuwe website.</p>
      </div>

      <div class="grid grid--4">
        {pricing.webdesign.map((item, index) => (
          <article class={`price-card reveal ${item.featured ? 'featured' : ''} ${index > 0 ? 'reveal-delay-' + index : ''}`}>
            {item.featured && (
              <span class="price-badge">Meest gekozen</span>
            )}
            <div class="price-name">{item.name}</div>
            <div class="price-for">{item.subtitle}</div>
            <div class="price-amount">
              <span class="currency">€</span>
              <span class="amount">{item.amount}</span>
              <span class="per">{item.unit}</span>
            </div>
            <ul class="price-features">
              {item.features.map((feat) => (
                <li>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                  {feat}
                </li>
              ))}
            </ul>
            {item.roi && <p class="price-roi">{item.roi}</p>}
            <a href="#contact" class={`btn ${item.featured ? 'btn--gold' : 'btn--ghost'} btn--block`}>Offerte aanvragen</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ 2. Beheer & Zorgeloos Online (Jaarlijks) ============ -->
  <section class="section section--alt" id="beheer-prijzen">
    <div class="container">
      <div class="section-head reveal">
        <span class="kicker">Pijler 2 — Beheer &amp; Beveiliging</span>
        <h2>Zorgeloos online <span class="gold">beheerdiensten</span></h2>
        <p class="lead">Geen zorgen over trage servers, hacks of technische updates. Wij beheren uw platform proactief op de achtergrond.</p>
      </div>

      <div class="grid grid--2" style="max-width: 860px; margin: 0 auto;">
        {pricing.hosting.map((item, index) => (
          <article class={`price-card reveal ${item.featured ? 'featured' : ''} ${index > 0 ? 'reveal-delay-1' : ''}`}>
            {item.featured && (
              <span class="price-badge">Aanrader</span>
            )}
            <div class="price-name">{item.name}</div>
            <div class="price-for">{item.subtitle}</div>
            <div class="price-amount">
              <span class="currency">€</span>
              <span class="amount">{item.amount}</span>
              <span class="per">{item.unit}</span>
            </div>
            <ul class="price-features">
              {item.features.map((feat) => (
                <li>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                  {feat}
                </li>
              ))}
            </ul>
            {item.roi && <p class="price-roi">{item.roi}</p>}
            <a href="#contact" class={`btn ${item.featured ? 'btn--gold' : 'btn--ghost'} btn--block`}>Kies dit beheer</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ 3. SEO & Vindbaarheid Onderhoud ============ -->
  <section class="section" id="seo-prijzen">
    <div class="container">
      <div class="section-head reveal">
        <span class="kicker">Pijler 3 — Vindbaarheid &amp; AI-Groei</span>
        <h2>SEO &amp; AI-vindbaarheid <span class="gold">onderhoud</span></h2>
        <p class="lead">Flexibele onderhoudschecks om uw posities in Google en aanbevelingen door ChatGPT en AI-zoekmachines structureel te behouden.</p>
      </div>

      <div class="grid grid--3">
        {pricing.seo.map((item, index) => (
          <article class={`price-card reveal ${item.featured ? 'featured' : ''} ${index > 0 ? 'reveal-delay-' + index : ''}`}>
            {item.featured && (
              <span class="price-badge">Populaire keuze</span>
            )}
            <div class="price-name">{item.name}</div>
            <div class="price-for">{item.subtitle}</div>
            <div class="price-amount">
              <span class="currency">€</span>
              <span class="amount">{item.amount}</span>
              <span class="per">{item.unit}</span>
            </div>
            <ul class="price-features">
              {item.features.map((feat) => (
                <li>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                  {feat}
                </li>
              ))}
            </ul>
            {item.roi && <p class="price-roi">{item.roi}</p>}
            <a href="#contact" class={`btn ${item.featured ? 'btn--gold' : 'btn--ghost'} btn--block`}>Kies frequentie</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ 4. Uitbreidingen & Content (Microsites & Blog) ============ -->
  <section class="section section--alt" id="uitbreidingen">
    <div class="container">
      <div class="section-head reveal">
        <span class="kicker">Pijler 4 — Uitbreidingen</span>
        <h2>Microsites &amp; <span class="gold">content modules</span></h2>
        <p class="lead">Breid uw website uit met extra lokale stedenpagina's of professioneel geschreven artikelen.</p>
      </div>

      <div class="grid grid--3">
        {pricing.addons.map((item, index) => (
          <article class={`price-card reveal ${index > 0 ? 'reveal-delay-' + index : ''}`}>
            <div class="price-name">{item.name}</div>
            <div class="price-for">{item.subtitle}</div>
            <div class="price-amount">
              <span class="currency">€</span>
              <span class="amount">{item.amount}</span>
              <span class="per">{item.unit}</span>
            </div>
            <ul class="price-features">
              {item.features.map((feat) => (
                <li>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                  {feat}
                </li>
              ))}
            </ul>
            <a href="#contact" class="btn btn--ghost btn--block">Informatie aanvragen</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ FAQ Section ============ -->
  <FAQ title="Veelgestelde vragen over tarieven en werkwijze" />

  <!-- ============ Contact Section ============ -->
  <section class="section" id="contact">
    <div class="container" style="max-width: 760px;">
      <ContactForm />
    </div>
  </section>
</Layout>
