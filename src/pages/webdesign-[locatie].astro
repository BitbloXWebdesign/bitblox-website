---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm.astro';
import GoogleReviews from '../components/GoogleReviews.astro';
import locationsData from '../data/locations.json';
import { pricing } from '../data/pricing';

export async function getStaticPaths() {
  return Object.values(locationsData).map((locRaw: any) => {
    // Automatische slimme fallbacks (Optie 2)
    const plaats = locRaw.plaats;
    const slug = locRaw.slug || plaats.toLowerCase().replace(/[^a-z0-9]+/g, '-');
    const provincie = locRaw.provincie || "Drenthe";
    const afstand = locRaw.afstand || `Slechts korte reistijd vanaf onze vestiging in Assen`;
    const intro = locRaw.intro || `Zoekt u een professionele & betaalbare website laten maken in ${plaats}? BitbloX levert maatwerk webdesign, supersnelle hosting en lokale SEO voor ZZP & MKB in ${plaats}.`;
    const wijken = (locRaw.wijken && locRaw.wijken.length > 0) 
      ? locRaw.wijken 
      : [`${plaats}-Centrum`, `Bedrijventerrein ${plaats}`, "Omliggende dorpen"];
    const klanten = locRaw.klanten || [];

    const loc = { plaats, slug, provincie, afstand, intro, wijken, klanten };

    return {
      params: { locatie: slug },
      props: { loc },
    };
  });
}

const { loc } = Astro.props;

const pageTitle = `Website Laten Maken ${loc.plaats} | Betaalbaar Webdesign & Hosting ${loc.plaats}`;
const pageDesc = `Professionele website laten maken in ${loc.plaats}? BitbloX levert maatwerk webdesign (Starter €295, Compleet €495, Pro €850), zeer snelle hosting en lokale SEO voor ZZP & MKB in ${loc.plaats}.`;

// 1. Schema: LocalBusiness / Service per plaats
const locationSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": "Webdesign",
  "name": `Webdesign ${loc.plaats}`,
  "provider": {
    "@type": "LocalBusiness",
    "name": "BitbloX",
    "telephone": "+31630523907",
    "email": "info@bitblox.nl"
  },
  "areaServed": {
    "@type": "City",
    "name": loc.plaats,
    "containedInPlace": {
      "@type": "AdministrativeArea",
      "name": loc.provincie
    }
  }
};

// 2. Schema: Official Google & AI FAQPage
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": `Wat kost een website laten maken in ${loc.plaats}?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `Bij BitbloX begint een Starter website al vanaf €${pricing.webdesign[0].amount}. Een Compleet pakket met 5 pagina's en blogmodule kost €${pricing.webdesign[1].amount}, en Pro maatwerk vanaf €${pricing.webdesign[2].amount}.`
      }
    },
    {
      "@type": "Question",
      "name": `Hoe snel kan mijn nieuwe website in ${loc.plaats} live staan?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `Na het aanleveren van uw wensen en teksten staat de eerste opzet vaak al binnen 3 tot 5 werkdagen klaar in de testomgeving.`
      }
    },
    {
      "@type": "Question",
      "name": `Zorgt BitbloX ook dat mijn bedrijf gevonden wordt in ChatGPT en Google AI?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `Ja! Wij rusten alle websites uit met AI-vindbaarheid (GEO / Generative Engine Optimization) en structured data, zodat AI-zoekmachines uw bedrijf in ${loc.plaats} aanbevelen als antwoord.`
      }
    }
  ]
};

const combinedSchema = [locationSchema, faqSchema];
const allLocations = Object.values(locationsData).filter((l: any) => l.slug !== loc.slug);
---

<Layout title={pageTitle} description={pageDesc} schema={combinedSchema}>
  <!-- ============ Page Hero ============ -->
  <section class="page-hero">
    <div class="hero-grid-bg"></div>
    <div class="container page-hero-inner">
      <nav class="breadcrumb" aria-label="Kruimelpad">
        <a href="/">Home</a> <span>/</span>
        <span>Webdesign {loc.plaats}</span>
      </nav>
      <span class="kicker">Lokaal Webdesign {loc.plaats} &amp; {loc.provincie}</span>
      <h1>Professionele &amp; Betaalbare Website Laten Maken in <span class="text-gradient">{loc.plaats}</span></h1>
      <p class="lead">{loc.intro}</p>

      <!-- AI GEO Answer Capsule -->
      <div class="answer-capsule">
        <strong>Korte samenvatting:</strong> BitbloX bouwt razendsnelle, mobielvriendelijke en direct vindbare websites voor ZZP'ers en MKB-bedrijven in {loc.plaats} (vanaf €{pricing.webdesign[0].amount} eenmalig). Inclusief contactformulier, SSL, 100/100 Google prestaties en AI-vindbaarheid voor ChatGPT.
      </div>
    </div>
  </section>

  <!-- ============ Waarom BitbloX in regio ============ -->
  <section class="section">
    <div class="container">
      <div class="service-row">
        <div>
          <span class="service-tag">Lokale Focus &amp; Kwaliteit</span>
          <h2>Waarom kiezen ondernemers in <span class="gold">{loc.plaats}</span> voor BitbloX?</h2>
          <p class="lead">Geen trage templates of onoverzichtelijke facturen. Wij bouwen moderne websites met de allernieuwste techniek (Astro &amp; Cloudflare Pages).</p>
          <ul class="feature-list">
            <li>
              <span class="f-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
              </span>
              <div>
                <strong>Binnen 0.1 Seconde Geladen</strong>
                <span>Google en uw bezoekers in {loc.plaats} houden van snelheid. Onze sites scoren 100/100 in Google Lighthouse.</span>
              </div>
            </li>
            <li>
              <span class="f-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="m4.93 4.93 4.24 4.24M14.83 14.83l4.24 4.24M14.83 9.17l4.24-4.24M4.93 19.07l4.24-4.24"/></svg>
              </span>
              <div>
                <strong>Direct Vindbaar in Google &amp; AI (GEO)</strong>
                <span>Geoptimaliseerd voor zoekopdrachten zoals "vakman in {loc.plaats}" én aanbevelingen door ChatGPT en Perplexity.</span>
              </div>
            </li>
            <li>
              <span class="f-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
              </span>
              <div>
                <strong>Veilig, Betrouwbaar &amp; Zonder Omkijken</strong>
                <span>Inclusief gratis SSL-certificaat, veilige Cloudflare hosting en 24/7 storingsmonitoring.</span>
              </div>
            </li>
          </ul>
        </div>
        <div class="service-media reveal">
          <div class="big-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>
          </div>
          <div class="halo"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ Werkgebied / Wijken ============ -->
  <section class="section section--alt">
    <div class="container">
      <div class="section-head reveal">
        <span class="kicker">Actief in heel {loc.plaats}</span>
        <h2>Onze webdesign &amp; SEO diensten in <span class="gold">{loc.plaats} en omstreken</span></h2>
        <p class="lead">{loc.afstand}. We bouwen websites voor bedrijven in onder andere:</p>
      </div>

      <div class="grid grid--3" style="max-width: 860px; margin: 0 auto 40px;">
        {loc.wijken.map((wijk: string) => (
          <div class="card reveal" style="padding: 24px; text-align: center; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-sm);">
            <span style="font-size: 1.5rem; display: block; margin-bottom: 8px;">📍</span>
            <strong style="color: var(--text); font-size: 1.05rem;">{wijk}</strong>
            <p style="font-size: 0.85rem; color: var(--muted); margin-top: 4px;">Webdesign, Hosting &amp; Lokale SEO</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ Portfolio in de buurt ============ -->
  {loc.klanten.length > 0 && (
    <section class="section section--tight">
      <div class="container">
        <div class="section-head reveal">
          <span class="kicker">Lokale Referenties</span>
          <h2>Ondernemers in <span class="gold">regio {loc.plaats}</span> die u voor gingen</h2>
          <p class="lead">Trots op onze klanten in {loc.plaats} en omstreken:</p>
        </div>
        <div class="portfolio-grid reveal" style="max-width: 820px; margin: 0 auto; display: flex; flex-wrap: wrap; gap: 16px; justify-content: center;">
          {loc.klanten.map((domein: string) => (
            <a class="portfolio-item" href={`https://${domein}`} target="_blank" rel="noopener" style="padding: 14px 24px; background: var(--surface); border: 1px solid var(--border-gold); border-radius: var(--radius-sm); color: var(--gold); font-weight: 600; text-decoration: none; display: inline-flex; align-items: center; gap: 8px;">
              {domein}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16"><path d="M7 17 17 7M7 7h10v10"/></svg>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ============ Prijzen overzicht ============ -->
  <section class="section" id="prijzen">
    <div class="container">
      <div class="section-head reveal">
        <span class="kicker">Transparante Tarieven</span>
        <h2>Webdesign pakketten voor <span class="gold">ZZP &amp; MKB</span> in {loc.plaats}</h2>
        <p class="lead">Kies het pakket dat past bij uw wensen in {loc.plaats}. Eerlijke prijzen zonder verborgen kosten.</p>
      </div>

      <div class="grid grid--3">
        {pricing.webdesign.map((item, index) => (
          <article class={`price-card reveal ${item.featured ? 'featured' : ''} ${index > 0 ? 'reveal-delay-' + index : ''}`}>
            {item.featured && (
              <span class="price-badge">Meest gekozen</span>
            )}
            <div class="price-name">{item.name}</div>
            <div class="price-for">{item.subtitle}</div>
            <div class="price-amount">
              <span class="currency">€</span>
              <span class="amount">{item.amount}</span>
            </div>
            <ul class="price-features">
              {item.features.slice(0, 4).map((feat) => (
                <li>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                  {feat}
                </li>
              ))}
            </ul>
            <a href="#contact" class={`btn ${item.featured ? 'btn--gold' : 'btn--ghost'} btn--block`}>Contact</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ Werkwijze ============ -->
  <section class="section section--alt" id="werkwijze">
    <div class="container">
      <div class="section-head reveal">
        <span class="kicker">Onze werkwijze</span>
        <h2>In 4 stappen naar een website <span class="gold">die werkt in {loc.plaats}</span></h2>
        <p class="lead">Een helder en efficiënt proces — van eerste analyse tot doorlopende groei.</p>
      </div>
      <div class="steps">
        <div class="step reveal">
          <div class="step-num">1</div>
          <h3>Strategie &amp; Ontwerp</h3>
          <p>We analyseren uw doelen, doelgroep in {loc.plaats} en concurrentie. Vervolgens maken we een wireframe en visueel ontwerp dat past bij uw merk.</p>
        </div>
        <div class="step reveal reveal-delay-1">
          <div class="step-num">2</div>
          <h3>Ontwikkeling &amp; SEO</h3>
          <p>We bouwen de website met moderne technologieën op Cloudflare Pages, en optimaliseren voor snelheid en lokale zoekresultaten in {loc.plaats}.</p>
        </div>
        <div class="step reveal reveal-delay-2">
          <div class="step-num">3</div>
          <h3>Testen &amp; Lancering</h3>
          <p>U krijgt een testomgeving om feedback te geven. Na goedkeuring lanceren we de website op onze beveiligde hosting.</p>
        </div>
        <div class="step reveal reveal-delay-3">
          <div class="step-num">4</div>
          <h3>Groei &amp; Onderhoud</h3>
          <p>Na lancering monitoren we de prestaties, voeren we updates uit en bieden we doorlopend beheer. Uw website blijft veilig en snel.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ Google Reviews ============ -->
  <GoogleReviews />

  <!-- ============ FAQ met HTML Microdata & GEO AI Structuur ============ -->
  <section class="section section--alt" itemscope itemtype="https://schema.org/FAQPage">
    <div class="container">
      <div class="section-head reveal">
        <span class="kicker">Veelgestelde Vragen</span>
        <h2>Vragen over webdesign in <span class="gold">{loc.plaats}</span></h2>
      </div>

      <div style="max-width: 760px; margin: 0 auto; display: flex; flex-direction: column; gap: 16px;">
        <div class="card reveal" style="padding: 24px;" itemscope itemprop="mainEntity" itemtype="https://schema.org/Question">
          <h3 style="font-size: 1.1rem; margin-bottom: 8px;" itemprop="name">Wat kost een website laten maken in {loc.plaats}?</h3>
          <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
            <p style="font-size: 0.95rem; color: var(--muted);" itemprop="text">
              Bij BitbloX begint een Starter website al vanaf €{pricing.webdesign[0].amount}. Een Compleet pakket met 5 pagina's en blogmodule kost €{pricing.webdesign[1].amount}, en Pro maatwerk vanaf €{pricing.webdesign[2].amount}.
            </p>
          </div>
        </div>

        <div class="card reveal" style="padding: 24px;" itemscope itemprop="mainEntity" itemtype="https://schema.org/Question">
          <h3 style="font-size: 1.1rem; margin-bottom: 8px;" itemprop="name">Hoe snel kan mijn nieuwe website in {loc.plaats} live staan?</h3>
          <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
            <p style="font-size: 0.95rem; color: var(--muted);" itemprop="text">
              Na het aanleveren van uw wensen en teksten staat de eerste opzet vaak al binnen 3 tot 5 werkdagen klaar in de testomgeving.
            </p>
          </div>
        </div>

        <div class="card reveal" style="padding: 24px;" itemscope itemprop="mainEntity" itemtype="https://schema.org/Question">
          <h3 style="font-size: 1.1rem; margin-bottom: 8px;" itemprop="name">Zorgt BitbloX ook dat mijn bedrijf gevonden wordt in ChatGPT en Google AI?</h3>
          <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
            <p style="font-size: 0.95rem; color: var(--muted);" itemprop="text">
              Ja! Wij rusten alle websites uit met AI-vindbaarheid (GEO / Generative Engine Optimization) en structured data, zodat AI-zoekmachines uw bedrijf in {loc.plaats} aanbevelen als antwoord.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ Interne Omliggende Plaatsen Links ============ -->
  <section class="section">
    <div class="container">
      <div class="section-head reveal" style="margin-bottom: 32px;">
        <span class="kicker">Omliggende Regio's</span>
        <h2>Webdesign in de buurt van <span class="gold">{loc.plaats}</span></h2>
      </div>
      <div style="display: flex; flex-wrap: wrap; gap: 12px; justify-content: center;">
        {allLocations.map((otherLoc: any) => (
          <a href={`/webdesign-${otherLoc.slug || otherLoc.plaats.toLowerCase()}/`} style="padding: 8px 16px; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-sm); font-size: 0.88rem; color: var(--text); transition: border-color var(--transition);" class="hover-gold">
            Webdesign {otherLoc.plaats} →
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ Contact Section ============ -->
  <section class="section section--alt" id="contact">
    <div class="container" style="max-width: 760px;">
      <ContactForm 
        title={`Vraag een scherpe offerte aan voor ${loc.plaats}`} 
        subtitle={`Wilt u een betaalbare en professionele website laten maken in ${loc.plaats}? Vul het formulier in voor vrijblijvend advies binnen 24 uur.`} 
      />
    </div>
  </section>
</Layout>
