          micrositeListDisplay.innerHTML = conf.microsites.map((m, idx) => `
            <div style="display: flex; justify-content: space-between; align-items: center; padding: 8px 12px; background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.05); border-radius: 10px;">
              <span style="color: #fff; font-size: 0.9rem; font-weight: 500;">${m.name}</span>
              <div style="display: flex; gap: 8px; align-items: center;">
                <a href="${m.url}" target="_blank" style="color: #dec148; font-size: 0.8rem; text-decoration: none; padding: 2px 8px; background: rgba(222,193,72,0.1); border-radius: 6px;">Bekijk ↗</a>
