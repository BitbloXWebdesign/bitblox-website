---
import Layout from '../layouts/Layout.astro';
import locationsData from '../data/locations.json';
import reviewsData from '../data/reviews.json';
import { getCollection } from 'astro:content';

const currentLocations = Object.values(locationsData);
const blogPosts = await getCollection('blog');
const defaultDeepSeekKey = import.meta.env.DEEPSEEK_API_KEY || '';
---

<Layout title="BitbloX Enterprise — Command Center & Analytics" description="Enterprise Dark Dashboard voor het beheren van klantsites, snelheidsmetingen, bezoekersstatistieken en AI modules." hideHeaderFooter={true}>
  
  <!-- Login Gate Modal -->
  <div id="loginGate" style="position: fixed; inset: 0; z-index: 999999; background: radial-gradient(circle at 50% 35%, #161a29 0%, #06070a 100%); backdrop-filter: blur(30px); display: flex; align-items: center; justify-content: center; padding: 20px;">
    <div style="max-width: 440px; width: 100%; padding: 48px 36px; background: rgba(14, 17, 27, 0.95); border: 1px solid rgba(222, 193, 72, 0.35); border-radius: 20px; text-align: center; box-shadow: 0 30px 80px rgba(0,0,0,0.9), 0 0 50px rgba(222, 193, 72, 0.12);">
      <img src="/assets/img/logo-light.png" alt="BitbloX" style="height: 40px; margin: 0 auto 24px; display: block; filter: drop-shadow(0 4px 14px rgba(222, 193, 72, 0.4));" />
      <div style="display: inline-flex; align-items: center; gap: 6px; padding: 4px 12px; background: rgba(56, 189, 248, 0.1); border: 1px solid rgba(56, 189, 248, 0.3); border-radius: 999px; margin-bottom: 16px;">
        <span style="width: 6px; height: 6px; border-radius: 50%; background: #38bdf8; box-shadow: 0 0 8px #38bdf8;"></span>
        <span style="font-size: 0.75rem; font-weight: 700; color: #38bdf8; letter-spacing: 0.08em; text-transform: uppercase;">Enterprise Command Center</span>
      </div>
      <h2 style="font-size: 1.5rem; color: #ffffff; margin-bottom: 8px; font-weight: 700;">Beveiligde Toegang</h2>
      <p style="font-size: 0.88rem; color: #94a3b8; margin-bottom: 28px; line-height: 1.5;">Voer het beheerderswachtwoord in om het centrale BitbloX Analytics &amp; Beheerdashboard te openen.</p>
      
      <div style="display: flex; flex-direction: column; gap: 16px;">
        <input 
          type="password" 
          id="adminPassInput" 
          placeholder="••••••••••••" 
          style="width: 100%; padding: 15px 20px; background: #08090e; border: 1px solid rgba(255,255,255,0.12); border-radius: 12px; color: #fff; font-size: 1.1rem; text-align: center; letter-spacing: 3px;"
        />
        <button id="adminLoginBtn" class="btn btn--gold" style="width: 100%; justify-content: center; padding: 14px; font-size: 1rem; border-radius: 12px; box-shadow: 0 10px 25px rgba(222, 193, 72, 0.35);">
          Dashboard Ontgrendelen 🔑
        </button>
        <p id="loginErrorMsg" style="color: #f87171; font-size: 0.85rem; margin: 0; display: none;">⚠️ Onjuist wachtwoord. Probeer het opnieuw.</p>
      </div>
    </div>
  </div>

  <!-- Protected Admin Dashboard Content (SquaredUp / Enterprise Style) -->
  <div id="adminContent" style="display: none; min-height: 100vh; background: #06070b; color: #e2e8f0;">
    
    <!-- TOP ENTERPRISE NAVBAR -->
    <header style="background: #0d0f17; border-bottom: 1px solid rgba(255,255,255,0.08); position: sticky; top: 0; z-index: 999; padding: 12px 24px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px;">
      
      <!-- Brand & Client Indicator -->
      <div style="display: flex; align-items: center; gap: 20px;">
        <a href="/" style="display: flex; align-items: center;">
          <img src="/assets/img/logo-light.png" alt="BitbloX" style="height: 28px;" />
        </a>
        <span style="color: rgba(255,255,255,0.15); font-size: 1.4rem;">|</span>
        <div style="display: flex; align-items: center; gap: 10px;">
          <span style="font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.08em; color: #94a3b8; font-weight: 700;">Client:</span>
          <div style="position: relative;">
            <select id="clientSelectDropdown" style="background: #151824; border: 1px solid rgba(56, 189, 248, 0.4); border-radius: 8px; color: #fff; padding: 7px 32px 7px 14px; font-size: 0.92rem; font-weight: 700; cursor: pointer; appearance: none; -webkit-appearance: none;">
              <option value="bitblox" selected>🌐 BitbloX Webdesign (bitblox.nl)</option>
              <option value="autokampeerder">🚐 De Autokampeerder (deautokampeerder.nl)</option>
              <option value="voetreflextherapeut">🌿 Voetreflextherapeut Groningen (voetreflextherapeutgroningen.nl)</option>
            </select>
            <span style="position: absolute; right: 12px; top: 50%; transform: translateY(-50%); pointer-events: none; color: #38bdf8; font-size: 0.75rem;">▼</span>
          </div>
          <span id="activeClientBadge" style="display: inline-flex; align-items: center; gap: 5px; font-size: 0.72rem; background: rgba(34, 197, 94, 0.12); color: #4ade80; border: 1px solid rgba(34, 197, 94, 0.3); padding: 3px 10px; border-radius: 999px; font-weight: 700;">
            <span style="width: 6px; height: 6px; border-radius: 50%; background: #4ade80; box-shadow: 0 0 6px #4ade80;"></span> 100% Live (Cloudflare)
          </span>
        </div>
      </div>

      <!-- Right Header Actions -->
      <div style="display: flex; align-items: center; gap: 14px;">
        <div style="display: flex; align-items: center; gap: 6px; font-size: 0.8rem; color: #94a3b8; background: #151824; padding: 6px 12px; border-radius: 8px; border: 1px solid rgba(255,255,255,0.06);">
          <span style="width: 7px; height: 7px; border-radius: 50%; background: #22c55e;"></span>
          Edge Cache: <strong id="edgeCacheDisplay" style="color: #fff;">98.4%</strong>
        </div>
        <a id="clientLiveLink" href="https://bitblox.nl" target="_blank" rel="noopener" class="btn btn--gold btn--sm" style="padding: 7px 16px; font-size: 0.84rem; border-radius: 8px; display: inline-flex; align-items: center; gap: 6px;">
          <span>🌐 Live Site</span> <span id="clientLiveDomainText" style="opacity: 0.85;">(bitblox.nl)</span> ↗
        </a>
        <button id="logoutBtn" class="btn btn--ghost btn--sm" style="padding: 7px 14px; font-size: 0.84rem; border-radius: 8px; color: #94a3b8; border-color: rgba(255,255,255,0.1);">
          Uitloggen
        </button>
      </div>

    </header>

    <!-- DASHBOARD WORKSPACE BODY -->
    <div style="padding: 24px;">
      <div style="max-width: 1560px; margin: 0 auto;">
        
        <!-- ================= TOP METRICS ROW: 4 SQUAREDUP CIRCULAR GAUGES ================= -->
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 16px; margin-bottom: 24px;">
          
          <!-- Gauge 1: Mobile Speed Score -->
          <div class="dash-card">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
              <span style="font-size: 0.78rem; font-weight: 700; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.05em;">Mobiele Snelheid (Lighthouse)</span>
              <span style="font-size: 0.7rem; background: rgba(34,197,94,0.15); color: #4ade80; padding: 2px 6px; border-radius: 4px; font-weight: 700;">Google 100%</span>
            </div>
            <div style="display: flex; align-items: center; justify-content: center; gap: 20px; padding: 8px 0;">
              <div class="circle-gauge">
                <svg viewBox="0 0 36 36" class="circular-chart green">
                  <path class="circle-bg" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"/>
                  <path class="circle" stroke-dasharray="99, 100" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"/>
                  <text x="18" y="20.35" class="percentage" id="metricMobileScore">99</text>
                </svg>
              </div>
              <div>
                <div style="font-size: 1.25rem; font-weight: 800; color: #fff;" id="metricMobileTime">0.23s</div>
                <div style="font-size: 0.75rem; color: #94a3b8;">Laadtijd op 4G/5G</div>
                <div style="font-size: 0.72rem; color: #4ade80; font-weight: 600; margin-top: 4px;">⚡ 4x Sneller dan WP</div>
              </div>
            </div>
          </div>

          <!-- Gauge 2: Desktop Speed Score -->
          <div class="dash-card">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
              <span style="font-size: 0.78rem; font-weight: 700; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.05em;">Desktop Performance</span>
              <span style="font-size: 0.7rem; background: rgba(56,189,248,0.15); color: #38bdf8; padding: 2px 6px; border-radius: 4px; font-weight: 700;">Optimaal</span>
            </div>
            <div style="display: flex; align-items: center; justify-content: center; gap: 20px; padding: 8px 0;">
              <div class="circle-gauge">
                <svg viewBox="0 0 36 36" class="circular-chart blue">
                  <path class="circle-bg" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"/>
                  <path class="circle" stroke-dasharray="100, 100" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"/>
                  <text x="18" y="20.35" class="percentage" id="metricDesktopScore">100</text>
                </svg>
              </div>
              <div>
                <div style="font-size: 1.25rem; font-weight: 800; color: #fff;" id="metricDesktopTime">0.11s</div>
                <div style="font-size: 0.75rem; color: #94a3b8;">TTFB Server Response</div>
                <div style="font-size: 0.72rem; color: #38bdf8; font-weight: 600; margin-top: 4px;">🚀 100/100 Core Web Vitals</div>
              </div>
            </div>
          </div>

          <!-- Gauge 3: GEO AI Readiness (ChatGPT / Perplexity Index) -->
          <div class="dash-card">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
              <span style="font-size: 0.78rem; font-weight: 700; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.05em;">AI-Vindbaarheid (GEO Index)</span>
              <span style="font-size: 0.7rem; background: rgba(222,193,72,0.15); color: #dec148; padding: 2px 6px; border-radius: 4px; font-weight: 700;">Top Positie</span>
            </div>
            <div style="display: flex; align-items: center; justify-content: center; gap: 20px; padding: 8px 0;">
              <div class="circle-gauge">
                <svg viewBox="0 0 36 36" class="circular-chart gold">
                  <path class="circle-bg" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"/>
                  <path class="circle" stroke-dasharray="98, 100" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"/>
                  <text x="18" y="20.35" class="percentage" id="metricGeoScore">98</text>
                </svg>
              </div>
              <div>
                <div style="font-size: 1.25rem; font-weight: 800; color: #fff;" id="metricGeoLabel">Actief</div>
                <div style="font-size: 0.75rem; color: #94a3b8;">llms.txt + Capsules</div>
                <div style="font-size: 0.72rem; color: #dec148; font-weight: 600; margin-top: 4px;">🤖 Aanbevolen in ChatGPT</div>
              </div>
            </div>
          </div>

          <!-- Gauge 4: Uptime & Cloud Network -->
          <div class="dash-card">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
              <span style="font-size: 0.78rem; font-weight: 700; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.05em;">Global Edge &amp; Uptime</span>
              <span style="font-size: 0.7rem; background: rgba(168,85,247,0.15); color: #c084fc; padding: 2px 6px; border-radius: 4px; font-weight: 700;">Cloudflare CDN</span>
            </div>
            <div style="display: flex; align-items: center; justify-content: center; gap: 20px; padding: 8px 0;">
              <div class="circle-gauge">
                <svg viewBox="0 0 36 36" class="circular-chart purple">
                  <path class="circle-bg" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"/>
                  <path class="circle" stroke-dasharray="100, 100" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"/>
                  <text x="18" y="20.35" class="percentage">100</text>
                </svg>
              </div>
              <div>
                <div style="font-size: 1.25rem; font-weight: 800; color: #fff;">99.99%</div>
                <div style="font-size: 0.75rem; color: #94a3b8;">Uptime SLA 2026</div>
                <div style="font-size: 0.72rem; color: #c084fc; font-weight: 600; margin-top: 4px;">🛡️ SSL + DDoS Protectie</div>
              </div>
            </div>
          </div>

        </div>

        <!-- ================= ANALYTICS WAVE CHARTS ROW (SQUAREDUP STYLE) ================= -->
        <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 16px; margin-bottom: 24px;">
          
          <!-- Wave Graph 1: Bezoekers & AI Referrals (Laatste 14 Dagen) -->
          <div class="dash-card">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
              <div>
                <h4 style="font-size: 0.95rem; color: #fff; margin: 0; font-weight: 700;">📈 Live Bezoekers &amp; Zoekverkeer (Laatste 14 Dagen)</h4>
                <span style="font-size: 0.75rem; color: #94a3b8;">Reële data afkomstig van Cloudflare Web Analytics (GDPR Compliant)</span>
              </div>
              <div style="display: flex; gap: 12px; font-size: 0.75rem;">
                <span style="display: flex; align-items: center; gap: 5px; color: #38bdf8;"><span style="width: 8px; height: 8px; border-radius: 2px; background: #38bdf8;"></span> Google Zoekers</span>
                <span style="display: flex; align-items: center; gap: 5px; color: #dec148;"><span style="width: 8px; height: 8px; border-radius: 2px; background: #dec148;"></span> AI (ChatGPT/Perplexity)</span>
              </div>
            </div>

            <!-- SVG Wave Graph Line Chart -->
            <div style="position: relative; width: 100%; height: 160px; background: rgba(0,0,0,0.25); border-radius: 8px; padding: 10px; border: 1px solid rgba(255,255,255,0.04);">
              <svg viewBox="0 0 500 120" style="width: 100%; height: 100%; overflow: visible;" preserveAspectRatio="none">
                <defs>
                  <linearGradient id="gradBlue" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="#38bdf8" stop-opacity="0.4"/>
                    <stop offset="100%" stop-color="#38bdf8" stop-opacity="0.0"/>
                  </linearGradient>
                  <linearGradient id="gradGold" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="#dec148" stop-opacity="0.3"/>
                    <stop offset="100%" stop-color="#dec148" stop-opacity="0.0"/>
                  </linearGradient>
                </defs>
                <!-- Grid Lines -->
                <line x1="0" y1="30" x2="500" y2="30" stroke="rgba(255,255,255,0.05)" stroke-dasharray="4"/>
                <line x1="0" y1="60" x2="500" y2="60" stroke="rgba(255,255,255,0.05)" stroke-dasharray="4"/>
                <line x1="0" y1="90" x2="500" y2="90" stroke="rgba(255,255,255,0.05)" stroke-dasharray="4"/>
                
                <!-- Blue Wave (Google Search) -->
                <path id="trafficWaveBlue" d="M 0,90 Q 50,40 100,60 T 200,30 T 300,50 T 400,20 T 500,45 L 500,120 L 0,120 Z" fill="url(#gradBlue)" />
                <path id="trafficLineBlue" d="M 0,90 Q 50,40 100,60 T 200,30 T 300,50 T 400,20 T 500,45" fill="none" stroke="#38bdf8" stroke-width="2.5" />

                <!-- Gold Wave (AI ChatGPT Referrals) -->
                <path id="trafficWaveGold" d="M 0,105 Q 60,85 120,95 T 220,70 T 320,65 T 420,40 T 500,35 L 500,120 L 0,120 Z" fill="url(#gradGold)" />
                <path id="trafficLineGold" d="M 0,105 Q 60,85 120,95 T 220,70 T 320,65 T 420,40 T 500,35" fill="none" stroke="#dec148" stroke-width="2" />
              </svg>
            </div>
            <div style="display: flex; justify-content: space-between; font-size: 0.72rem; color: #64748b; margin-top: 8px;">
              <span>1 Aug</span><span>4 Aug</span><span>7 Aug</span><span>10 Aug</span><span>12 Aug</span><span>Vandaag (Live)</span>
            </div>
          </div>

          <!-- Bar Chart 2: Top Bronnen & Regio -->
          <div class="dash-card">
            <div style="margin-bottom: 16px;">
              <h4 style="font-size: 0.95rem; color: #fff; margin: 0; font-weight: 700;">🌍 Top Verkeersbronnen</h4>
              <span style="font-size: 0.75rem; color: #94a3b8;">Herkomst van leads &amp; telefoontjes</span>
            </div>
            
            <div style="display: flex; flex-direction: column; gap: 12px;" id="trafficSourcesList">
              <div>
                <div style="display: flex; justify-content: space-between; font-size: 0.8rem; margin-bottom: 4px;">
                  <span style="color: #fff;">Google Organisch Zoeken</span>
                  <strong style="color: #38bdf8;">68%</strong>
                </div>
                <div style="height: 6px; background: rgba(255,255,255,0.06); border-radius: 4px; overflow: hidden;">
                  <div style="width: 68%; height: 100%; background: #38bdf8; border-radius: 4px;"></div>
                </div>
              </div>

              <div>
                <div style="display: flex; justify-content: space-between; font-size: 0.8rem; margin-bottom: 4px;">
                  <span style="color: #fff;">ChatGPT / AI Search</span>
                  <strong style="color: #dec148;">19%</strong>
                </div>
                <div style="height: 6px; background: rgba(255,255,255,0.06); border-radius: 4px; overflow: hidden;">
                  <div style="width: 19%; height: 100%; background: #dec148; border-radius: 4px;"></div>
                </div>
              </div>

              <div>
                <div style="display: flex; justify-content: space-between; font-size: 0.8rem; margin-bottom: 4px;">
                  <span style="color: #fff;">Direct / WhatsApp / Mond-tot-mond</span>
                  <strong style="color: #4ade80;">13%</strong>
                </div>
                <div style="height: 6px; background: rgba(255,255,255,0.06); border-radius: 4px; overflow: hidden;">
                  <div style="width: 13%; height: 100%; background: #4ade80; border-radius: 4px;"></div>
                </div>
              </div>
            </div>
          </div>

        </div>

        <!-- ================= CONTROLS & MANAGEMENT SECTION (NAV TABS) ================= -->
        <div style="background: #0d0f17; border: 1px solid rgba(255,255,255,0.08); border-radius: 16px; padding: 24px; box-shadow: 0 15px 40px rgba(0,0,0,0.5);">
          
          <!-- Segmented Tab Navigation -->
          <div style="display: flex; gap: 8px; margin-bottom: 24px; background: #151824; padding: 6px; border-radius: 10px; border: 1px solid rgba(255,255,255,0.06); overflow-x: auto;">
            <button class="nav-tab active" data-tab="tab-switches">
              🎛️ 1. Modules &amp; Schuifjes
            </button>
            <button class="nav-tab" data-tab="tab-microsites" id="tabBtnMicrosites">
              📍 2. Regio Microsites
            </button>
            <button class="nav-tab" data-tab="tab-blog" id="tabBtnBlog">
              📝 3. AI Blog Studio
            </button>
            <button class="nav-tab" data-tab="tab-reviews" id="tabBtnReviews">
              ⭐ 4. Google Reviews
            </button>
            <button class="nav-tab" data-tab="tab-overview">
              📊 5. Content Overzicht &amp; Prullenbak
            </button>
          </div>

          <!-- TAB 1: SCHUIFJES -->
          <div id="tab-switches" class="tab-pane active">
            <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px; margin-bottom: 20px; border-bottom: 1px solid rgba(255,255,255,0.08); padding-bottom: 16px;">
              <div>
                <h3 style="font-size: 1.15rem; color: #fff; margin: 0 0 4px 0; font-weight: 700;">
                  Module Instellingen voor <span id="switchesClientName" style="color: #dec148;">BitbloX Webdesign</span>
                </h3>
                <p style="font-size: 0.82rem; color: #94a3b8; margin: 0;">Schakel modules aan of uit. Uitgeschakelde onderdelen verdwijnen direct van de site!</p>
              </div>
              <button id="saveSwitchesBtn" class="btn btn--gold" style="padding: 10px 20px; border-radius: 8px; font-weight: 700;">
                💾 Opslaan &amp; Synchroniseren
              </button>
            </div>

            <!-- 2-Column Grid 8 Switches -->
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 12px; margin-bottom: 16px;">
              
              <div class="module-card">
                <div style="flex: 1;">
                  <strong style="display: block; color: #fff; font-size: 0.9rem; margin-bottom: 2px;">📝 Blog / Kennisbank</strong>
                  <span style="font-size: 0.78rem; color: #94a3b8;">Kennisbank artikelen &amp; Blog Studio.</span>
                </div>
                <label class="switch"><input type="checkbox" id="toggleBlog" checked><span class="slider"></span></label>
              </div>

              <div class="module-card">
                <div style="flex: 1;">
                  <strong style="display: block; color: #fff; font-size: 0.9rem; margin-bottom: 2px;">🔍 SEO (Google Zoekmachine)</strong>
                  <span style="font-size: 0.78rem; color: #94a3b8;">Google sitemaps, meta-tags &amp; Schema.</span>
                </div>
                <label class="switch"><input type="checkbox" id="toggleSeo" checked><span class="slider"></span></label>
              </div>

              <div class="module-card">
                <div style="flex: 1;">
                  <strong style="display: block; color: #fff; font-size: 0.9rem; margin-bottom: 2px;">🤖 AI-Vindbaarheid (GEO)</strong>
                  <span style="font-size: 0.78rem; color: #94a3b8;">ChatGPT, Gemini &amp; llms.txt capsules.</span>
                </div>
                <label class="switch"><input type="checkbox" id="toggleGeo" checked><span class="slider"></span></label>
              </div>

              <div class="module-card">
                <div style="flex: 1;">
                  <strong style="display: block; color: #fff; font-size: 0.9rem; margin-bottom: 2px;">💬 WhatsApp Floating Widget</strong>
                  <span style="font-size: 0.78rem; color: #94a3b8;">Zwevende chat-knop rechtsonder.</span>
                </div>
                <label class="switch"><input type="checkbox" id="toggleWhatsapp" checked><span class="slider"></span></label>
              </div>

              <div class="module-card">
                <div style="flex: 1;">
                  <strong style="display: block; color: #fff; font-size: 0.9rem; margin-bottom: 2px;">📍 Steden-Microsites</strong>
                  <span style="font-size: 0.78rem; color: #94a3b8;">Regio-landingspagina's voor dorpen.</span>
                </div>
                <label class="switch"><input type="checkbox" id="toggleMicrosites" checked><span class="slider"></span></label>
              </div>

              <div class="module-card">
                <div style="flex: 1;">
                  <strong style="display: block; color: #fff; font-size: 0.9rem; margin-bottom: 2px;">⭐ Google Reviews Carrousel</strong>
                  <span style="font-size: 0.78rem; color: #94a3b8;">Swipebare reviews op de site.</span>
                </div>
