              if (reviewCompany) reviewCompany.value = '';
              if (reviewCity) reviewCity.value = '';

              if (saveReviewStatus) saveReviewStatus.textContent = `✅ Review van ${nameVal} direct opgeslagen & gepubliceerd! (Cloudflare bouwt nu)`;
              saveReviewBtn.textContent = '✅ Review Live Gepubliceerd!';
              setTimeout(() => {
                saveReviewBtn.textContent = '⭐ Review Direct Opslaan & Publiceren';
              }, 4000);
            }
          } catch (err) {
            console.warn('Review save error:', err);
          }
        }

        if (!ghPushed) {
          // Local fallback
          try {
            const res = await fetch('/api/save-review', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                name: nameVal,
                company: compVal,
                city: cityVal,
                rating: ratingVal,
                text: textVal,
                date: 'Google Beoordeling',
                client: currentSelectedClient
              })
            });
            const resData = await res.json();
            if (resData.success) {
              if (saveReviewStatus) saveReviewStatus.textContent = `✅ Review toegevoegd!`;
              saveReviewBtn.textContent = '✅ Gepubliceerd!';
            } else {
              throw new Error();
            }
          } catch (e) {
            navigator.clipboard.writeText(reviewJsonString);
            if (saveReviewStatus) saveReviewStatus.textContent = `📋 Review JSON gekopieerd naar klembord!`;
            saveReviewBtn.textContent = '📋 Review Gekopieerd!';
          }
        }

        saveReviewBtn.disabled = false;
      });
    }

    // Run auth check and UI synchronization after full setup
    checkAuth();
  });
</script>
