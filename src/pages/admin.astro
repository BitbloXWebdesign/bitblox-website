<style>
  /* Navigation Tabs */
  .nav-tab {
    background: transparent;
    border: none;
    color: #94a3b8;
    padding: 10px 18px;
    font-size: 0.88rem;
    font-weight: 600;
    border-radius: 10px;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.2s ease;
  }
  .nav-tab:hover {
    color: #fff;
    background: rgba(255, 255, 255, 0.04);
  }
  .nav-tab.active {
    color: #0b0d13;
    background: #dec148;
    font-weight: 700;
    box-shadow: 0 4px 15px rgba(222, 193, 72, 0.35);
  }

  /* Tab Panes */
  .tab-pane {
    display: none;
    animation: fadeIn 0.25s ease-in-out;
  }
  .tab-pane.active {
    display: block;
  }
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* Module Card */
  .module-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 22px;
    background: #0c0e17;
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 14px;
    transition: border-color 0.2s, background-color 0.2s;
  }
  .module-card:hover {
    border-color: rgba(222, 193, 72, 0.3);
    background: #0f121d;
  }

  /* Toggle Switch */
  .switch {
    position: relative;
    display: inline-block;
    width: 52px;
    height: 28px;
    flex-shrink: 0;
  }
  .switch input {
    opacity: 0;
    width: 0;
    height: 0;
  }
  .slider {
    position: absolute;
    cursor: pointer;
    inset: 0;
    background-color: #242938;
    transition: .3s cubic-bezier(0.4, 0, 0.2, 1);
    border-radius: 34px;
    border: 1px solid rgba(255,255,255,0.1);
  }
  .slider:before {
    position: absolute;
    content: "";
    height: 20px;
    width: 20px;
    left: 3px;
    bottom: 3px;
    background-color: #ffffff;
    transition: .3s cubic-bezier(0.4, 0, 0.2, 1);
    border-radius: 50%;
    box-shadow: 0 2px 5px rgba(0,0,0,0.3);
  }
  .switch input:checked + .slider {
    background-color: #dec148 !important;
    border-color: #dec148;
  }
  .switch input:checked + .slider:before {
    transform: translateX(24px) !important;
    background-color: #0b0d13 !important;
  }

  /* Autofill fixes */
  input:-webkit-autofill,
  input:-webkit-autofill:hover, 
  input:-webkit-autofill:focus,
  textarea:-webkit-autofill {
    -webkit-text-fill-color: #fff !important;
    -webkit-box-shadow: 0 0 0px 1000px #0c0e17 inset !important;
    transition: background-color 5000s ease-in-out 0s !important;
  }
</style>

<script is:inline define:vars={{ defaultDeepSeekKey }}>
  document.addEventListener('DOMContentLoaded', () => {
    const loginGate = document.getElementById('loginGate');
    const adminContent = document.getElementById('adminContent');
    const passInput = document.getElementById('adminPassInput');
    const loginBtn = document.getElementById('adminLoginBtn');
    const errorMsg = document.getElementById('loginErrorMsg');
    const logoutBtn = document.getElementById('logoutBtn');

    const SECRET_KEY = "BitScorpio01!";
    const DEEPSEEK_KEY = defaultDeepSeekKey;

    let currentGeneratedLocation = null;
    let currentGeneratedBlog = null;

    function checkAuth() {
      if (sessionStorage.getItem('bitblox_admin_auth') === 'true') {
        if (loginGate) loginGate.style.display = 'none';
        if (adminContent) adminContent.style.display = 'block';
      } else {
        if (loginGate) loginGate.style.display = 'flex';
        if (adminContent) adminContent.style.display = 'none';
      }
    }

    if (loginBtn && passInput) {
      function doLogin() {
        if (passInput.value === SECRET_KEY) {
          sessionStorage.setItem('bitblox_admin_auth', 'true');
          if (errorMsg) errorMsg.style.display = 'none';
          checkAuth();
        } else {
          if (errorMsg) errorMsg.style.display = 'block';
        }
      }

      loginBtn.addEventListener('click', doLogin);
      passInput.addEventListener('keypress', (e) => {
        if (e.key === 'Enter') doLogin();
      });
    }

    if (logoutBtn) {
      logoutBtn.addEventListener('click', () => {
        sessionStorage.removeItem('bitblox_admin_auth');
        checkAuth();
      });
    }

    checkAuth();

    // 📑 Tab Navigation Handler
    const navTabs = document.querySelectorAll('.nav-tab');
    const tabPanes = document.querySelectorAll('.tab-pane');

    navTabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const targetId = tab.getAttribute('data-tab');
        navTabs.forEach(t => t.classList.remove('active'));
        tabPanes.forEach(p => p.classList.remove('active'));

        tab.classList.add('active');
        const targetPane = document.getElementById(targetId);
        if (targetPane) targetPane.classList.add('active');
      });
    });

    // 🎛️ Schuifjes & Client Switcher
    const clientSelectDropdown = document.getElementById('clientSelectDropdown');
    const clientLiveLink = document.getElementById('clientLiveLink');
    const clientLiveDomainText = document.getElementById('clientLiveDomainText');
    const headerClientTitle = document.getElementById('headerClientTitle');
    const switchesClientName = document.getElementById('switchesClientName');

    const toggleBlog = document.getElementById('toggleBlog');
    const toggleSeo = document.getElementById('toggleSeo');
    const toggleGeo = document.getElementById('toggleGeo');
    const toggleWhatsapp = document.getElementById('toggleWhatsapp');
    const toggleMicrosites = document.getElementById('toggleMicrosites');
    const toggleReviews = document.getElementById('toggleReviews');
    const toggleFaq = document.getElementById('toggleFaq');
    const toggleForm = document.getElementById('toggleForm');
    const saveSwitchesBtn = document.getElementById('saveSwitchesBtn');
    const saveSwitchesStatus = document.getElementById('saveSwitchesStatus');

    const micrositeToolSection = document.getElementById('micrositeToolSection');
    const blogToolSection = document.getElementById('blogToolSection');
    const reviewsToolSection = document.getElementById('reviewsToolSection');
    const clientTargetNameLabels = document.querySelectorAll('.clientTargetName');

    const tabBtnMicrosites = document.getElementById('tabBtnMicrosites');
    const tabBtnBlog = document.getElementById('tabBtnBlog');
    const tabBtnReviews = document.getElementById('tabBtnReviews');

    const micrositeCountDisplay = document.getElementById('micrositeCountDisplay');
    const micrositeListDisplay = document.getElementById('micrositeListDisplay');
    const blogCountDisplay = document.getElementById('blogCountDisplay');
    const blogListDisplay = document.getElementById('blogListDisplay');
    const reviewCountDisplay = document.getElementById('reviewCountDisplay');
    const reviewListDisplay = document.getElementById('reviewListDisplay');

    const kpiMicrosites = document.getElementById('kpiMicrosites');
    const kpiBlogs = document.getElementById('kpiBlogs');
    const kpiReviews = document.getElementById('kpiReviews');

    const blogInput = document.getElementById('blogInput');
    if (blogInput) blogInput.value = '';

    let currentSelectedClient = 'bitblox';

    const clientConfigs = {
      bitblox: {
        name: "BitbloX Webdesign & Hosting",
        domain: "bitblox.nl",
        pagesUrl: "https://bitblox.nl",
        switches: { blog: true, seo: true, geo: true, whatsapp: true, microsites: true, reviews: true, faq: true, form: true },
        microsites: [
          { name: "Assen", url: "/webdesign-assen/", slug: "assen" },
          { name: "Groningen", url: "/webdesign-groningen/", slug: "groningen" },
          { name: "Haren", url: "/webdesign-haren/", slug: "haren" },
          { name: "Eelde", url: "/webdesign-eelde/", slug: "eelde" },
          { name: "Norg", url: "/webdesign-norg/", slug: "norg" }
        ],
        blogs: [
          { id: "ai-vindbaarheid-chatgpt-zzp", title: "AI-Vindbaarheid (GEO) gids", url: "/blog/ai-vindbaarheid-chatgpt-zzp/" },
          { id: "de-5-grootste-fouten-op-zzp-websites", title: "5 grootste fouten op zzp sites", url: "/blog/de-5-grootste-fouten-op-zzp-websites/" },
          { id: "de-kracht-van-microsites", title: "De kracht van microsites", url: "/blog/de-kracht-van-microsites/" }
        ],
        reviews: [
          { name: "Alianne Zuidhof", rating: "★★★★★" },
          { name: "MC Scholts", rating: "★★★★★" },
          { name: "Jeroen Renkema", rating: "★★★★★" }
        ]
      },
      autokampeerder: {
        name: "De Autokampeerder",
        domain: "deautokampeerder.nl",
        pagesUrl: "https://deautokampeerder.pages.dev",
        switches: { blog: true, seo: true, geo: false, whatsapp: false, microsites: false, reviews: false, faq: true, form: true },
        microsites: [],
        blogs: [
          { id: "daktent-op-kleine-auto-mogelijk-en-tips", title: "Daktent op kleine auto (Fiat 500, Polo)", url: "https://deautokampeerder.pages.dev/kennisbank/daktent-op-kleine-auto-mogelijk-en-tips" },
          { id: "wat-is-een-daktent", title: "Wat is een daktent & waarom kampeerervaring?", url: "https://deautokampeerder.pages.dev/kennisbank/wat-is-een-daktent" },
          { id: "past-een-daktent-op-mijn-auto", title: "Past een daktent op mijn auto? Daklast gids", url: "https://deautokampeerder.pages.dev/kennisbank/past-een-daktent-op-mijn-auto" },
          { id: "voordelen-van-een-hardshell-daktent-ten-opzichte-van-een-softshell", title: "Hardshell vs Softshell Daktent: 7 Voordelen", url: "https://deautokampeerder.pages.dev/kennisbank/voordelen-van-een-hardshell-daktent-ten-opzichte-van-een-softshell" }
