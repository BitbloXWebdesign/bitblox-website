    const saveEditedReviewBtn = document.getElementById('saveEditedReviewBtn');
    const modalEditStatus = document.getElementById('modalEditStatus');

    const editReviewIndex = document.getElementById('editReviewIndex');
    const modalEditName = document.getElementById('modalEditName');
    const modalEditRating = document.getElementById('modalEditRating');
    const modalEditLocation = document.getElementById('modalEditLocation');
    const modalEditText = document.getElementById('modalEditText');

    window.openEditReviewModal = (idx) => {
      const conf = clientConfigs[currentSelectedClient];
      const r = conf.reviews[idx];
      if (!r) return;

      if (editReviewIndex) editReviewIndex.value = idx;
      if (modalEditName) modalEditName.value = r.name || r.author || '';
      if (modalEditLocation) modalEditLocation.value = r.location || '';
      if (modalEditRating) modalEditRating.value = typeof r.rating === 'number' ? r.rating : 5;
