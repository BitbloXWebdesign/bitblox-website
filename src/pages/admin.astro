---
import Layout from '../layouts/Layout.astro';
import locationsData from '../data/locations.json';
import reviewsData from '../data/reviews.json';
import { getCollection } from 'astro:content';

const currentLocations = Object.values(locationsData);
const blogPosts = await getCollection('blog');
const defaultDeepSeekKey = import.meta.env.DEEPSEEK_API_KEY || '';
---

<Layout title="BitbloX Admin — Command Center" description="Beheermodule voor het beheren van klantsites, microsites, blog-artikelen en reviews.">
  
  <!-- Login Gate Modal -->
  <div id="loginGate" style="position: fixed; inset: 0; z-index: 9999; background: radial-gradient(circle at 50% 30%, #151824 0%, #08090d 100%); backdrop-filter: blur(24px); display: flex; align-items: center; justify-content: center; padding: 20px;">
    <div style="max-width: 440px; width: 100%; padding: 44px 36px; background: rgba(18, 21, 32, 0.85); border: 1px solid rgba(222, 193, 72, 0.3); border-radius: 20px; text-align: center; box-shadow: 0 25px 70px rgba(0,0,0,0.8), 0 0 40px rgba(222, 193, 72, 0.1); backdrop-filter: blur(16px);">
      <img src="/assets/img/logo-light.png" alt="BitbloX" style="height: 38px; margin: 0 auto 24px; display: block; filter: drop-shadow(0 4px 12px rgba(222, 193, 72, 0.3));" />
      <div style="display: inline-flex; align-items: center; gap: 6px; padding: 4px 12px; background: rgba(222, 193, 72, 0.1); border: 1px solid rgba(222, 193, 72, 0.25); border-radius: 999px; margin-bottom: 14px;">
        <span style="width: 6px; height: 6px; border-radius: 50%; background: #dec148; box-shadow: 0 0 8px #dec148;"></span>
        <span style="font-size: 0.75rem; font-weight: 700; color: #dec148; letter-spacing: 0.08em; text-transform: uppercase;">Command Center</span>
      </div>
      <h2 style="font-size: 1.5rem; color: #ffffff; margin-bottom: 8px; font-weight: 700;">Beveiligde Toegang</h2>
      <p style="font-size: 0.88rem; color: #94a3b8; margin-bottom: 28px; line-height: 1.5;">Voer uw beheerderswachtwoord in om het centrale BitbloX Agency Dashboard te openen.</p>
      
      <div style="display: flex; flex-direction: column; gap: 16px;">
        <input 
          type="password" 
          id="adminPassInput" 
          placeholder="••••••••••••" 
          style="width: 100%; padding: 15px 20px; background: #0c0e15; border: 1px solid rgba(255,255,255,0.12); border-radius: 12px; color: #fff; font-size: 1.1rem; text-align: center; letter-spacing: 2px; transition: border-color 0.2s;"
        />
        <button id="adminLoginBtn" class="btn btn--gold" style="width: 100%; justify-content: center; padding: 14px; font-size: 1rem; border-radius: 12px; box-shadow: 0 10px 25px rgba(222, 193, 72, 0.35);">
          Dashboard Ontgrendelen 🔑
        </button>
        <p id="loginErrorMsg" style="color: #f87171; font-size: 0.85rem; margin: 0; display: none;">⚠️ Onjuist wachtwoord. Probeer het opnieuw.</p>
      </div>
    </div>
  </div>

  <!-- Protected Admin Dashboard Content -->
  <div id="adminContent" style="display: none; min-height: 100vh; background: #08090d;">
    
    <!-- Top Command Center Bar -->
    <header style="background: rgba(14, 17, 26, 0.9); border-bottom: 1px solid rgba(255,255,255,0.08); backdrop-filter: blur(20px); position: sticky; top: 0; z-index: 100; padding: 16px 0;">
      <div class="container" style="max-width: 1180px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px;">
        
        <!-- Left: Brand & Active Client Badge -->
        <div style="display: flex; align-items: center; gap: 16px;">
          <a href="/" style="display: flex; align-items: center;">
            <img src="/assets/img/logo-light.png" alt="BitbloX" style="height: 30px;" />
          </a>
          <span style="color: rgba(255,255,255,0.2); font-size: 1.2rem;">/</span>
          <div style="display: flex; align-items: center; gap: 8px;">
            <span style="font-size: 0.9rem; font-weight: 700; color: #fff;" id="headerClientTitle">BitbloX Webdesign</span>
            <span id="activeClientBadge" style="display: inline-flex; align-items: center; gap: 5px; font-size: 0.72rem; background: rgba(34, 197, 94, 0.12); color: #4ade80; border: 1px solid rgba(34, 197, 94, 0.3); padding: 2px 10px; border-radius: 999px; font-weight: 700;">
              <span style="width: 5px; height: 5px; border-radius: 50%; background: #4ade80; box-shadow: 0 0 6px #4ade80;"></span> Live
            </span>
          </div>
        </div>

        <!-- Right: Actions & Logout -->
        <div style="display: flex; align-items: center; gap: 12px;">
          <a id="clientLiveLink" href="https://bitblox.nl" target="_blank" rel="noopener" class="btn btn--gold btn--sm" style="padding: 9px 16px; font-size: 0.84rem; border-radius: 999px; display: inline-flex; align-items: center; gap: 6px;">
            <span>🌐 Live Site</span> <span id="clientLiveDomainText" style="opacity: 0.85;">(bitblox.nl)</span> ↗
          </a>
          <button id="logoutBtn" class="btn btn--ghost btn--sm" style="padding: 9px 14px; font-size: 0.84rem; border-radius: 999px; color: #94a3b8; border-color: rgba(255,255,255,0.1);">
            🔒 Uitloggen
          </button>
        </div>

      </div>
    </header>

    <!-- Main Workspace Container -->
    <main style="padding: 36px 0 80px;">
      <div class="container" style="max-width: 1180px;">
        
        <!-- 🌟 HERO CLIENT SWITCHER & METRICS CARD -->
        <div style="background: linear-gradient(135deg, rgba(20, 24, 38, 0.9) 0%, rgba(12, 14, 22, 0.95) 100%); border: 1px solid rgba(222, 193, 72, 0.25); border-radius: 20px; padding: 28px 32px; margin-bottom: 32px; box-shadow: 0 20px 50px rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 24px;">
          
          <!-- Dropdown Section -->
          <div style="flex: 1; min-width: 300px;">
            <label for="clientSelectDropdown" style="display: block; font-size: 0.76rem; font-weight: 700; color: #dec148; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 8px;">
              Actieve Klantsite Selecteren
            </label>
            <div style="position: relative;">
              <select id="clientSelectDropdown" style="width: 100%; padding: 14px 20px; background: #0c0e17; border: 1px solid rgba(222, 193, 72, 0.35); border-radius: 12px; color: #fff; font-size: 1.05rem; font-weight: 700; cursor: pointer; appearance: none; -webkit-appearance: none; box-shadow: inset 0 2px 4px rgba(0,0,0,0.4);">
                <option value="bitblox" selected>🌐 BitbloX Webdesign (bitblox.nl)</option>
                <option value="autokampeerder">🚐 De Autokampeerder (deautokampeerder.nl)</option>
                <option value="voetreflextherapeut">🌿 Voetreflextherapeut Groningen (voetreflextherapeutgroningen.nl)</option>
              </select>
              <span style="position: absolute; right: 18px; top: 50%; transform: translateY(-50%); pointer-events: none; color: #dec148; font-size: 0.85rem;">▼</span>
            </div>
          </div>

          <!-- Quick Metrics Badges -->
          <div style="display: flex; gap: 14px; flex-wrap: wrap;">
            <div style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08); border-radius: 14px; padding: 12px 20px; min-width: 110px; text-align: center;">
              <span style="display: block; font-size: 0.75rem; color: #94a3b8; font-weight: 600; text-transform: uppercase;">Microsites</span>
              <strong id="kpiMicrosites" style="font-size: 1.4rem; color: #dec148; font-weight: 800;">{currentLocations.length}</strong>
            </div>
            <div style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08); border-radius: 14px; padding: 12px 20px; min-width: 110px; text-align: center;">
              <span style="display: block; font-size: 0.75rem; color: #94a3b8; font-weight: 600; text-transform: uppercase;">Blogs</span>
              <strong id="kpiBlogs" style="font-size: 1.4rem; color: #dec148; font-weight: 800;">{blogPosts.length}</strong>
            </div>
            <div style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08); border-radius: 14px; padding: 12px 20px; min-width: 110px; text-align: center;">
              <span style="display: block; font-size: 0.75rem; color: #94a3b8; font-weight: 600; text-transform: uppercase;">Reviews</span>
              <strong id="kpiReviews" style="font-size: 1.4rem; color: #dec148; font-weight: 800;">{reviewsData.length}</strong>
            </div>
          </div>

        </div>

        <!-- 📑 MODERN SEGMENTED TAB NAVIGATION -->
        <div style="display: flex; gap: 8px; margin-bottom: 28px; background: #111420; padding: 6px; border-radius: 14px; border: 1px solid rgba(255,255,255,0.06); overflow-x: auto;">
          <button class="nav-tab active" data-tab="tab-switches">
            🎛️ 1. Modules &amp; Schuifjes
          </button>
          <button class="nav-tab" data-tab="tab-microsites" id="tabBtnMicrosites">
            📍 2. Regio Microsites
          </button>
          <button class="nav-tab" data-tab="tab-blog" id="tabBtnBlog">
            📝 3. AI Blog Studio
          </button>
          <button class="nav-tab" data-tab="tab-reviews" id="tabBtnReviews">
            ⭐ 4. Google Reviews
          </button>
          <button class="nav-tab" data-tab="tab-overview">
            📊 5. Content Overzicht &amp; Prullenbak
          </button>
        </div>

        <!-- ================= TAB 1: SCHUIFJES & MODULES ================= -->
        <div id="tab-switches" class="tab-pane active">
          <div style="background: #111420; border: 1px solid rgba(255,255,255,0.08); border-radius: 20px; padding: 32px; box-shadow: 0 15px 40px rgba(0,0,0,0.4);">
            <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px; margin-bottom: 24px; border-bottom: 1px solid rgba(255,255,255,0.08); padding-bottom: 20px;">
              <div>
                <h3 style="font-size: 1.3rem; color: #fff; margin: 0 0 6px 0; font-weight: 700;">
                  Actieve Modules voor <span id="switchesClientName" style="color: #dec148;">BitbloX Webdesign</span>
                </h3>
                <p style="font-size: 0.88rem; color: #94a3b8; margin: 0;">Schakel eenvoudig functionaliteiten aan of uit. Uitgeschakelde onderdelen verdwijnen direct van de site!</p>
              </div>
              <button id="saveSwitchesBtn" class="btn btn--gold" style="padding: 12px 24px; border-radius: 12px; font-weight: 700; box-shadow: 0 8px 25px rgba(222, 193, 72, 0.3);">
                💾 Opslaan &amp; Synchroniseren
              </button>
            </div>

            <!-- 2-Column Grid voor de 8 Schuifjes -->
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(360px, 1fr)); gap: 16px; margin-bottom: 24px;">
              
              <!-- 1. Blog -->
              <div class="module-card">
                <div style="flex: 1;">
                  <strong style="display: block; color: #fff; font-size: 0.95rem; margin-bottom: 2px;">📝 Blog / Kennisbank</strong>
                  <span style="font-size: 0.8rem; color: #94a3b8;">Kennisbank artikelen &amp; Blog Studio editor.</span>
                </div>
                <label class="switch">
                  <input type="checkbox" id="toggleBlog" checked>
                  <span class="slider"></span>
                </label>
              </div>

              <!-- 2. SEO -->
              <div class="module-card">
                <div style="flex: 1;">
                  <strong style="display: block; color: #fff; font-size: 0.95rem; margin-bottom: 2px;">🔍 SEO (Google Zoekmachine)</strong>
                  <span style="font-size: 0.8rem; color: #94a3b8;">Google sitemaps, meta-tags &amp; Schema.org.</span>
                </div>
                <label class="switch">
                  <input type="checkbox" id="toggleSeo" checked>
                  <span class="slider"></span>
                </label>
              </div>

              <!-- 3. GEO -->
              <div class="module-card">
                <div style="flex: 1;">
                  <strong style="display: block; color: #fff; font-size: 0.95rem; margin-bottom: 2px;">🤖 AI-Vindbaarheid (GEO)</strong>
                  <span style="font-size: 0.8rem; color: #94a3b8;">Aanbevelingen in ChatGPT, Gemini &amp; llms.txt.</span>
                </div>
                <label class="switch">
                  <input type="checkbox" id="toggleGeo" checked>
                  <span class="slider"></span>
                </label>
              </div>

              <!-- 4. WhatsApp -->
              <div class="module-card">
                <div style="flex: 1;">
                  <strong style="display: block; color: #fff; font-size: 0.95rem; margin-bottom: 2px;">💬 WhatsApp Floating Widget</strong>
                  <span style="font-size: 0.8rem; color: #94a3b8;">Zwevende chat-knop rechtsonder op de site.</span>
                </div>
                <label class="switch">
                  <input type="checkbox" id="toggleWhatsapp" checked>
                  <span class="slider"></span>
                </label>
              </div>

              <!-- 5. Microsites -->
              <div class="module-card">
                <div style="flex: 1;">
                  <strong style="display: block; color: #fff; font-size: 0.95rem; margin-bottom: 2px;">📍 Steden-Microsites</strong>
                  <span style="font-size: 0.8rem; color: #94a3b8;">Regio-landingspagina's voor omliggende dorpen.</span>
                </div>
                <label class="switch">
                  <input type="checkbox" id="toggleMicrosites" checked>
                  <span class="slider"></span>
                </label>
              </div>

              <!-- 6. Reviews -->
              <div class="module-card">
                <div style="flex: 1;">
                  <strong style="display: block; color: #fff; font-size: 0.95rem; margin-bottom: 2px;">⭐ Google Reviews Carrousel</strong>
                  <span style="font-size: 0.8rem; color: #94a3b8;">Interactieve swipebare reviews op de site.</span>
                </div>
                <label class="switch">
                  <input type="checkbox" id="toggleReviews" checked>
                  <span class="slider"></span>
                </label>
              </div>

              <!-- 7. FAQ -->
              <div class="module-card">
                <div style="flex: 1;">
                  <strong style="display: block; color: #fff; font-size: 0.95rem; margin-bottom: 2px;">❓ Veelgestelde Vragen (FAQ)</strong>
                  <span style="font-size: 0.8rem; color: #94a3b8;">Uitklapbaar FAQ blok met Schema markup.</span>
                </div>
                <label class="switch">
                  <input type="checkbox" id="toggleFaq" checked>
                  <span class="slider"></span>
                </label>
              </div>

              <!-- 8. Formulier -->
              <div class="module-card">
                <div style="flex: 1;">
                  <strong style="display: block; color: #fff; font-size: 0.95rem; margin-bottom: 2px;">📩 Contact &amp; Offerte Formulier</strong>
                  <span style="font-size: 0.8rem; color: #94a3b8;">E-mailformulier met brachedropdown keuzes.</span>
                </div>
                <label class="switch">
                  <input type="checkbox" id="toggleForm" checked>
                  <span class="slider"></span>
                </label>
              </div>

            </div>

            <div id="saveSwitchesStatus" style="font-size: 0.9rem; color: #4ade80; font-weight: 700; text-align: right; min-height: 24px;"></div>
          </div>
        </div>

        <!-- ================= TAB 2: MICROSITES ================= -->
        <div id="tab-microsites" class="tab-pane">
          <div id="micrositeToolSection" style="background: #111420; border: 1px solid rgba(255,255,255,0.08); border-radius: 20px; padding: 32px; box-shadow: 0 15px 40px rgba(0,0,0,0.4);">
            <div style="margin-bottom: 24px;">
              <h3 style="font-size: 1.3rem; color: #fff; margin: 0 0 6px 0; font-weight: 700;">
                📍 DeepSeek Microsite Generator voor <span class="clientTargetName" style="color: #dec148;">BitbloX Webdesign</span>
              </h3>
              <p style="font-size: 0.88rem; color: #94a3b8; margin: 0;">Voer een plaatsnaam in (bijv. <em>Veendam, Emmen, Zuidlaren</em>). DeepSeek genereert direct de echte wijken, provincie en SEO-content.</p>
            </div>

            <div style="display: flex; gap: 14px; flex-wrap: wrap; margin-bottom: 24px;">
              <input 
                type="text" 
                id="cityInput" 
                placeholder="Typ plaatsnaam of regio (bijv. Haren, Veendam)..." 
                autocomplete="off"
                style="flex: 1; min-width: 280px; padding: 15px 20px; background: #0c0e17; border: 1px solid rgba(255,255,255,0.12); border-radius: 12px; color: #fff; font-size: 1rem;"
              />
              <button id="generateBtn" class="btn btn--gold" style="padding: 14px 28px; border-radius: 12px; font-weight: 700; white-space: nowrap;">
                🤖 Genereer via DeepSeek AI
              </button>
            </div>

            <div id="resultBox" style="display: none; background: #0c0e17; border: 1px solid rgba(222, 193, 72, 0.3); border-radius: 16px; padding: 24px;">
              <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px;">
                <h4 style="color: #dec148; margin: 0; font-size: 1.1rem;">Gegenereerde Data voor <span id="generatedCityName"></span></h4>
                <span id="sourceBadge" style="font-size: 0.75rem; background: rgba(222,193,72,0.15); color: #dec148; border: 1px solid rgba(222,193,72,0.3); padding: 3px 12px; border-radius: 999px; font-weight: 700;">DeepSeek AI Output</span>
              </div>
              <pre id="jsonPreview" style="background: #141724; padding: 18px; border-radius: 12px; font-size: 0.88rem; color: #dec148; overflow-x: auto; max-height: 280px; line-height: 1.5; font-family: monospace;"></pre>
              
              <div style="margin-top: 18px; display: flex; gap: 12px; flex-wrap: wrap; align-items: center; justify-content: space-between;">
                <div style="display: flex; gap: 12px; flex-wrap: wrap;">
                  <button id="saveLocationBtn" class="btn btn--gold btn--sm" style="border-radius: 999px; padding: 10px 20px;">📍 Bewaar &amp; Publiceer Microsite</button>
                  <button id="copyJsonBtn" class="btn btn--ghost btn--sm" style="border-radius: 999px; padding: 10px 20px;">📋 Kopieer JSON</button>
                </div>
                <span id="saveLocationStatus" style="font-size: 0.88rem; color: #4ade80; font-weight: 700;"></span>
              </div>
            </div>
          </div>
        </div>

        <!-- ================= TAB 3: BLOG STUDIO ================= -->
        <div id="tab-blog" class="tab-pane">
          <div id="blogToolSection" style="background: #111420; border: 1px solid rgba(255,255,255,0.08); border-radius: 20px; padding: 32px; box-shadow: 0 15px 40px rgba(0,0,0,0.4);">
            <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px; margin-bottom: 24px; border-bottom: 1px solid rgba(255,255,255,0.08); padding-bottom: 18px;">
              <div>
                <h3 style="font-size: 1.3rem; color: #fff; margin: 0 0 6px 0; font-weight: 700;">
                  📝 Blog Studio / Kennisbank voor <span class="clientTargetName" style="color: #dec148;">BitbloX Webdesign</span>
                </h3>
                <p style="font-size: 0.88rem; color: #94a3b8; margin: 0;">Genereer razendsnel nieuwe artikelen via AI of giet een eigen verhaal in een strakke SEO structuur.</p>
              </div>
              <div style="display: flex; gap: 8px;">
                <button id="modeAiBtn" class="btn btn--gold btn--sm" style="border-radius: 999px; padding: 8px 16px;">🤖 Genereer via AI</button>
                <button id="modeManualBtn" class="btn btn--ghost btn--sm" style="border-radius: 999px; padding: 8px 16px;">✍️ Eigen Verhaal Opmaken</button>
              </div>
            </div>

            <!-- Input AI Mode -->
            <div id="aiInputSection" style="display: flex; gap: 14px; flex-wrap: wrap; margin-bottom: 20px;">
              <input 
                type="search" 
                id="blogInput" 
                name="searchTopicFieldNoFill"
                placeholder="Voer blog-onderwerp in (bijv. Voetreflex bij migraine, Daktent tips)..." 
                autocomplete="new-password"
                style="flex: 1; min-width: 280px; padding: 15px 20px; background: #0c0e17; border: 1px solid rgba(255,255,255,0.12); border-radius: 12px; color: #fff; font-size: 1rem;"
              />
              <button id="generateBlogBtn" class="btn btn--gold" style="padding: 14px 28px; border-radius: 12px; font-weight: 700; white-space: nowrap;">
                🚀 Schrijf Artikel via DeepSeek
              </button>
            </div>

            <!-- Input Manual Story Mode -->
            <div id="manualInputSection" style="display: none; flex-direction: column; gap: 14px; margin-bottom: 20px;">
              <input 
                type="text" 
                id="manualTitleInput" 
                placeholder="Titel of hoofdonderwerp van het verhaal..." 
                autocomplete="off"
                style="width: 100%; padding: 14px 20px; background: #0c0e17; border: 1px solid rgba(255,255,255,0.12); border-radius: 12px; color: #fff; font-size: 1rem;"
              />
              <textarea 
                id="manualStoryText" 
                rows="5" 
                placeholder="Plak hier je ruwe gedachten, tips of verhaal... DeepSeek transformeert het automatisch in een perfect opgemaakte SEO-blog!"
                style="width: 100%; padding: 16px; background: #0c0e17; border: 1px solid rgba(255,255,255,0.12); border-radius: 12px; color: #fff; font-family: inherit; font-size: 0.95rem; line-height: 1.5;"
              ></textarea>
              <button id="transformStoryBtn" class="btn btn--gold" style="padding: 14px; border-radius: 12px; font-weight: 700;">
                ✨ Transformeer naar SEO Blog
              </button>
            </div>

            <!-- Interactive Editor Area -->
            <div id="blogResultBox" style="display: none; background: #0c0e17; border: 1px solid rgba(222, 193, 72, 0.3); border-radius: 16px; padding: 24px;">
              <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px; flex-wrap: wrap; gap: 10px;">
                <h4 style="color: #dec148; margin: 0; font-size: 1.05rem;">Bestand: <span id="generatedBlogFilename" style="font-family: monospace;"></span></h4>
                <span id="blogSourceBadge" style="font-size: 0.75rem; background: rgba(222,193,72,0.15); color: #dec148; border: 1px solid rgba(222,193,72,0.3); padding: 3px 12px; border-radius: 999px; font-weight: 700;">Markdown Live Editor</span>
              </div>

              <div style="margin-bottom: 16px;">
                <textarea 
                  id="blogMarkdownEditor" 
                  rows="15" 
                  style="width: 100%; padding: 18px; background: #141724; border: 1px solid rgba(222, 193, 72, 0.25); border-radius: 12px; font-family: monospace; font-size: 0.9rem; color: #dec148; line-height: 1.6; resize: vertical;"
                ></textarea>
              </div>
              
              <div style="display: flex; gap: 12px; flex-wrap: wrap; align-items: center; justify-content: space-between;">
                <div style="display: flex; gap: 12px; flex-wrap: wrap;">
                  <button id="saveBlogBtn" class="btn btn--gold btn--sm" style="border-radius: 999px; padding: 10px 20px;">🚀 Bewaar &amp; Publiceer Artikel</button>
                  <button id="copyBlogBtn" class="btn btn--ghost btn--sm" style="border-radius: 999px; padding: 10px 20px;">📋 Kopieer Tekst</button>
                </div>
                <span id="saveBlogStatus" style="font-size: 0.88rem; color: #4ade80; font-weight: 700;"></span>
              </div>
            </div>
          </div>
        </div>

        <!-- ================= TAB 4: REVIEWS ================= -->
        <div id="tab-reviews" class="tab-pane">
          <div id="reviewsToolSection" style="background: #111420; border: 1px solid rgba(255,255,255,0.08); border-radius: 20px; padding: 32px; box-shadow: 0 15px 40px rgba(0,0,0,0.4);">
            <div style="margin-bottom: 24px;">
              <h3 style="font-size: 1.3rem; color: #fff; margin: 0 0 6px 0; font-weight: 700;">
                ⭐ Google Review Toevoegen voor <span class="clientTargetName" style="color: #dec148;">BitbloX Webdesign</span>
              </h3>
