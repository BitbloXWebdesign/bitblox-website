    // 📈 Interactive SVG Wave Chart Crosshair & Floating Tooltip
    const chartContainer = document.getElementById('chartContainer');
    const chartTooltip = document.getElementById('chartTooltip');
    const tooltipDate = document.getElementById('tooltipDate');
    const tooltipGoogle = document.getElementById('tooltipGoogle');
    const tooltipAi = document.getElementById('tooltipAi');
    const tooltipTotal = document.getElementById('tooltipTotal');
    const chartCrosshair = document.getElementById('chartCrosshair');
    const hoverDotBlue = document.getElementById('hoverDotBlue');
    const hoverDotGold = document.getElementById('hoverDotGold');

    if (chartContainer) {
      chartContainer.addEventListener('mousemove', (e) => {
        const rect = chartContainer.getBoundingClientRect();
        const mouseX = e.clientX - rect.left;
        const width = rect.width;
        
        // Map mouseX to day index (0..13 for 14 days)
        const dayIdx = Math.max(0, Math.min(13, Math.floor((mouseX / width) * 14)));
        const conf = clientConfigs[currentSelectedClient];
        if (!conf || !conf.dailyData) return;

        const dayItem = conf.dailyData[dayIdx];
        if (!dayItem) return;

        // Position floating cyber tooltip
        if (chartTooltip) {
          chartTooltip.style.display = 'block';
          // Constrain tooltip horizontally inside box
          const tooltipLeft = Math.max(90, Math.min(width - 90, mouseX));
          chartTooltip.style.left = `${tooltipLeft}px`;
          chartTooltip.style.top = `${Math.max(40, e.clientY - rect.top)}px`;
          
          if (tooltipDate) tooltipDate.textContent = `📅 ${dayItem.date} 2026`;
          if (tooltipGoogle) tooltipGoogle.textContent = `+${dayItem.google} bezoekers`;
          if (tooltipAi) tooltipAi.textContent = `+${dayItem.ai} zoekers`;
          if (tooltipTotal) tooltipTotal.textContent = `${dayItem.google + dayItem.ai} bezoeken`;
        }

        // Move SVG Crosshair & Glowing Snapping Dots
        const svgX = (dayIdx / 13) * 500;
        if (chartCrosshair) {
          chartCrosshair.style.display = 'block';
          chartCrosshair.setAttribute('x1', svgX);
          chartCrosshair.setAttribute('x2', svgX);
        }
        if (hoverDotBlue) {
          hoverDotBlue.style.display = 'block';
          hoverDotBlue.setAttribute('cx', svgX);
          hoverDotBlue.setAttribute('cy', dayItem.blueY);
        }
        if (hoverDotGold) {
          hoverDotGold.style.display = 'block';
          hoverDotGold.setAttribute('cx', svgX);
          hoverDotGold.setAttribute('cy', dayItem.goldY);
        }
      });

      chartContainer.addEventListener('mouseleave', () => {
        if (chartTooltip) chartTooltip.style.display = 'none';
        if (chartCrosshair) chartCrosshair.style.display = 'none';
        if (hoverDotBlue) hoverDotBlue.style.display = 'none';
        if (hoverDotGold) hoverDotGold.style.display = 'none';
      });
    }

