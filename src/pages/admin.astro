      const micrositesActive = toggleMicrosites ? toggleMicrosites.checked : true;
      const reviewsActive = toggleReviews ? toggleReviews.checked : true;

      if (tabBtnBlog) tabBtnBlog.style.display = blogActive ? 'block' : 'none';
      if (tabBtnMicrosites) tabBtnMicrosites.style.display = micrositesActive ? 'block' : 'none';
      if (tabBtnReviews) tabBtnReviews.style.display = reviewsActive ? 'block' : 'none';

      if (blogToolSection) blogToolSection.style.display = blogActive ? 'block' : 'none';
      if (micrositeToolSection) micrositeToolSection.style.display = micrositesActive ? 'block' : 'none';
      if (reviewsToolSection) reviewsToolSection.style.display = reviewsActive ? 'block' : 'none';
    }

    function updateClientUI(clientId) {
      if (!clientId || !clientConfigs[clientId]) clientId = 'bitblox';
      currentSelectedClient = clientId;
      const conf = clientConfigs[clientId];
      if (!conf) return;

      if (switchesClientName) switchesClientName.textContent = conf.name;
      if (clientLiveLink) clientLiveLink.href = conf.pagesUrl;
      if (clientLiveDomainText) clientLiveDomainText.textContent = `(${conf.domain})`;

      clientTargetNameLabels.forEach(lbl => {
        lbl.textContent = conf.name;
      });

      if (blogInput) blogInput.value = '';

      if (toggleBlog) toggleBlog.checked = conf.switches.blog;
      if (toggleSeo) toggleSeo.checked = conf.switches.seo;
      if (toggleGeo) toggleGeo.checked = conf.switches.geo;
      if (toggleWhatsapp) toggleWhatsapp.checked = conf.switches.whatsapp !== undefined ? conf.switches.whatsapp : true;
      if (toggleMicrosites) toggleMicrosites.checked = conf.switches.microsites;
      if (toggleReviews) toggleReviews.checked = conf.switches.reviews;
      if (toggleFaq) toggleFaq.checked = conf.switches.faq;
      if (toggleForm) toggleForm.checked = conf.switches.form;
      if (toggleCookies) toggleCookies.checked = conf.switches.cookies !== undefined ? conf.switches.cookies : true;
      if (toggleAnnouncement) toggleAnnouncement.checked = conf.switches.announcement !== undefined ? conf.switches.announcement : false;
      if (toggleAccessibility) toggleAccessibility.checked = conf.switches.accessibility !== undefined ? conf.switches.accessibility : true;
      if (toggleCallback) toggleCallback.checked = conf.switches.callback !== undefined ? conf.switches.callback : false;
      if (toggleMonitoring) toggleMonitoring.checked = conf.switches.monitoring !== undefined ? conf.switches.monitoring : true;
      if (monitoringStatusBox) monitoringStatusBox.style.opacity = (conf.switches.monitoring !== false) ? '1' : '0.4';

      // Update Announcement Input Fields
      if (announcementBadgeInput) announcementBadgeInput.value = conf.announcement?.badge || 'UPDATE';
