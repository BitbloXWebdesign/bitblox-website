    window.deleteReviewItem = async (name, index) => {
      if (!confirm(`Weet je zeker dat je de review van "${name}" wilt verwijderen?`)) return;
      const conf = clientConfigs[currentSelectedClient];
      conf.reviews.splice(index, 1);
      updateClientUI(currentSelectedClient);

      const targetRepo = clientGithubRepoMap[currentSelectedClient];
      if (targetRepo) {
        try {
          const token = localStorage.getItem('bitblox_gh_token') || AUTO_GH_TOKEN;
          const apiUrl = `https://api.github.com/repos/${targetRepo}/contents/src/data/reviews.json`;
          let currentReviews = [];
          const getRes = await fetch(apiUrl, {
            headers: { 'Authorization': `Bearer ${token}`, 'Accept': 'application/vnd.github+json' }
          });
          if (getRes.ok) {
            const getData = await getRes.json();
            try {
              const decoded = decodeURIComponent(escape(atob(getData.content.replace(/\s/g, ''))));
              currentReviews = JSON.parse(decoded);
            } catch (e) {}
          }
          currentReviews = currentReviews.filter((_, i) => i !== index);
          await pushDirectToGitHub(targetRepo, 'src/data/reviews.json', JSON.stringify(currentReviews, null, 2), `Review verwijderd van ${name}`);
        } catch (e) {}
      }

      try {
        await fetch('/api/delete-review', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name, client: currentSelectedClient })
        });
      } catch (e) {
