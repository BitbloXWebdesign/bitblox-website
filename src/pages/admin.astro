    if (saveEditedReviewBtn) {
      saveEditedReviewBtn.addEventListener('click', async () => {
        const idx = Number(editReviewIndex.value);
        const conf = clientConfigs[currentSelectedClient];
        const r = conf.reviews[idx];
        if (!r) return;

        const newName = modalEditName.value.trim();
        const newLoc = modalEditLocation.value.trim();
        const newRating = Number(modalEditRating.value);
        const newText = modalEditText.value.trim();

        if (!newName || !newText) return alert('Voer a.u.b. een naam en tekst in.');

        saveEditedReviewBtn.textContent = '⏳ Opslaan...';
        saveEditedReviewBtn.disabled = true;

        r.name = newName;
        r.author = newName;
        r.location = newLoc;
        r.rating = newRating;
        r.ratingDisplay = '★'.repeat(newRating) + '☆'.repeat(Math.max(0, 5 - newRating));
        r.text = newText;
        const initials = newName.split(' ').map(n => n[0]).join('').substring(0, 2).toUpperCase();
        r.initials = initials || 'G';

        // Direct Cloud GitHub API Push
        const targetRepo = clientGithubRepoMap[currentSelectedClient];
        if (targetRepo) {
          try {
            const token = localStorage.getItem('bitblox_gh_token') || AUTO_GH_TOKEN;
            const apiUrl = `https://api.github.com/repos/${targetRepo}/contents/src/data/reviews.json`;
            let currentReviews = [];
            let sha = null;
            const getRes = await fetch(apiUrl, {
              headers: { 'Authorization': `Bearer ${token}`, 'Accept': 'application/vnd.github+json' }
            });
            if (getRes.ok) {
              const getData = await getRes.json();
              sha = getData.sha;
              try {
                const decoded = decodeURIComponent(escape(atob(getData.content.replace(/\s/g, ''))));
                currentReviews = JSON.parse(decoded);
              } catch (e) {}
            }

            if (currentReviews.length > idx) {
              currentReviews[idx] = {
                id: currentReviews[idx].id || Date.now(),
                name: newName,
                author: newName,
                location: newLoc,
                rating: newRating,
                text: newText,
                initials: initials || 'G',
                date: currentReviews[idx].date || 'Google Beoordeling'
              };
            }

            await pushDirectToGitHub(
              targetRepo,
              'src/data/reviews.json',
              JSON.stringify(currentReviews.length > 0 ? currentReviews : conf.reviews, null, 2),
              `Review bijgewerkt voor ${newName}`
            );
          } catch (e) {
            console.warn('Edit push error:', e);
          }
        }

        updateClientUI(currentSelectedClient);
        if (modalEditStatus) modalEditStatus.textContent = '✅ Wijzigingen direct gepubliceerd naar Cloudflare!';
        saveEditedReviewBtn.textContent = '✅ Opgeslagen!';

        setTimeout(() => {
          closeReviewEditModal();
          saveEditedReviewBtn.textContent = '💾 Wijzigingen Opslaan & Publiceren';
