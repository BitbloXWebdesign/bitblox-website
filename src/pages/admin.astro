---
import Layout from '../layouts/Layout.astro';
import locationsData from '../data/locations.json';
import reviewsData from '../data/reviews.json';
import { getCollection } from 'astro:content';

const currentLocations = Object.values(locationsData);
const blogPosts = await getCollection('blog');
const defaultDeepSeekKey = import.meta.env.DEEPSEEK_API_KEY || '';
---

<Layout title="BitbloX Admin — Command Center" description="Beheermodule voor het beheren van klantsites, microsites, blog-artikelen en reviews.">
  
  <!-- Login Gate Modal -->
  <div id="loginGate" style="position: fixed; inset: 0; z-index: 999; background: rgba(10, 11, 14, 0.98); backdrop-filter: blur(20px); display: flex; align-items: center; justify-content: center; padding: 20px;">
    <div class="card" style="max-width: 440px; width: 100%; padding: 40px 32px; background: var(--surface); border: 1px solid var(--border-gold); border-radius: var(--radius); text-align: center; box-shadow: 0 20px 60px rgba(0,0,0,0.8);">
      <img src="/assets/img/logo-light.png" alt="BitbloX" style="height: 36px; margin: 0 auto 20px; display: block;" />
      <h2 style="font-size: 1.4rem; color: var(--gold); margin-bottom: 8px;">Beveiligde Admin Toegang</h2>
      <p style="font-size: 0.88rem; color: var(--muted); margin-bottom: 24px;">Voer het beheerderswachtwoord in om toegang te krijgen tot het BitbloX Beheerdashboard.</p>
      
      <div style="display: flex; flex-direction: column; gap: 14px;">
        <input 
          type="password" 
          id="adminPassInput" 
          placeholder="Voer wachtwoord in..." 
          style="width: 100%; padding: 14px 20px; background: var(--bg); border: 1px solid var(--border); border-radius: var(--radius-sm); color: var(--text); font-size: 1rem; text-align: center;"
        />
        <button id="adminLoginBtn" class="btn btn--gold" style="width: 100%; justify-content: center;">
          Inloggen op Dashboard 🔑
        </button>
        <p id="loginErrorMsg" style="color: #ef4444; font-size: 0.85rem; margin: 0; display: none;">Onjuist wachtwoord. Probeer opnieuw.</p>
      </div>
    </div>
  </div>

  <!-- Protected Admin Dashboard Content -->
  <div id="adminContent" style="display: none;">
    <section class="page-hero">
      <div class="hero-grid-bg"></div>
      <div class="container page-hero-inner">
        <nav class="breadcrumb"><a href="/">Home</a> <span>/</span> <span>Admin</span></nav>
        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px;">
          <div>
            <span class="kicker">BitbloX Command Center</span>
            <h1>Klantsite Beheer: <span id="headerClientTitle" class="text-gradient">BitbloX Webdesign</span></h1>
          </div>
          <button id="logoutBtn" class="btn btn--ghost btn--sm">Uitloggen 🔒</button>
        </div>
        <p class="lead">Selecteer hieronder een klantsite uit het dropdownmenu. De hele pagina past zich direct aan!</p>
      </div>
    </section>

    <section class="section">
      <div class="container" style="max-width: 960px;">
        
        <!-- 🎛️ KLANT SELECTOR DROPDOWN & BAR -->
        <div class="card" style="padding: 24px 32px; background: var(--surface); border: 1px solid var(--border-gold); border-radius: var(--radius); margin-bottom: 32px; box-shadow: 0 10px 40px rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 20px;">
          <div style="flex: 1; min-width: 280px;">
            <label for="clientSelectDropdown" style="display: block; font-size: 0.82rem; font-weight: 700; color: var(--gold); text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 8px;">
              Selecteer Klantsite uit Dropdown:
            </label>
            <select id="clientSelectDropdown" style="width: 100%; padding: 14px 20px; background: var(--bg); border: 1px solid var(--border-gold); border-radius: var(--radius-sm); color: var(--gold); font-size: 1.05rem; font-weight: 700; cursor: pointer;">
              <option value="bitblox" selected>🌐 BitbloX Webdesign (bitblox.nl)</option>
              <option value="autokampeerder">🚐 De Autokampeerder (deautokampeerder.nl)</option>
              <option value="voetreflextherapeut">🌿 Voetreflextherapeut Groningen (voetreflextherapeutgroningen.nl)</option>
            </select>
          </div>

          <div style="display: flex; align-items: center; gap: 14px; flex-wrap: wrap;">
            <a id="clientLiveLink" href="https://bitblox.nl" target="_blank" rel="noopener" class="btn btn--gold btn--sm" style="display: inline-flex; align-items: center; gap: 8px; padding: 12px 20px;">
              🔗 Bekijk Live Site <span id="clientLiveDomainText">bitblox.nl</span> ↗
            </a>
          </div>
        </div>

        <!-- 🎛️ SCHUIFJES OVERZICHT PER GEKOZEN KLANT -->
        <div class="card" style="padding: 32px; background: var(--surface); border: 1px solid var(--border-gold); border-radius: var(--radius); margin-bottom: 40px;">
          <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; margin-bottom: 20px;">
            <div>
              <span class="kicker" style="font-size: 0.75rem; letter-spacing: 0.1em; color: var(--gold); font-weight: 700; text-transform: uppercase;">Actieve Modules &amp; Schuifjes</span>
              <h3 style="font-size: 1.25rem; color: var(--text); margin: 4px 0 0 0;">Module Instellingen voor <span id="switchesClientName" style="color: var(--gold);">BitbloX Webdesign</span></h3>
            </div>
            <span id="activeClientBadge" style="font-size: 0.78rem; background: rgba(34, 197, 94, 0.15); color: #22c55e; border: 1px solid #22c55e; padding: 4px 12px; border-radius: 999px; font-weight: 700;">🟢 Live &amp; Beveiligd</span>
          </div>

          <p style="font-size: 0.88rem; color: var(--muted); margin-bottom: 20px;">Schakel hieronder modules aan of uit naar gelang waar de klant voor betaalt. Als een module UIT staat, verdwijnt het onderdeel op de site én de bijbehorende beheertool hieronder automatisch!</p>

          <!-- Schuifjes Grid (8 Afzonderlijke Schuifjes) -->
          <div style="display: flex; flex-direction: column; gap: 14px; margin-bottom: 24px;">
            
            <!-- Schuifje 1: Blog Module -->
            <div style="display: flex; align-items: center; justify-content: space-between; padding: 14px 20px; background: var(--bg-2); border: 1px solid var(--border); border-radius: var(--radius-sm);">
              <div>
                <strong style="display: block; color: var(--text); font-size: 0.95rem;">📝 Blog / Kennisbank Module</strong>
                <span style="font-size: 0.82rem; color: var(--muted);">Toont/verbergt de Kennisbank op de site én de Blog Studio hieronder.</span>
              </div>
              <label class="switch" style="position: relative; display: inline-block; width: 50px; height: 26px;">
                <input type="checkbox" id="toggleBlog" checked style="opacity: 0; width: 0; height: 0;">
                <span class="slider" style="position: absolute; cursor: pointer; inset: 0; background-color: #334155; transition: .3s; border-radius: 34px;"></span>
              </label>
            </div>

            <!-- Schuifje 2: SEO (Google Zoekmachine Optimalisatie) -->
            <div style="display: flex; align-items: center; justify-content: space-between; padding: 14px 20px; background: var(--bg-2); border: 1px solid var(--border); border-radius: var(--radius-sm);">
              <div>
                <strong style="display: block; color: var(--text); font-size: 0.95rem;">🔍 SEO (Google Zoekmachine Optimalisatie)</strong>
                <span style="font-size: 0.82rem; color: var(--muted);">Schakelt Google meta-tags, sitemaps &amp; Schema.org in of uit.</span>
              </div>
              <label class="switch" style="position: relative; display: inline-block; width: 50px; height: 26px;">
                <input type="checkbox" id="toggleSeo" checked style="opacity: 0; width: 0; height: 0;">
                <span class="slider" style="position: absolute; cursor: pointer; inset: 0; background-color: #334155; transition: .3s; border-radius: 34px;"></span>
              </label>
            </div>

            <!-- Schuifje 3: AI-Vindbaarheid (GEO / ChatGPT & Gemini) -->
            <div style="display: flex; align-items: center; justify-content: space-between; padding: 14px 20px; background: var(--bg-2); border: 1px solid var(--border); border-radius: var(--radius-sm);">
              <div>
                <strong style="display: block; color: var(--text); font-size: 0.95rem;">🤖 AI-Vindbaarheid (GEO / ChatGPT &amp; Gemini)</strong>
                <span style="font-size: 0.82rem; color: var(--muted);">Schakelt llms.txt, AI Answer Capsules &amp; Wikipedia SameAs in of uit.</span>
              </div>
              <label class="switch" style="position: relative; display: inline-block; width: 50px; height: 26px;">
                <input type="checkbox" id="toggleGeo" checked style="opacity: 0; width: 0; height: 0;">
                <span class="slider" style="position: absolute; cursor: pointer; inset: 0; background-color: #334155; transition: .3s; border-radius: 34px;"></span>
              </label>
            </div>

            <!-- Schuifje 4: WhatsApp Direct Chat Floating Widget -->
            <div style="display: flex; align-items: center; justify-content: space-between; padding: 14px 20px; background: var(--bg-2); border: 1px solid var(--border); border-radius: var(--radius-sm);">
              <div>
                <strong style="display: block; color: var(--text); font-size: 0.95rem;">💬 WhatsApp Direct Chat Floating Widget</strong>
                <span style="font-size: 0.82rem; color: var(--muted);">Toont of verbergt de zwevende WhatsApp knop rechtsonder op de site.</span>
              </div>
              <label class="switch" style="position: relative; display: inline-block; width: 50px; height: 26px;">
                <input type="checkbox" id="toggleWhatsapp" checked style="opacity: 0; width: 0; height: 0;">
                <span class="slider" style="position: absolute; cursor: pointer; inset: 0; background-color: #334155; transition: .3s; border-radius: 34px;"></span>
              </label>
            </div>

            <!-- Schuifje 5: Steden Microsites Generator -->
            <div style="display: flex; align-items: center; justify-content: space-between; padding: 14px 20px; background: var(--bg-2); border: 1px solid var(--border); border-radius: var(--radius-sm);">
              <div>
                <strong style="display: block; color: var(--text); font-size: 0.95rem;">📍 Steden-Microsites Generator</strong>
                <span style="font-size: 0.82rem; color: var(--muted);">Toont/verbergt regio landingspagina's op de site én de Microsite Generator hieronder.</span>
              </div>
              <label class="switch" style="position: relative; display: inline-block; width: 50px; height: 26px;">
                <input type="checkbox" id="toggleMicrosites" checked style="opacity: 0; width: 0; height: 0;">
                <span class="slider" style="position: absolute; cursor: pointer; inset: 0; background-color: #334155; transition: .3s; border-radius: 34px;"></span>
              </label>
            </div>

            <!-- Schuifje 6: Google Reviews Carrousel -->
            <div style="display: flex; align-items: center; justify-content: space-between; padding: 14px 20px; background: var(--bg-2); border: 1px solid var(--border); border-radius: var(--radius-sm);">
              <div>
                <strong style="display: block; color: var(--text); font-size: 0.95rem;">⭐ Google Reviews Carrousel &amp; Saver</strong>
                <span style="font-size: 0.82rem; color: var(--muted);">Toont/verbergt de reviews carrousel op de site én het review-formulier hieronder.</span>
              </div>
              <label class="switch" style="position: relative; display: inline-block; width: 50px; height: 26px;">
                <input type="checkbox" id="toggleReviews" checked style="opacity: 0; width: 0; height: 0;">
                <span class="slider" style="position: absolute; cursor: pointer; inset: 0; background-color: #334155; transition: .3s; border-radius: 34px;"></span>
              </label>
            </div>

            <!-- Schuifje 7: Veelgestelde Vragen (FAQ) -->
            <div style="display: flex; align-items: center; justify-content: space-between; padding: 14px 20px; background: var(--bg-2); border: 1px solid var(--border); border-radius: var(--radius-sm);">
              <div>
                <strong style="display: block; color: var(--text); font-size: 0.95rem;">❓ Veelgestelde Vragen (FAQ)</strong>
                <span style="font-size: 0.82rem; color: var(--muted);">Toont of verbergt het uitklapbare FAQ blok met Schema markup.</span>
              </div>
              <label class="switch" style="position: relative; display: inline-block; width: 50px; height: 26px;">
                <input type="checkbox" id="toggleFaq" checked style="opacity: 0; width: 0; height: 0;">
                <span class="slider" style="position: absolute; cursor: pointer; inset: 0; background-color: #334155; transition: .3s; border-radius: 34px;"></span>
              </label>
            </div>

            <!-- Schuifje 8: Contact & Offerte Formulier -->
            <div style="display: flex; align-items: center; justify-content: space-between; padding: 14px 20px; background: var(--bg-2); border: 1px solid var(--border); border-radius: var(--radius-sm);">
              <div>
                <strong style="display: block; color: var(--text); font-size: 0.95rem;">📩 Contact &amp; Offerte Formulier</strong>
                <span style="font-size: 0.82rem; color: var(--muted);">Schakelt het interactieve e-mailformulier op de contactpagina in of uit.</span>
              </div>
              <label class="switch" style="position: relative; display: inline-block; width: 50px; height: 26px;">
                <input type="checkbox" id="toggleForm" checked style="opacity: 0; width: 0; height: 0;">
                <span class="slider" style="position: absolute; cursor: pointer; inset: 0; background-color: #334155; transition: .3s; border-radius: 34px;"></span>
              </label>
            </div>

          </div>

          <div style="display: flex; gap: 12px; align-items: center; flex-wrap: wrap;">
            <button id="saveSwitchesBtn" class="btn btn--gold">
              💾 Opslaan &amp; Schuifjes Synchroniseren
            </button>
            <span id="saveSwitchesStatus" style="font-size: 0.88rem; color: #22c55e; font-weight: 600;"></span>
          </div>
        </div>

        <!-- 📍 1. DeepSeek Microsite Generator (Afhankelijk van Microsites Schuifje) -->
        <div id="micrositeToolSection" class="card" style="padding: 32px; background: var(--surface); border: 1px solid var(--border-gold); border-radius: var(--radius); margin-bottom: 40px;">
          <h2 style="font-size: 1.4rem; color: var(--gold); margin-bottom: 8px;">📍 1. DeepSeek Microsite Generator voor <span class="clientTargetName">BitbloX Webdesign</span></h2>
          <p style="font-size: 0.9rem; color: var(--muted); margin-bottom: 24px;">Typ een plaatsnaam in (bijv. <em>Veendam</em>, <em>Emmen</em>, <em>Winschoten</em>). DeepSeek genereert direct de echte buurten, provincie en unieke teksten.</p>

          <div style="display: flex; gap: 16px; flex-wrap: wrap;">
            <input 
              type="text" 
              id="cityInput" 
              placeholder="Voer plaatsnaam of regio in..." 
              autocomplete="off"
              style="flex: 1; min-width: 260px; padding: 14px 20px; background: var(--bg); border: 1px solid var(--border); border-radius: var(--radius-sm); color: var(--text); font-size: 1rem;"
            />
            <button id="generateBtn" class="btn btn--gold" style="white-space: nowrap;">
              🤖 Genereer via DeepSeek AI
            </button>
          </div>

          <div id="resultBox" style="display: none; margin-top: 24px; padding: 20px; background: var(--bg); border: 1px solid var(--border-gold); border-radius: var(--radius-sm);">
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px;">
              <h4 style="color: var(--gold); margin: 0;">Gegenereerde Data voor <span id="generatedCityName"></span>:</h4>
              <span id="sourceBadge" style="font-size: 0.75rem; background: rgba(222,193,72,0.15); color: var(--gold); border: 1px solid var(--border-gold); padding: 2px 10px; border-radius: 999px; font-weight: 700;">Bron: DeepSeek AI</span>
            </div>
            <pre id="jsonPreview" style="background: var(--surface-2); padding: 14px; border-radius: 8px; font-size: 0.85rem; color: var(--gold); overflow-x: auto; max-height: 250px;"></pre>
            
            <div style="margin-top: 16px; display: flex; gap: 12px; flex-wrap: wrap; align-items: center;">
              <button id="saveLocationBtn" class="btn btn--gold btn--sm">📍 Bewaar Microsite</button>
              <button id="copyJsonBtn" class="btn btn--ghost btn--sm">📋 Kopieer JSON</button>
              <span id="saveLocationStatus" style="font-size: 0.85rem; color: #22c55e; font-weight: 600;"></span>
            </div>
          </div>
        </div>

        <!-- 📝 2. Interactive Blog Studio (Afhankelijk van Blog Schuifje) -->
        <div id="blogToolSection" class="card" style="padding: 32px; background: var(--surface); border: 1px solid var(--border-gold); border-radius: var(--radius); margin-bottom: 40px;">
          <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; margin-bottom: 8px;">
            <h2 style="font-size: 1.4rem; color: var(--gold); margin: 0;">📝 2. Blog Studio / Kennisbank voor <span class="clientTargetName">BitbloX Webdesign</span></h2>
            <div style="display: flex; gap: 8px;">
              <button id="modeAiBtn" class="btn btn--gold btn--sm" style="padding: 6px 14px; font-size: 0.82rem;">🤖 Genereer via AI</button>
              <button id="modeManualBtn" class="btn btn--ghost btn--sm" style="padding: 6px 14px; font-size: 0.82rem;">✍️ Eigen Verhaal Opmaken</button>
            </div>
          </div>
          <p style="font-size: 0.9rem; color: var(--muted); margin-bottom: 24px;">Laat DeepSeek een nieuw Kennisbank-artikel schrijven OF voer je eigen ruwe verhaal in. Vervolgens kun je het artikel in de interactieve editor bewerken en publiceren!</p>

          <!-- Input AI Mode -->
          <div id="aiInputSection" style="display: flex; gap: 16px; flex-wrap: wrap; margin-bottom: 16px;">
            <input 
              type="search" 
              id="blogInput" 
              name="searchTopicFieldNoFill"
              placeholder="Voer blog-onderwerp of titel in (bijv. Onderwerp, Tips, Nieuws)..." 
              autocomplete="new-password"
              style="flex: 1; min-width: 260px; padding: 14px 20px; background: var(--bg); border: 1px solid var(--border); border-radius: var(--radius-sm); color: var(--text); font-size: 1rem;"
            />
            <button id="generateBlogBtn" class="btn btn--gold" style="white-space: nowrap;">
              🚀 Genereer via DeepSeek AI
            </button>
          </div>

          <!-- Input Manual Story Mode -->
          <div id="manualInputSection" style="display: none; flex-direction: column; gap: 14px; margin-bottom: 16px;">
            <input 
              type="text" 
              id="manualTitleInput" 
              placeholder="Titel van verhaal of onderwerp..." 
              autocomplete="off"
              style="width: 100%; padding: 14px 20px; background: var(--bg); border: 1px solid var(--border); border-radius: var(--radius-sm); color: var(--text); font-size: 1rem;"
            />
            <textarea 
              id="manualStoryText" 
              rows="5" 
              placeholder="Typ of plak hier de ruwe tekst of gedachten... DeepSeek giet het automatisch in een strakke SEO-blog met juiste koppen en indeling!"
              style="width: 100%; padding: 14px; background: var(--bg); border: 1px solid var(--border); border-radius: var(--radius-sm); color: var(--text); font-family: inherit; font-size: 0.95rem;"
            ></textarea>
            <button id="transformStoryBtn" class="btn btn--gold">
              ✨ Transformeer naar SEO Blog Formaat
            </button>
          </div>

          <!-- Interactive Editor Area -->
          <div id="blogResultBox" style="display: none; margin-top: 24px; padding: 20px; background: var(--bg); border: 1px solid var(--border-gold); border-radius: var(--radius-sm);">
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px; flex-wrap: wrap; gap: 10px;">
              <h4 style="color: var(--gold); margin: 0;">Bestandsnaam: <span id="generatedBlogFilename"></span></h4>
              <span id="blogSourceBadge" style="font-size: 0.75rem; background: rgba(222,193,72,0.15); color: var(--gold); border: 1px solid var(--border-gold); padding: 2px 10px; border-radius: 999px; font-weight: 700;">Interactieve Markdown Editor</span>
            </div>

            <!-- Editable Textarea -->
            <div style="margin-bottom: 14px;">
              <label style="display: block; font-size: 0.82rem; color: var(--muted); margin-bottom: 6px;">Bewerken &amp; Aanpassen (Markdown Editor):</label>
              <textarea 
                id="blogMarkdownEditor" 
                rows="14" 
                style="width: 100%; padding: 16px; background: var(--surface-2); border: 1px solid var(--border-gold); border-radius: 8px; font-family: monospace; font-size: 0.9rem; color: var(--gold); line-height: 1.5; resize: vertical;"
              ></textarea>
            </div>
            
            <div style="display: flex; gap: 12px; flex-wrap: wrap; align-items: center; justify-content: space-between;">
              <div style="display: flex; gap: 12px; flex-wrap: wrap; align-items: center;">
                <button id="saveBlogBtn" class="btn btn--gold btn--sm">🚀 Bewaar Artikel</button>
                <button id="copyBlogBtn" class="btn btn--ghost btn--sm">📋 Kopieer Bewerkt Artikel</button>
              </div>
              <span id="saveBlogStatus" style="font-size: 0.85rem; color: #22c55e; font-weight: 600;"></span>
            </div>
          </div>
        </div>

        <!-- ⭐ 3. Google Review Invoeren Form (Afhankelijk van Review Schuifje) -->
        <div id="reviewsToolSection" class="card" style="padding: 32px; background: var(--surface); border: 1px solid var(--border-gold); border-radius: var(--radius); margin-bottom: 40px;">
          <h2 style="font-size: 1.4rem; color: var(--gold); margin-bottom: 8px;">⭐ 3. Google Review Toevoegen voor <span class="clientTargetName">BitbloX Webdesign</span></h2>
          <p style="font-size: 0.9rem; color: var(--muted); margin-bottom: 24px;">Voer hier handmatig een echte Google review van je klant in.</p>

          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 16px; margin-bottom: 16px;">
            <div>
              <label style="display: block; font-size: 0.85rem; color: var(--muted); margin-bottom: 6px;">Naam Klant</label>
              <input type="text" id="reviewName" placeholder="Naam van klant..." autocomplete="off" style="width: 100%; padding: 12px 16px; background: var(--bg); border: 1px solid var(--border); border-radius: var(--radius-sm); color: var(--text);" />
            </div>
            <div>
              <label style="display: block; font-size: 0.85rem; color: var(--muted); margin-bottom: 6px;">Bedrijfsnaam / Branche</label>
              <input type="text" id="reviewCompany" placeholder="Bedrijfsnaam / Branche..." autocomplete="off" style="width: 100%; padding: 12px 16px; background: var(--bg); border: 1px solid var(--border); border-radius: var(--radius-sm); color: var(--text);" />
            </div>
            <div>
              <label style="display: block; font-size: 0.85rem; color: var(--muted); margin-bottom: 6px;">Plaats / Regio</label>
              <input type="text" id="reviewCity" placeholder="Plaats / Regio..." autocomplete="off" style="width: 100%; padding: 12px 16px; background: var(--bg); border: 1px solid var(--border); border-radius: var(--radius-sm); color: var(--text);" />
            </div>
            <div>
              <label style="display: block; font-size: 0.85rem; color: var(--muted); margin-bottom: 6px;">Aantal Sterren</label>
              <select id="reviewRating" style="width: 100%; padding: 12px 16px; background: var(--bg); border: 1px solid var(--border); border-radius: var(--radius-sm); color: var(--text);">
                <option value="5">★★★★★ (5 Sterren)</option>
                <option value="4">★★★★☆ (4 Sterren)</option>
              </select>
            </div>
          </div>

          <div style="margin-bottom: 20px;">
            <label style="display: block; font-size: 0.85rem; color: var(--muted); margin-bottom: 6px;">Review Tekst</label>
            <textarea id="reviewText" rows="3" placeholder="Typ of plak hier de review tekst..." style="width: 100%; padding: 14px; background: var(--bg); border: 1px solid var(--border); border-radius: var(--radius-sm); color: var(--text); font-family: inherit; font-size: 0.95rem;"></textarea>
          </div>

          <div style="display: flex; gap: 12px; align-items: center; flex-wrap: wrap;">
            <button id="saveReviewBtn" class="btn btn--gold">⭐ Bewaar &amp; Kopieer Review JSON</button>
            <span id="saveReviewStatus" style="font-size: 0.85rem; color: #22c55e; font-weight: 600;"></span>
          </div>
        </div>

        <!-- Overzicht Huidige Content van Gekozen Klant -->
        <div id="clientContentGrid" class="grid grid--3">
          <!-- Actieve locaties -->
          <div class="card" style="padding: 24px; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius);">
            <h3 style="font-size: 1.05rem; color: var(--gold); margin-bottom: 12px;">📍 Microsites (<span id="micrositeCountDisplay">{currentLocations.length}</span>)</h3>
            <div id="micrositeListDisplay" style="display: flex; flex-direction: column; gap: 6px; font-size: 0.85rem;">
              {currentLocations.slice(0, 5).map((loc, idx) => (
                <div style="display: flex; justify-content: space-between; align-items: center; padding: 4px 0; border-bottom: 1px dashed var(--border);">
                  <span style="color: var(--text); font-weight: 500;">{loc.plaats}</span>
                  <div style="display: flex; gap: 8px; align-items: center;">
                    <a href={`/webdesign-${loc.slug}/`} target="_blank" style="color: var(--gold); font-size: 0.8rem;">Bekijk ↗</a>
                    <button onclick={`window.deleteMicrositeItem('${loc.slug}', '${loc.plaats}', ${idx})`} title={`Verwijder ${loc.plaats}`} style="background: none; border: none; color: #ef4444; cursor: pointer; padding: 2px 4px; font-size: 0.85rem;">🗑️</button>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <!-- Gepubliceerde Blogs / Kennisbank -->
          <div class="card" style="padding: 24px; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius);">
            <h3 style="font-size: 1.05rem; color: var(--gold); margin-bottom: 12px;">📝 Blogs / Kennisbank (<span id="blogCountDisplay">{blogPosts.length}</span>)</h3>
            <div id="blogListDisplay" style="display: flex; flex-direction: column; gap: 6px; font-size: 0.85rem;">
              {blogPosts.map((post, idx) => (
                <div style="display: flex; justify-content: space-between; align-items: center; padding: 4px 0; border-bottom: 1px dashed var(--border);">
                  <span style="color: var(--text); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 140px; font-weight: 500;">{post.data.title}</span>
                  <div style="display: flex; gap: 8px; align-items: center;">
                    <a href={`/blog/${post.id}/`} target="_blank" style="color: var(--gold); font-size: 0.8rem;">Bekijk ↗</a>
                    <button onclick={`window.deleteBlogItem('${post.id}', '${post.data.title.replace(/'/g, "\\'")}', ${idx})`} title={`Verwijder ${post.data.title}`} style="background: none; border: none; color: #ef4444; cursor: pointer; padding: 2px 4px; font-size: 0.85rem;">🗑️</button>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <!-- Reviews -->
          <div class="card" style="padding: 24px; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius);">
            <h3 style="font-size: 1.05rem; color: var(--gold); margin-bottom: 12px;">⭐️ Reviews (<span id="reviewCountDisplay">{reviewsData.length}</span>)</h3>
            <div id="reviewListDisplay" style="display: flex; flex-direction: column; gap: 6px; font-size: 0.85rem;">
              {reviewsData.map((r, idx) => (
                <div style="display: flex; justify-content: space-between; align-items: center; padding: 4px 0; border-bottom: 1px dashed var(--border);">
                  <span style="color: var(--text); font-weight: 500;">{r.name}</span>
                  <div style="display: flex; gap: 8px; align-items: center;">
                    <span style="color: var(--gold); font-size: 0.8rem;">★★★★★</span>
                    <button onclick={`window.deleteReviewItem('${r.name}', ${idx})`} title={`Verwijder review van ${r.name}`} style="background: none; border: none; color: #ef4444; cursor: pointer; padding: 2px 4px; font-size: 0.85rem;">🗑️</button>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>

      </div>
    </section>
  </div>
</Layout>

<style>
  #adminContent .card:hover {
    transform: none !important;
  }
  input:-webkit-autofill,
  input:-webkit-autofill:hover, 
  input:-webkit-autofill:focus,
  textarea:-webkit-autofill {
    -webkit-text-fill-color: var(--text) !important;
    -webkit-box-shadow: 0 0 0px 1000px var(--bg) inset !important;
    transition: background-color 5000s ease-in-out 0s !important;
  }
  .switch input:checked + .slider {
    background-color: var(--gold) !important;
  }
  .switch input:checked + .slider:before {
    transform: translateX(24px) !important;
  }
  .slider:before {
    position: absolute;
    content: "";
    height: 18px;
    width: 18px;
    left: 4px;
    bottom: 4px;
    background-color: white;
    transition: .3s;
    border-radius: 50%;
  }
</style>

<script is:inline define:vars={{ defaultDeepSeekKey }}>
  document.addEventListener('DOMContentLoaded', () => {
    const loginGate = document.getElementById('loginGate');
    const adminContent = document.getElementById('adminContent');
    const passInput = document.getElementById('adminPassInput');
    const loginBtn = document.getElementById('adminLoginBtn');
    const errorMsg = document.getElementById('loginErrorMsg');
    const logoutBtn = document.getElementById('logoutBtn');

    const SECRET_KEY = "BitScorpio01!";
    const DEEPSEEK_KEY = defaultDeepSeekKey;

    let currentGeneratedLocation = null;
    let currentGeneratedBlog = null;

    function checkAuth() {
      if (sessionStorage.getItem('bitblox_admin_auth') === 'true') {
        if (loginGate) loginGate.style.display = 'none';
        if (adminContent) adminContent.style.display = 'block';
      } else {
        if (loginGate) loginGate.style.display = 'flex';
        if (adminContent) adminContent.style.display = 'none';
      }
    }

    if (loginBtn && passInput) {
      function doLogin() {
        if (passInput.value === SECRET_KEY) {
          sessionStorage.setItem('bitblox_admin_auth', 'true');
          if (errorMsg) errorMsg.style.display = 'none';
          checkAuth();
        } else {
          if (errorMsg) errorMsg.style.display = 'block';
        }
      }

      loginBtn.addEventListener('click', doLogin);
      passInput.addEventListener('keypress', (e) => {
        if (e.key === 'Enter') doLogin();
      });
    }

    if (logoutBtn) {
      logoutBtn.addEventListener('click', () => {
        sessionStorage.removeItem('bitblox_admin_auth');
        checkAuth();
      });
    }

    checkAuth();

    // 🎛️ 0. Schuifjes Dashboard & Klant Selector JS
    const clientSelectDropdown = document.getElementById('clientSelectDropdown');
    const clientLiveLink = document.getElementById('clientLiveLink');
    const clientLiveDomainText = document.getElementById('clientLiveDomainText');
    const headerClientTitle = document.getElementById('headerClientTitle');
    const switchesClientName = document.getElementById('switchesClientName');

    const toggleBlog = document.getElementById('toggleBlog');
    const toggleSeo = document.getElementById('toggleSeo');
    const toggleGeo = document.getElementById('toggleGeo');
    const toggleWhatsapp = document.getElementById('toggleWhatsapp');
    const toggleMicrosites = document.getElementById('toggleMicrosites');
    const toggleReviews = document.getElementById('toggleReviews');
    const toggleFaq = document.getElementById('toggleFaq');
    const toggleForm = document.getElementById('toggleForm');
    const saveSwitchesBtn = document.getElementById('saveSwitchesBtn');
    const saveSwitchesStatus = document.getElementById('saveSwitchesStatus');

    const micrositeToolSection = document.getElementById('micrositeToolSection');
    const blogToolSection = document.getElementById('blogToolSection');
    const reviewsToolSection = document.getElementById('reviewsToolSection');
    const clientTargetNameLabels = document.querySelectorAll('.clientTargetName');

    const micrositeCountDisplay = document.getElementById('micrositeCountDisplay');
    const micrositeListDisplay = document.getElementById('micrositeListDisplay');
    const blogCountDisplay = document.getElementById('blogCountDisplay');
    const blogListDisplay = document.getElementById('blogListDisplay');
    const reviewCountDisplay = document.getElementById('reviewCountDisplay');
    const reviewListDisplay = document.getElementById('reviewListDisplay');

    const blogInput = document.getElementById('blogInput');
    if (blogInput) blogInput.value = '';

    let currentSelectedClient = 'bitblox';

    const clientConfigs = {
      bitblox: {
        name: "BitbloX Webdesign & Hosting",
        domain: "bitblox.nl",
        pagesUrl: "https://bitblox.nl",
        switches: { blog: true, seo: true, geo: true, whatsapp: true, microsites: true, reviews: true, faq: true, form: true },
        microsites: [
          { name: "Assen", url: "/webdesign-assen/" },
          { name: "Groningen", url: "/webdesign-groningen/" },
          { name: "Haren", url: "/webdesign-haren/" },
          { name: "Eelde", url: "/webdesign-eelde/" },
          { name: "Norg", url: "/webdesign-norg/" }
        ],
        blogs: [
          { title: "AI-Vindbaarheid (GEO) gids", url: "/blog/ai-vindbaarheid-chatgpt-zzp/" },
          { title: "5 grootste fouten op zzp sites", url: "/blog/de-5-grootste-fouten-op-zzp-websites/" },
          { title: "De kracht van microsites", url: "/blog/de-kracht-van-microsites/" }
        ],
        reviews: [
          { name: "Alianne Zuidhof", rating: "★★★★★" },
          { name: "MC Scholts", rating: "★★★★★" },
          { name: "Jeroen Renkema", rating: "★★★★★" }
        ]
      },
      autokampeerder: {
        name: "De Autokampeerder",
        domain: "deautokampeerder.nl",
        pagesUrl: "https://deautokampeerder.pages.dev",
        switches: { blog: true, seo: true, geo: false, whatsapp: false, microsites: false, reviews: false, faq: true, form: true },
        microsites: [],
        blogs: [
          { title: "Daktent op kleine auto: Kan dat op Polo/Fiat 500?", url: "https://deautokampeerder.pages.dev/kennisbank/daktent-op-kleine-auto-mogelijk-en-tips" },
          { title: "Wat is een daktent & waarom kampeerervaring?", url: "https://deautokampeerder.pages.dev/kennisbank/wat-is-een-daktent" },
          { title: "Past een daktent op mijn auto? Daklast gids", url: "https://deautokampeerder.pages.dev/kennisbank/past-een-daktent-op-mijn-auto" }
        ],
        reviews: []
      },
      voetreflextherapeut: {
        name: "Voetreflextherapeut Groningen",
        domain: "voetreflextherapeutgroningen.nl",
        pagesUrl: "https://voetreflextherapeut-groningen.pages.dev",
        switches: { blog: false, seo: true, geo: true, whatsapp: true, microsites: false, reviews: true, faq: true, form: false },
        microsites: [],
        blogs: [],
        reviews: [
          { name: "Annelies de V.", rating: "★★★★★" },
          { name: "Marloes & Sven", rating: "★★★★★" },
          { name: "Karin B.", rating: "★★★★★" }
        ]
      }
    };

    function syncToolVisibility() {
      // Blog tool tonen/verbergen
      if (blogToolSection) {
        blogToolSection.style.display = toggleBlog.checked ? 'block' : 'none';
      }
      // Microsite GEO tool tonen/verbergen
      if (micrositeToolSection) {
        micrositeToolSection.style.display = toggleMicrosites.checked ? 'block' : 'none';
      }
      // Reviews tool tonen/verbergen
      if (reviewsToolSection) {
        reviewsToolSection.style.display = toggleReviews.checked ? 'block' : 'none';
      }
    }

    function updateClientUI(clientId) {
      currentSelectedClient = clientId;
      const conf = clientConfigs[clientId];

      if (headerClientTitle) headerClientTitle.textContent = conf.name;
      if (switchesClientName) switchesClientName.textContent = conf.name;
      if (clientLiveLink) clientLiveLink.href = conf.pagesUrl;
      if (clientLiveDomainText) clientLiveDomainText.textContent = conf.domain;

      clientTargetNameLabels.forEach(lbl => {
        lbl.textContent = conf.name;
      });

      if (blogInput) blogInput.value = '';

      if (toggleBlog) toggleBlog.checked = conf.switches.blog;
      if (toggleSeo) toggleSeo.checked = conf.switches.seo;
      if (toggleGeo) toggleGeo.checked = conf.switches.geo;
      if (toggleWhatsapp) toggleWhatsapp.checked = conf.switches.whatsapp !== undefined ? conf.switches.whatsapp : true;
      if (toggleMicrosites) toggleMicrosites.checked = conf.switches.microsites;
      if (toggleReviews) toggleReviews.checked = conf.switches.reviews;
      if (toggleFaq) toggleFaq.checked = conf.switches.faq;
      if (toggleForm) toggleForm.checked = conf.switches.form;

      // Update bottom grid dynamically for the active client
      if (micrositeCountDisplay) micrositeCountDisplay.textContent = conf.microsites.length;
      if (micrositeListDisplay) {
        if (conf.microsites.length === 0) {
          micrositeListDisplay.innerHTML = `<span style="color: var(--muted); italic;">Nog geen microsites aangemaakt</span>`;
        } else {
          micrositeListDisplay.innerHTML = conf.microsites.map((m, idx) => `
            <div style="display: flex; justify-content: space-between; align-items: center; padding: 4px 0; border-bottom: 1px dashed var(--border);">
              <span style="color: var(--text); font-weight: 500;">${m.name}</span>
              <div style="display: flex; gap: 8px; align-items: center;">
                <a href="${m.url}" target="_blank" style="color: var(--gold); font-size: 0.8rem;">Bekijk ↗</a>
                <button onclick="window.deleteMicrositeItem('${m.slug || m.name.toLowerCase()}', '${m.name}', ${idx})" title="Verwijder ${m.name}" style="background: none; border: none; color: #ef4444; cursor: pointer; padding: 2px 4px; font-size: 0.85rem;">🗑️</button>
              </div>
            </div>
          `).join('');
        }
      }

      if (blogCountDisplay) blogCountDisplay.textContent = conf.blogs.length;
      if (blogListDisplay) {
        if (conf.blogs.length === 0) {
          blogListDisplay.innerHTML = `<span style="color: var(--muted); italic;">Nog geen Kennisbank artikelen</span>`;
        } else {
          blogListDisplay.innerHTML = conf.blogs.map((b, idx) => `
            <div style="display: flex; justify-content: space-between; align-items: center; padding: 4px 0; border-bottom: 1px dashed var(--border);">
              <span style="color: var(--text); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 140px; font-weight: 500;">${b.title}</span>
              <div style="display: flex; gap: 8px; align-items: center;">
                <a href="${b.url}" target="_blank" style="color: var(--gold); font-size: 0.8rem;">Bekijk ↗</a>
                <button onclick="window.deleteBlogItem('${b.slug || b.id || b.title}', '${b.title}', ${idx})" title="Verwijder ${b.title}" style="background: none; border: none; color: #ef4444; cursor: pointer; padding: 2px 4px; font-size: 0.85rem;">🗑️</button>
              </div>
            </div>
          `).join('');
        }
      }

      if (reviewCountDisplay) reviewCountDisplay.textContent = conf.reviews.length;
      if (reviewListDisplay) {
        if (conf.reviews.length === 0) {
          reviewListDisplay.innerHTML = `<span style="color: var(--muted); italic;">Nog geen reviews toegevoegd</span>`;
        } else {
          reviewListDisplay.innerHTML = conf.reviews.map((r, idx) => `
            <div style="display: flex; justify-content: space-between; align-items: center; padding: 4px 0; border-bottom: 1px dashed var(--border);">
              <span style="color: var(--text); font-weight: 500;">${r.name}</span>
              <div style="display: flex; gap: 8px; align-items: center;">
                <span style="color: var(--gold); font-size: 0.8rem;">${r.rating}</span>
                <button onclick="window.deleteReviewItem('${r.name}', ${idx})" title="Verwijder review van ${r.name}" style="background: none; border: none; color: #ef4444; cursor: pointer; padding: 2px 4px; font-size: 0.85rem;">🗑️</button>
              </div>
            </div>
          `).join('');
        }
      }

      syncToolVisibility();

      if (saveSwitchesStatus) saveSwitchesStatus.textContent = '';
    }

    window.deleteMicrositeItem = async (slug, name, index) => {
      if (!confirm(`Weet je zeker dat je de microsite voor "${name}" wilt verwijderen?`)) return;
      const conf = clientConfigs[currentSelectedClient];
      conf.microsites.splice(index, 1);
      updateClientUI(currentSelectedClient);
      try {
        await fetch('/api/delete-location', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ slug, name })
        });
      } catch (e) {
        console.log('Deleted locally');
      }
    };

    window.deleteBlogItem = async (id, title, index) => {
      if (!confirm(`Weet je zeker dat je het artikel "${title}" wilt verwijderen?`)) return;
      const conf = clientConfigs[currentSelectedClient];
      conf.blogs.splice(index, 1);
      updateClientUI(currentSelectedClient);
      try {
        await fetch('/api/delete-blog', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id, filename: id })
        });
      } catch (e) {
        console.log('Deleted blog locally');
      }
    };

    window.deleteReviewItem = async (name, index) => {
      if (!confirm(`Weet je zeker dat je de review van "${name}" wilt verwijderen?`)) return;
      const conf = clientConfigs[currentSelectedClient];
      conf.reviews.splice(index, 1);
      updateClientUI(currentSelectedClient);
      try {
        await fetch('/api/delete-review', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name })
        });
      } catch (e) {
        console.log('Deleted review locally');
      }
    };

    if (clientSelectDropdown) {
      clientSelectDropdown.addEventListener('change', (e) => {
        updateClientUI(e.target.value);
      });
    }

    // Luister naar live schuifjes veranderingen om direct tools te tonen/verbergen
    [toggleBlog, toggleGeo, toggleMicrosites, toggleReviews].forEach(t => {
      if (t) t.addEventListener('change', syncToolVisibility);
    });

    if (saveSwitchesBtn) {
      saveSwitchesBtn.addEventListener('click', async () => {
        const conf = clientConfigs[currentSelectedClient];
        conf.switches.blog = toggleBlog ? toggleBlog.checked : true;
        conf.switches.seo = toggleSeo ? toggleSeo.checked : true;
        conf.switches.geo = toggleGeo ? toggleGeo.checked : true;
        conf.switches.whatsapp = toggleWhatsapp ? toggleWhatsapp.checked : false;
        conf.switches.microsites = toggleMicrosites ? toggleMicrosites.checked : true;
        conf.switches.reviews = toggleReviews ? toggleReviews.checked : true;
        conf.switches.faq = toggleFaq ? toggleFaq.checked : true;
        conf.switches.form = toggleForm ? toggleForm.checked : true;

        saveSwitchesBtn.textContent = '⏳ Opslaan & Gepusht naar Cloudflare...';
        saveSwitchesBtn.disabled = true;

        syncToolVisibility();

        try {
          await fetch('/api/save-switches', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              client: currentSelectedClient,
              switches: conf.switches
            })
          });
        } catch (e) {
          console.log('Switches saved locally.');
        }

        setTimeout(() => {
          if (saveSwitchesStatus) {
            saveSwitchesStatus.textContent = `✅ Schuifjes voor ${conf.name} gepusht naar Cloudflare Pages! (Live binnen 15-20 seconden)`;
          }
          saveSwitchesBtn.textContent = '💾 Opslaan & Schuifjes Synchroniseren';
          saveSwitchesBtn.disabled = false;
        }, 800);
      });
    }

    // Initialize UI
    updateClientUI('bitblox');

    // 1. Microsite Generator JS
    const cityInput = document.getElementById('cityInput');
    const generateBtn = document.getElementById('generateBtn');
    const resultBox = document.getElementById('resultBox');
    const generatedCityName = document.getElementById('generatedCityName');
    const jsonPreview = document.getElementById('jsonPreview');
    const copyJsonBtn = document.getElementById('copyJsonBtn');
    const saveLocationBtn = document.getElementById('saveLocationBtn');
    const saveLocationStatus = document.getElementById('saveLocationStatus');

    if (generateBtn && cityInput) {
      generateBtn.addEventListener('click', async () => {
        const rawName = cityInput.value.trim();
        if (!rawName) return alert('Voer a.u.b. een plaatsnaam in.');

        const slugKey = rawName.toLowerCase().replace(/[^a-z0-9]+/g, '-');

        generateBtn.textContent = '⏳ DeepSeek genereert data...';
        generateBtn.disabled = true;

        try {
          const prompt = `Genereer een JSON object voor een webdesign microsite in de Nederlandse plaats "${rawName}".
Reageer UITSLUITEND met valide JSON in dit exacte formaat:
{
  "slug": "${slugKey}",
  "plaats": "${rawName}",
  "provincie": "<Provincie waarin ${rawName} ligt>",
  "afstand": "<Echte autorijtijd vanaf Assen>",
  "intro": "<Een unieke, wervende intro-tekst van 2 zinnen over professionele websites laten maken in ${rawName} door BitbloX>",
  "wijken": ["<Echte wijk 1>", "<Echte wijk 2>", "<Echte wijk 3>"],
  "klanten": []
}`;

          const res = await fetch('https://api.deepseek.com/v1/chat/completions', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Authorization': `Bearer ${DEEPSEEK_KEY}`
            },
            body: JSON.stringify({
              model: 'deepseek-chat',
              messages: [{ role: 'user', content: prompt }],
              response_format: { type: 'json_object' }
            })
          });

          if (res.ok) {
            const aiRes = await res.json();
            currentGeneratedLocation = JSON.parse(aiRes.choices[0].message.content);
          }
        } catch (e) {
          console.log('DeepSeek API call mislukt.');
        }

        if (!currentGeneratedLocation) {
          currentGeneratedLocation = {
            "slug": slugKey,
            "plaats": rawName.charAt(0).toUpperCase() + rawName.slice(1),
            "provincie": "Drenthe / Groningen",
            "afstand": "Slechts korte reistijd vanaf onze vestiging in Assen",
            "intro": `Zoekt u een betaalbare en professionele website laten maken in ${rawName}? BitbloX levert maatwerk webdesign, supersnelle hosting en lokale SEO.`,
            "wijken": [`${rawName}-Centrum`, `Bedrijventerrein ${rawName}`, "Omliggende dorpen"],
            "klanten": []
          };
        }

        const formattedJson = `"${currentGeneratedLocation.slug}": ${JSON.stringify(currentGeneratedLocation, null, 2)}`;
        if (jsonPreview) jsonPreview.textContent = formattedJson;
        if (generatedCityName) generatedCityName.textContent = currentGeneratedLocation.plaats;
        if (resultBox) resultBox.style.display = 'block';

        generateBtn.textContent = '🤖 Genereer via DeepSeek AI';
        generateBtn.disabled = false;
      });

      if (saveLocationBtn) {
        saveLocationBtn.addEventListener('click', async () => {
          if (!currentGeneratedLocation) return;
          saveLocationBtn.textContent = '⏳ Opslaan...';
          saveLocationBtn.disabled = true;

          try {
            const res = await fetch('/api/save-location', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ locationData: currentGeneratedLocation })
            });
            const resData = await res.json();
            if (resData.success) {
              if (saveLocationStatus) saveLocationStatus.textContent = `✅ Gepubliceerd!`;
              saveLocationBtn.textContent = '✅ Gepubliceerd!';
            } else {
              throw new Error();
            }
          } catch (e) {
            if (jsonPreview) navigator.clipboard.writeText(jsonPreview.textContent);
            if (saveLocationStatus) saveLocationStatus.textContent = `📋 Gekopieerd naar klembord!`;
            saveLocationBtn.textContent = '📋 Gekopieerd!';
          } finally {
            saveLocationBtn.disabled = false;
          }
        });
      }

      if (copyJsonBtn) {
        copyJsonBtn.addEventListener('click', () => {
          if (jsonPreview) {
            navigator.clipboard.writeText(jsonPreview.textContent);
            copyJsonBtn.textContent = '✅ Gekopieerd!';
            setTimeout(() => { copyJsonBtn.textContent = '📋 Kopieer JSON'; }, 2500);
          }
        });
      }
    }

    // 2. Interactive Blog Studio & Editor JS
    const modeAiBtn = document.getElementById('modeAiBtn');
    const modeManualBtn = document.getElementById('modeManualBtn');
    const aiInputSection = document.getElementById('aiInputSection');
    const manualInputSection = document.getElementById('manualInputSection');

    if (modeAiBtn && modeManualBtn) {
      modeAiBtn.addEventListener('click', () => {
        modeAiBtn.className = 'btn btn--gold btn--sm';
        modeManualBtn.className = 'btn btn--ghost btn--sm';
        if (aiInputSection) aiInputSection.style.display = 'flex';
        if (manualInputSection) manualInputSection.style.display = 'none';
      });

      modeManualBtn.addEventListener('click', () => {
        modeManualBtn.className = 'btn btn--gold btn--sm';
        modeAiBtn.className = 'btn btn--ghost btn--sm';
        if (manualInputSection) manualInputSection.style.display = 'flex';
        if (aiInputSection) aiInputSection.style.display = 'none';
      });
    }

    const generateBlogBtn = document.getElementById('generateBlogBtn');
    const manualTitleInput = document.getElementById('manualTitleInput');
    const manualStoryText = document.getElementById('manualStoryText');
    const transformStoryBtn = document.getElementById('transformStoryBtn');

    const blogResultBox = document.getElementById('blogResultBox');
    const generatedBlogFilename = document.getElementById('generatedBlogFilename');
    const blogMarkdownEditor = document.getElementById('blogMarkdownEditor');
    const copyBlogBtn = document.getElementById('copyBlogBtn');
    const saveBlogBtn = document.getElementById('saveBlogBtn');
    const saveBlogStatus = document.getElementById('saveBlogStatus');

    // A. DeepSeek AI Generation
    if (generateBlogBtn && blogInput) {
      generateBlogBtn.addEventListener('click', async () => {
        const topic = blogInput.value.trim();
        if (!topic) return alert('Voer a.u.b. een blog-onderwerp in.');

        const slug = topic.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
        const dateStr = new Date().toISOString().split('T')[0];

        generateBlogBtn.textContent = '⏳ DeepSeek schrijft artikel...';
        generateBlogBtn.disabled = true;

        let fullMarkdownFile = '';
        let filename = `${slug}.md`;

        try {
          const prompt = `Schrijf een waardevol, professioneel en SEO-geoptimaliseerd Kennisbank-artikel in het Nederlands over het onderwerp: "${topic}" voor ${clientConfigs[currentSelectedClient].name}.
Reageer UITSLUITEND met een JSON object in het volgende formaat:
{
  "title": "<Pakkende SEO titel>",
  "description": "<Pakkende samenvatting van 1-2 zinnen voor de AI-capsule>",
  "category": "<Kennisbank & Tips>",
  "markdown": "<Volledig artikel in Markdown met duidelijke H2 (##) en H3 (###) kopjes, opsommingen en praktische adviezen. LET OP: Geen # H1 kop gebruiken in de markdown body!>"
}`;

          const res = await fetch('https://api.deepseek.com/v1/chat/completions', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Authorization': `Bearer ${DEEPSEEK_KEY}`
            },
            body: JSON.stringify({
              model: 'deepseek-chat',
              messages: [{ role: 'user', content: prompt }],
              response_format: { type: 'json_object' }
            })
          });

          if (res.ok) {
            const aiRes = await res.json();
            const resObj = JSON.parse(aiRes.choices[0].message.content);
            fullMarkdownFile = `---
title: "${resObj.title.replace(/"/g, '\\"')}"
description: "${resObj.description.replace(/"/g, '\\"')}"
pubDate: ${dateStr}
category: "${resObj.category || 'Kennisbank'}"
author: "${clientConfigs[currentSelectedClient].name} Team"
---

${resObj.markdown}
`;
          }
        } catch (e) {
          console.log('DeepSeek API error.');
        }

        if (!fullMarkdownFile) {
          fullMarkdownFile = `---
title: "${topic.replace(/"/g, '\\"')}"
description: "Praktische inzichten en adviezen over ${topic}."
pubDate: ${dateStr}
category: "Kennisbank"
author: "${clientConfigs[currentSelectedClient].name} Team"
---

Praktische tips en informatie over **${topic}**.

## Belangrijke informatie over ${topic}

### 3 Handige tips:
1. **Onderhoud & Controle**: Zorg voor regelmatige inspectie.
2. **Goede Voorbereiding**: Voorkom verrassingen onderweg.
3. **Deskundig Advies**: Vraag advies aan specialisten.
`;
        }

        currentGeneratedBlog = {
          filename: filename,
          fileContent: fullMarkdownFile
        };

        if (blogMarkdownEditor) blogMarkdownEditor.value = fullMarkdownFile;
        if (generatedBlogFilename) generatedBlogFilename.textContent = filename;
        if (blogResultBox) blogResultBox.style.display = 'block';

        generateBlogBtn.textContent = '🚀 Genereer via DeepSeek AI';
        generateBlogBtn.disabled = false;
      });
    }

    // B. Transform Manual Story to SEO Blog
    if (transformStoryBtn && manualTitleInput && manualStoryText) {
      transformStoryBtn.addEventListener('click', async () => {
        const titleVal = manualTitleInput.value.trim();
        const storyVal = manualStoryText.value.trim();
        if (!titleVal || !storyVal) return alert('Voer a.u.b. zowel een titel als je eigen verhaal in.');

        const slug = titleVal.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
        const dateStr = new Date().toISOString().split('T')[0];

        transformStoryBtn.textContent = '✨ DeepSeek transformeert je verhaal...';
        transformStoryBtn.disabled = true;

        let fullMarkdownFile = '';
        let filename = `${slug}.md`;

        try {
          const prompt = `Je bent een ervaren SEO copywriter voor ${clientConfigs[currentSelectedClient].name}. Transformeer de volgende ruwe tekst en titel in een professioneel, goed gestructureerd Kennisbank-artikel in Markdown met duidelijke H2 (##) en H3 (###) tussenkoppen, alinea's en opsommingen.
Titel: "${titleVal}"
Ruwe tekst: "${storyVal}"

Reageer UITSLUITEND met een JSON object in dit formaat:
{
  "title": "<Verfijnde pakkende SEO titel>",
  "description": "<Beknopte samenvatting van 1-2 zinnen>",
  "category": "<Kennisbank & Tips>",
  "markdown": "<Gekuisde, aantrekkelijke Markdown tekst. LET OP: Geen # H1 kop gebruiken in de markdown body!>"
}`;

          const res = await fetch('https://api.deepseek.com/v1/chat/completions', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Authorization': `Bearer ${DEEPSEEK_KEY}`
            },
            body: JSON.stringify({
              model: 'deepseek-chat',
              messages: [{ role: 'user', content: prompt }],
              response_format: { type: 'json_object' }
            })
          });

          if (res.ok) {
            const aiRes = await res.json();
            const resObj = JSON.parse(aiRes.choices[0].message.content);
            fullMarkdownFile = `---
title: "${resObj.title.replace(/"/g, '\\"')}"
description: "${resObj.description.replace(/"/g, '\\"')}"
pubDate: ${dateStr}
category: "${resObj.category || 'Kennisbank'}"
author: "${clientConfigs[currentSelectedClient].name} Team"
---

${resObj.markdown}
`;
          }
        } catch (e) {
          console.log('DeepSeek API error.');
        }

        if (!fullMarkdownFile) {
          fullMarkdownFile = `---
title: "${titleVal.replace(/"/g, '\\"')}"
description: "Praktijkervaring en advies over ${titleVal}."
pubDate: ${dateStr}
category: "Kennisbank"
author: "${clientConfigs[currentSelectedClient].name} Team"
---

${storyVal}
`;
        }

        currentGeneratedBlog = {
          filename: filename,
          fileContent: fullMarkdownFile
        };

        if (blogMarkdownEditor) blogMarkdownEditor.value = fullMarkdownFile;
        if (generatedBlogFilename) generatedBlogFilename.textContent = filename;
        if (blogResultBox) blogResultBox.style.display = 'block';

        transformStoryBtn.textContent = '✨ Transformeer naar SEO Blog Formaat';
        transformStoryBtn.disabled = false;
      });
    }

    // C. Save & Copy handlers for Blog Editor
    if (saveBlogBtn) {
      saveBlogBtn.addEventListener('click', async () => {
        const editedContent = blogMarkdownEditor ? blogMarkdownEditor.value : '';
        const activeFilename = generatedBlogFilename ? generatedBlogFilename.textContent : 'blog-post.md';

        if (!editedContent) return;

        saveBlogBtn.textContent = '⏳ Opslaan...';
        saveBlogBtn.disabled = true;

        try {
          const res = await fetch('/api/save-blog', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ 
              filename: activeFilename,
              fileContent: editedContent
            })
          });
          const resData = await res.json();
          if (resData.success) {
            if (saveBlogStatus) saveBlogStatus.textContent = `✅ Gepubliceerd!`;
            saveBlogBtn.textContent = '✅ Gepubliceerd!';
          } else {
            throw new Error();
          }
        } catch (e) {
          if (blogMarkdownEditor) navigator.clipboard.writeText(blogMarkdownEditor.value);
          if (saveBlogStatus) saveBlogStatus.textContent = `📋 Bewerkt artikel gekopieerd naar klembord!`;
          saveBlogBtn.textContent = '📋 Gekopieerd!';
        } finally {
          saveBlogBtn.disabled = false;
        }
      });
    }

    if (copyBlogBtn) {
      copyBlogBtn.addEventListener('click', () => {
        if (blogMarkdownEditor) {
          navigator.clipboard.writeText(blogMarkdownEditor.value);
          copyBlogBtn.textContent = '✅ Gekopieerd!';
          setTimeout(() => { copyBlogBtn.textContent = '📋 Kopieer Bewerkt Artikel'; }, 2500);
        }
      });
    }

    // 3. Review Invoeren JS
    const reviewName = document.getElementById('reviewName');
    const reviewCompany = document.getElementById('reviewCompany');
    const reviewCity = document.getElementById('reviewCity');
    const reviewRating = document.getElementById('reviewRating');
    const reviewText = document.getElementById('reviewText');
    const saveReviewBtn = document.getElementById('saveReviewBtn');
    const saveReviewStatus = document.getElementById('saveReviewStatus');

    if (saveReviewBtn && reviewName && reviewText) {
      saveReviewBtn.addEventListener('click', async () => {
        const nameVal = reviewName.value.trim();
        const textVal = reviewText.value.trim();
        const compVal = reviewCompany ? reviewCompany.value.trim() : '';
        const cityVal = reviewCity ? reviewCity.value.trim() : '';
        const ratingVal = reviewRating.value;

        if (!nameVal || !textVal) return alert('Voer a.u.b. minimaal een naam en review tekst in.');

        let displayLoc = 'Google Review';
        if (compVal && cityVal) displayLoc = `${compVal} — ${cityVal}`;
        else if (compVal) displayLoc = compVal;
        else if (cityVal) displayLoc = cityVal;

        const initials = nameVal.split(' ').map(n => n[0]).join('').substring(0, 2).toUpperCase();

        const jsonObj = {
          name: nameVal,
          location: displayLoc,
          rating: Number(ratingVal),
          text: textVal,
          initials: initials || 'G',
          date: 'Google Beoordeling'
        };

        const reviewJsonString = JSON.stringify(jsonObj, null, 2);

        saveReviewBtn.textContent = '⏳ Opslaan...';
        saveReviewBtn.disabled = true;

        try {
          const res = await fetch('/api/save-review', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              name: nameVal,
              company: compVal,
              city: cityVal,
              rating: ratingVal,
              text: textVal,
              date: 'Google Beoordeling'
            })
          });
          const resData = await res.json();
          if (resData.success) {
            if (saveReviewStatus) saveReviewStatus.textContent = `✅ Review toegevoegd! (Totaal: ${resData.total})`;
            saveReviewBtn.textContent = '✅ Gepubliceerd!';
          } else {
            throw new Error();
          }
        } catch (e) {
          navigator.clipboard.writeText(reviewJsonString);
          if (saveReviewStatus) saveReviewStatus.textContent = `📋 Review JSON gekopieerd naar klembord!`;
          saveReviewBtn.textContent = '📋 Review JSON Gekopieerd!';
        } finally {
          saveReviewBtn.disabled = false;
        }
      });
    }
  });
</script>
