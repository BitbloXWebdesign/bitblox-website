---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm.astro';
import switches from '../data/switches.json';
---

<Layout 
  title="Contact — BitbloX Webdesign & Hosting Assen"
  description="Neem vrijblijvend contact op met BitbloX voor een gratis consult of scherpe offerte voor webdesign, hosting en SEO."
>
  <section class="page-hero">
    <div class="hero-grid-bg"></div>
    <div class="container page-hero-inner">
      <nav class="breadcrumb" aria-label="Kruimelpad"><a href="/">Home</a> <span>/</span> <span>Contact</span></nav>
      <span class="kicker">Neem contact op</span>
      <h1>Laten we samen uw <span class="text-gradient">online doelen bereiken</span></h1>
      <p class="lead">Heeft u vragen of wilt u direct een offerte aanvragen? Neem direct telefonisch, via WhatsApp of per e-mail contact op.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="contact-page-grid">
        <div class="card contact-info-card" style="padding: 32px; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius);">
          <h3 style="margin-bottom: 20px;">Contactgegevens</h3>
          <ul style="display: flex; flex-direction: column; gap: 16px; font-size: 0.95rem;">
            <li style="display: flex; gap: 12px; align-items: center;">
              <span style="color: var(--gold); font-size: 1.2rem;">📞</span>
              <div>
                <strong>Telefoon:</strong><br />
                <a href="tel:+31630523907" style="color: var(--gold);">06 30523907</a>
              </div>
            </li>
            <li style="display: flex; gap: 12px; align-items: center;">
              <span style="color: var(--gold); font-size: 1.2rem;">💬</span>
              <div>
                <strong>WhatsApp:</strong><br />
                <a href="https://wa.me/31630523907" target="_blank" style="color: #4ade80;">Direct chatten →</a>
              </div>
            </li>
            <li style="display: flex; gap: 12px; align-items: center;">
              <span style="color: var(--gold); font-size: 1.2rem;">✉️</span>
              <div>
                <strong>E-mail:</strong><br />
                <a href="mailto:info@bitblox.nl" style="color: var(--gold);">info@bitblox.nl</a>
              </div>
            </li>
            <li style="display: flex; gap: 12px; align-items: center;">
              <span style="color: var(--gold); font-size: 1.2rem;">📍</span>
              <div>
                <strong>Locatie:</strong><br />
                <span>Assen, Drenthe</span>
              </div>
            </li>
            <li style="display: flex; gap: 12px; align-items: center;">
              <span style="color: var(--gold); font-size: 1.2rem;">🏛️</span>
              <div>
                <strong>KVK:</strong><br />
                <span>74001922</span>
              </div>
            </li>
          </ul>
        </div>

        {switches.form ? (
          <ContactForm />
        ) : (
          <div class="card" style="padding: 40px; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); text-align: center;">
            <span style="font-size: 2.5rem; display: block; margin-bottom: 12px;">📞</span>
            <h3 style="font-size: 1.4rem; margin-bottom: 12px;">Direct contact opnemen</h3>
            <p style="color: var(--muted); margin-bottom: 24px; max-width: 440px; margin-left: auto; margin-right: auto;">
              Bel ons direct of stuur een bericht via WhatsApp of e-mail voor een snelle reactie binnen 2 uur.
            </p>
            <div style="display: flex; gap: 16px; justify-content: center; flex-wrap: wrap;">
              <a href="tel:+31630523907" class="btn btn--gold">Bel 06 30523907</a>
              <a href="https://wa.me/31630523907" class="btn btn--ghost" target="_blank" style="background: rgba(37,211,102,0.15); border-color: rgba(37,211,102,0.4); color: #4ade80;">WhatsApp ons</a>
            </div>
          </div>
        )}

        {switches.maps !== false && (
          <div style="grid-column: 1 / -1; margin-top: 20px;">
            <div class="card" style="padding: 10px; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden;">
              <div style="display: flex; justify-content: space-between; align-items: center; padding: 6px 10px 10px; border-bottom: 1px solid var(--border); margin-bottom: 10px;">
                <span style="font-size: 0.88rem; color: #fff; font-weight: 600; display: flex; align-items: center; gap: 6px;">
                  🗺️ Werkgebied &amp; Kantoor Assen
                </span>
                <a href="https://www.google.com/maps/dir/?api=1&destination=Assen,+Drenthe" target="_blank" rel="noopener noreferrer" style="font-size: 0.78rem; color: var(--gold); text-decoration: none;">
                  Routebeschrijving ↗
                </a>
              </div>
              <iframe
                title="Google Maps BitbloX Webdesign Assen"
                src="https://maps.google.com/maps?q=Assen%2C%20Drenthe&t=&z=12&ie=UTF8&iwloc=&output=embed"
                width="100%"
                height="320"
                style="border:0; border-radius: 6px; display: block;"
                allowfullscreen=""
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
              ></iframe>
            </div>
          </div>
        )}
      </div>
    </div>
  </section>
</Layout>

<style>
  .contact-page-grid {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 48px;
    align-items: start;
  }

  @media (max-width: 900px) {
    .contact-page-grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }
    .contact-info-card {
      padding: 24px 20px !important;
    }
  }
</style>
