---
import Layout from '../layouts/Layout.astro';
import GoogleReviews from '../components/GoogleReviews.astro';
import FAQ from '../components/FAQ.astro';
import switches from '../data/switches.json';
import SpeedChecker from '../components/SpeedChecker.astro';
import { getCollection } from 'astro:content';

const latestPosts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const clients = [
  "yogaplanet.nl", "studiobm.nl", "massagestudioeelde.nl", "shemotion.nl", 
  "naturewise.nu", "samenpositiefgezond.nl", "stoftastisch.nl", "timmerbedrijflouwes.nl",
  "voetreflextherapeutgroningen.nl", "wodansfoodtruck.nl", "fdrb.nl", "tuinstaalnoord.nl", "meulemanbeton.nl"
];

const featuredCases = [
  {
    name: "Massage Studio Eelde",
    domain: "massagestudioeelde.nl",
    location: "Eelde / Paterswolde",
    branch: "Wellness & Massage",
    summary: "Complete behandelingen showcase, directe online afspraak-koppeling, bel-me-terug optie en supersnel mobiel contact."
  },
  {
    name: "Voetreflextherapeut Groningen",
    domain: "voetreflextherapeutgroningen.nl",
    location: "Groningen",
    branch: "Therapie & Gezondheid",
    summary: "Informatieve behandelpagina's, Google Reviews showcase en een rustgevend, overzichtelijk en razendsnel design."
  },
  {
    name: "Tuinstaal Noord",
    domain: "tuinstaalnoord.nl",
    location: "Noord-Nederland",
    branch: "Maatwerk Staal & Tuin",
    summary: "Strakke visuele catalogus, directe WhatsApp advies-knop en bliksemsnelle mobiele laadtijden op ons cloud netwerk."
  }
];

// 1. Geavanceerde LocalBusiness & ProfessionalService Schema met Wikipedia SameAs Entiteiten & KVK
const homeSchema = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "name": "BitbloX",
  "url": "https://bitblox.nl",
  "logo": "https://bitblox.nl/assets/img/logo.png",
  "image": "https://bitblox.nl/assets/img/logo.png",
  "description": "Full-service webdesign- en hostingbureau in Assen en Groningen. Supersnelle, betrouwbare websites bouwen en laten maken, logo design, SEO en AI-vindbaarheid voor ZZP & MKB.",
  "telephone": "+31630523907",
  "email": "info@bitblox.nl",
  "vatID": "74001922",
  "identifier": "KVK 74001922",
  "sameAs": [
    "https://nl.wikipedia.org/wiki/Assen",
    "https://nl.wikipedia.org/wiki/Groningen_(stad)",
    "https://www.google.com/maps/place/BitbloX/@53.3530384,1.4664348,6z/data=!4m8!3m7!1s0x47c82594e0d10389:0x37ab4f8928e27729!8m2!3d53.4627724!4d6.7394122!9m1!1b1!16s%2Fg%2F11ll43b4s2"
  ],
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Assen",
    "addressRegion": "Drenthe",
    "addressCountry": "NL"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 52.9925,
    "longitude": 6.5642
  },
  "areaServed": ["Assen", "Groningen", "Haren", "Beilen", "Eelde", "Norg", "Hoogeveen", "Meppel", "Drenthe"],
  "priceRange": "€€"
};
---

<Layout 
  title="Website Laten Maken Assen | Webdesign Assen — BitbloX" 
  description="Professionele website laten maken in Assen? BitbloX levert betaalbaar webdesign op maat (Brons €100, Zilver €250, Goud €450), supersnelle cloud hosting en lokale SEO voor ZZP & MKB in Assen en Drenthe."
  schema={homeSchema}
>
  <!-- ============ Hero ============ -->
  <section class="hero">
    <div class="hero-grid-bg"></div>
    <div class="container hero-inner">
      <div>
        <span class="hero-badge"><span class="dot"></span> Webdesign &amp; Hosting — gevestigd in Assen</span>
        <h1>Website laten maken &amp; webdesign in <span class="text-gradient">Assen</span></h1>
        <p class="lead">BitbloX is uw lokale specialist voor een professionele website laten maken in Assen en omstreken. Moderne, converterende websites op maat voor ZZP &amp; MKB. Volledig ontzorgd: van webdesign en cloud hosting tot lokale SEO en beheer.</p>

        <p class="answer-capsule">
          Op zoek naar een professionele <strong><a href="/webdesign-assen/" style="color: var(--gold); text-decoration: underline; text-underline-offset: 4px;">website laten maken in Assen</a></strong>? <strong>BitbloX</strong> is uw all-in-one webdesignbureau voor zzp'ers en het mkb in <strong>Assen</strong> en Noord-Nederland. Maatwerk webdesign vanaf <strong>€100 eenmalig</strong>, inclusief snelle cloud hosting, SSL, Google SEO en lokale vindbaarheid.
        </p>
        <div class="hero-actions">
          <a href="/contact/" class="btn btn--gold">
            Plan een gratis telefonisch adviesgesprek
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a href="/diensten/" class="btn btn--ghost">Bekijk onze diensten</a>
        </div>
      </div>

      <div class="hero-visual" aria-hidden="true">
        <div class="hero-glow"></div>
        <div class="hero-orbit"></div>
        <div class="cube-scene">
          <div class="cube">
            <div class="cube-face"></div>
            <div class="cube-face"></div>
            <div class="cube-face"></div>
            <div class="cube-face"></div>
            <div class="cube-face"></div>
            <div class="cube-face"></div>
          </div>
        </div>
        <div class="float-chip float-chip--1">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"/></svg>
          Het BitbloX Cloud Netwerk (Edge)
        </div>
        <div class="float-chip float-chip--2">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          Gratis SSL-certificaat
        </div>
        <div class="float-chip float-chip--3">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
          SEO &amp; GEO (AI) geoptimaliseerd
        </div>
      </div>
    </div>

    <!-- ============ Volle-Breedte Glassmorphism Trust Bar ============ -->
    <div class="container hero-stats-container">
      <div class="hero-glass-bar reveal">
        <div class="glass-stat">
          <div class="glass-stat-num" data-count="30" data-suffix="+">30+</div>
          <div class="glass-stat-label">Tevreden klanten</div>
        </div>
        <div class="glass-stat">
          <div class="glass-stat-num">&lt; 0,3s</div>
          <div class="glass-stat-label">Laadsnelheid (Edge)</div>
        </div>
        <div class="glass-stat">
          <div class="glass-stat-num">98-100</div>
          <div class="glass-stat-label">Google PageSpeed</div>
        </div>
        <div class="glass-stat">
          <div class="glass-stat-num">5 Dagen</div>
          <div class="glass-stat-label">Gemiddelde oplevering</div>
        </div>
        <div class="glass-stat">
          <div class="glass-stat-num">1-op-1</div>
          <div class="glass-stat-label">Vast aanspreekpunt</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ Klanten marquee ============ -->
  <div class="marquee-strip" aria-label="Portfolio van BitbloX klanten in Drenthe en Groningen">
    <div class="marquee-track">
      {[...clients, ...clients].map((domain) => (
        <span>{domain}</span>
      ))}
    </div>
  </div>

  <!-- ============ Lokale Cases Showcase ============ -->
  <section class="section section--alt" id="cases">
    <div class="container">
      <div class="section-head reveal">
        <span class="kicker">Lokale Referenties &amp; E-E-A-T</span>
        <h2>Echte projecten voor ondernemers in <span class="gold">Assen &amp; Regio</span></h2>
        <p class="lead">Geen anonieme voorbeelden, maar echte websites voor lokale zzp'ers en mkb-bedrijven in Drenthe en Groningen.</p>
      </div>

      <div class="grid grid--3">
        {featuredCases.map((c) => (
          <article class="card reveal" style="display: flex; flex-direction: column; justify-content: space-between; border: 1px solid var(--border); padding: 28px; background: var(--surface); border-radius: var(--radius-sm);">
            <div>
              <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 12px; flex-wrap: wrap; gap: 8px;">
                <span style="font-size: 12px; font-weight: 700; color: var(--gold); text-transform: uppercase; letter-spacing: 0.08em; background: rgba(222, 193, 72, 0.1); padding: 4px 10px; border-radius: 4px; border: 1px solid var(--border-gold);">{c.branch}</span>
                <span style="font-size: 13px; color: var(--muted); display: inline-flex; align-items: center; gap: 4px;">📍 {c.location}</span>
              </div>
              <h3 style="font-size: 1.25rem; margin-bottom: 10px; color: var(--text);">{c.name}</h3>
              <p style="color: var(--muted); font-size: 0.92rem; line-height: 1.6; margin-bottom: 20px;">{c.summary}</p>
            </div>
            <a href={`https://${c.domain}`} target="_blank" rel="noopener" class="card-link" style="margin-top: auto; font-weight: 600; display: inline-flex; align-items: center; gap: 8px; color: var(--gold);">
              Bekijk website ({c.domain})
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16"><path d="M7 17 17 7M7 7h10v10"/></svg>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ Gratis Website Prestatie & Snelheid Check ============ -->
  <SpeedChecker />

  <!-- ============ Diensten overzicht ============ -->
  <section class="section" id="diensten">
    <div class="container">
      <div class="section-head reveal">
        <span class="kicker">Onze diensten in Assen &amp; Drenthe</span>
        <h2>Alles voor uw online succes, <span class="gold">onder één dak</span></h2>
        <p class="lead">Van het eerste ontwerp tot hosting, vindbaarheid en beveiliging — één aanspreekpunt voor uw complete online aanwezigheid.</p>
      </div>

      <div class="grid grid--3">
        <article class="card reveal">
          <div class="card-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
          </div>
          <h3>Webdesign</h3>
          <p>Webdesign dat indruk maakt en resultaten levert. Een nieuwe website bouwen of laten maken — modern, op maat en met de nieuwste technieken.</p>
          <a href="/diensten/#webdesign" class="card-link">Meer over webdesign <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
        </article>

        <article class="card reveal reveal-delay-1">
          <div class="card-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="8" rx="2"/><rect x="2" y="14" width="20" height="8" rx="2"/><path d="M6 6h.01M6 18h.01"/></svg>
          </div>
          <h3>Cloud Hosting</h3>
          <p>Moderne cloud-infrastructuur met slimme caching, gratis SSL en 24/7 monitoring, ontworpen voor maximale stabiliteit en snelheid zonder trage databases of kwetsbare plugins.</p>
          <a href="/diensten/#hosting" class="card-link">Meer over hosting <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
        </article>

        <article class="card reveal reveal-delay-2">
          <div class="card-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19l7-7 3 3-7 7-3-3z"/><path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"/><path d="M2 2l7.586 7.586"/><circle cx="11" cy="11" r="2"/></svg>
          </div>
          <h3>Logo Design</h3>
          <p>Creatieve logo's die uw merkidentiteit versterken en onvergetelijk maken. Ontwerp volgens afspraak, met oog voor uw branche.</p>
          <a href="/diensten/#logo-design" class="card-link">Meer over logo design <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
        </article>

        <article class="card reveal">
          <div class="card-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/></svg>
          </div>
          <h3>SEO (Vindbaarheid)</h3>
          <p>Van grondig zoekwoordenonderzoek tot technische SEO-optimalisatie, content en gestructureerde Schema.org data voor optimale lokale zichtbaarheid in Assen, Groningen en Drenthe.</p>
          <a href="/diensten/#seo" class="card-link">Meer over SEO <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
        </article>

        <article class="card reveal reveal-delay-1">
          <div class="card-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
          </div>
          <h3>24/7 Beveiliging</h3>
          <p>Veilig online, zorgeloos ondernemen. Actieve firewall, enterprise DDoS-bescherming en continue uptime-bewaking houden uw website en gegevens veilig.</p>
          <a href="/diensten/#beveiliging" class="card-link">Meer over beveiliging <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
        </article>

        <article class="card reveal reveal-delay-2">
          <div class="card-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a7 7 0 0 1 7 7c0 2.4-1.2 3.9-2.3 5.1-.9 1-1.7 1.7-1.7 2.9v1H9v-1c0-1.2-.8-1.9-1.7-2.9C6.2 12.9 5 11.4 5 9a7 7 0 0 1 7-7z"/><path d="M9 21h6"/></svg>
          </div>
          <h3>AI-Vindbaarheid (GEO)</h3>
          <p>Gestructureerde Schema.org data en /llms.txt zodat AI-systemen (zoals ChatGPT, Perplexity en Google AI) uw bedrijf nauwkeurig begrijpen en als betrouwbare bron meenemen.</p>
          <a href="/ai-vindbaarheid/" class="card-link">Meer over AI-vindbaarheid <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
        </article>
      </div>
    </div>
  </section>

  <!-- ============ Google Reviews Component ============ -->
  {switches.reviews && <GoogleReviews />}

  <!-- ============ Werkwijze ============ -->
  <section class="section" id="werkwijze">
    <div class="container">
      <div class="section-head reveal">
        <span class="kicker">Onze werkwijze</span>
        <h2>In vier stappen naar een website <span class="gold">die werkt</span></h2>
        <p class="lead">Een helder en efficiënt proces — van eerste analyse tot doorlopende groei en onderhoud.</p>
      </div>

      <div class="steps">
        <div class="step reveal">
          <div class="step-num">1</div>
          <h3>Strategie &amp; Ontwerp</h3>
          <p>We analyseren uw doelen, doelgroep en concurrentie. Vervolgens maken we een wireframe en een visueel ontwerp dat past bij uw merk.</p>
        </div>
        <div class="step reveal reveal-delay-1">
          <div class="step-num">2</div>
          <h3>Ontwikkeling &amp; SEO</h3>
          <p>We bouwen de website met moderne technologieën, optimaliseren voor snelheid en implementeren SEO-best practices, inclusief lokale zoekoptimalisatie.</p>
        </div>
        <div class="step reveal reveal-delay-2">
          <div class="step-num">3</div>
          <h3>Testen &amp; Lancering</h3>
          <p>U krijgt een testomgeving om feedback te geven. Na goedkeuring lanceren we de website op onze beveiligde hosting.</p>
        </div>
        <div class="step reveal reveal-delay-3">
          <div class="step-num">4</div>
          <h3>Groei &amp; Onderhoud</h3>
          <p>Na lancering monitoren we de prestaties, voeren we SEO-updates uit en bieden we doorlopend onderhoud. Uw website blijft veilig, snel en up-to-date.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ FAQ Section ============ -->
  {switches.faq && <FAQ title="Veelgestelde vragen over BitbloX Webdesign in Assen" />}

  <!-- ============ Laatste Inzichten & Kennisbank ============ -->
  <section class="section" id="kennisbank">
    <div class="container">
      <div class="section-head reveal" style="display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 16px;">
        <div>
          <span class="kicker">Kennis &amp; SEO Inzichten</span>
          <h2>Laatste artikelen uit onze <span class="gold">Kennisbank</span></h2>
          <p class="lead">Praktische tips over AI-vindbaarheid, websitestrategie en conversie voor ondernemers.</p>
        </div>
        <a href="/blog/" class="btn btn--ghost btn--sm" style="margin-bottom: 8px;">Bekijk alle artikelen &rarr;</a>
      </div>

      <div class="grid grid--3">
        {latestPosts.map((post) => (
          <article class="card reveal" style="display: flex; flex-direction: column; justify-content: space-between; padding: 26px; border: 1px solid var(--border); background: var(--surface); border-radius: var(--radius-sm);">
            <div>
              <div style="display: flex; gap: 6px; margin-bottom: 12px; flex-wrap: wrap;">
                {post.data.tags?.slice(0, 2).map((tag: string) => (
                  <span style="font-size: 0.72rem; font-weight: 700; text-transform: uppercase; color: var(--gold); background: rgba(222,193,72,0.1); padding: 3px 8px; border-radius: 4px; border: 1px solid var(--border-gold);">
                    {tag}
                  </span>
                ))}
              </div>
              <h3 style="font-size: 1.18rem; margin-bottom: 10px; line-height: 1.4;">
                <a href={`/blog/${post.id}/`} style="color: var(--text); text-decoration: none;">{post.data.title}</a>
              </h3>
              <p style="color: var(--muted); font-size: 0.88rem; line-height: 1.6; margin-bottom: 18px;">
                {post.data.description}
              </p>
            </div>
            <a href={`/blog/${post.id}/`} class="card-link" style="color: var(--gold); font-size: 0.88rem; font-weight: 600; display: inline-flex; align-items: center; gap: 6px; margin-top: auto;">
              Lees artikel &rarr;
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ CTA Band ============ -->
  <section class="section--tight">
    <div class="container">
      <div class="cta-band reveal">
        <span class="kicker">Vrijblijvend advies</span>
        <h2>Maak indruk met een uniek en <span class="text-gradient">professioneel webdesign</span></h2>
        <p>Neem vandaag nog contact op voor een gratis telefonisch adviesgesprek en ontdek hoe wij uw website razendsnel, vindbaar en professioneel maken. Gewoon laagdrempelig en zonder verplichtingen!</p>
        <div class="btn-row">
          <a href="/contact/" class="btn btn--gold">Neem contact op
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a href="/prijzen/" class="btn btn--ghost">Bekijk de prijzen</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
