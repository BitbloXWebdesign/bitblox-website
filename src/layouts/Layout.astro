---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import AnnouncementBar from '../components/AnnouncementBar.astro';
import AccessibilityWidget from '../components/AccessibilityWidget.astro';
import CallBackWidget from '../components/CallBackWidget.astro';
import switches from '../data/switches.json';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  schema?: object;
  hideHeaderFooter?: boolean;
}

const {
  title = "BitbloX — Webdesign, Hosting, SEO, Logo Design & Beveiliging",
  description = "Full-service webdesign- en hostingbureau in Assen en Groningen. Supersnelle, betrouwbare websites, logo design, SEO en AI-vindbaarheid voor ZZP & MKB.",
  canonical,
  schema,
  hideHeaderFooter = false
} = Astro.props;

const canonicalURL = canonical || Astro.url.href;
---

<!DOCTYPE html>
<html lang="nl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />

  <!-- Open Graph / Social -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={new URL('/assets/img/logo.png', Astro.url)} />

  <!-- Fonts & Preload -->
  <link rel="preload" href="/assets/fonts/inter.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/assets/fonts/spacegrotesk.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="stylesheet" href="/assets/fonts/inter.css" />
  <link rel="stylesheet" href="/assets/fonts/sg.css" />
  <link rel="stylesheet" href="/assets/css/style.css" />
  <link rel="icon" type="image/png" href="/assets/img/favicon.png" />

  <!-- JSON-LD Structured Data (Google & AI) -->
  {schema && (
    Array.isArray(schema) ? (
      schema.map((s) => (
        <script type="application/ld+json" set:html={JSON.stringify(s)} />
      ))
    ) : (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    )
  )}
</head>
<body class={(!hideHeaderFooter && switches.announcement) ? "has-announcement-bar" : ""}>
  {!hideHeaderFooter && switches.announcement && <AnnouncementBar />}
  {!hideHeaderFooter && <Header />}
  
  <main id="main-content">
    <slot />
  </main>

  {!hideHeaderFooter && <Footer />}

  {!hideHeaderFooter && (switches.whatsapp || switches.callback) && (
    <div class="floating-actions-dock">
      {switches.whatsapp && (
        <a
          href="https://wa.me/31630523907?text=Hallo%20BitbloX,%20ik%20heb%20een%20vraag%20over%20een%20website."
          class="whatsapp-float"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Direct WhatsApp Contact"
        >
          <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor">
            <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.312.045-.634.077-1.782-.397-1.467-.607-2.39-2.115-2.464-2.213-.073-.099-.582-.774-.582-1.478 0-.703.366-1.049.497-1.192.131-.144.288-.179.385-.179.096 0 .192 0 .274.005.087.005.203-.033.318.243.119.288.405.99.441 1.063.036.073.06.159.012.256-.048.097-.072.159-.144.244-.072.085-.152.19-.217.256-.072.072-.148.151-.064.296.084.144.373.615.8 1.002.551.498 1.015.653 1.159.725.144.073.228.06.312-.036.085-.097.362-.423.46-.568.097-.145.193-.121.325-.073.133.048.84.397.985.47.144.073.24.108.277.169.036.06.036.349-.108.754z"/>
            <path d="M12 2C6.477 2 2 6.477 2 12c0 1.891.524 3.66 1.434 5.176L2 22l4.954-1.399C8.409 21.494 10.15 22 12 22c5.523 0 10-4.477 10-10S17.523 2 12 2zm0 18c-1.636 0-3.165-.487-4.453-1.325l-.319-.208-2.935.829.837-2.86-.226-.339C4.015 14.779 3.5 13.434 3.5 12c0-4.687 3.813-8.5 8.5-8.5s8.5 3.813 8.5 8.5-3.813 8.5-8.5 8.5z"/>
          </svg>
          <span class="whatsapp-badge">WhatsApp</span>
        </a>
      )}

      {switches.callback && (
        <CallBackWidget phoneDisplay="06 30523907" whatsappNumber="31630523907" clientName="BitbloX" />
      )}
    </div>
  )}

  {!hideHeaderFooter && switches.accessibility && (
    <AccessibilityWidget />
  )}

  {!hideHeaderFooter && switches.cookies && (
    <CookieBanner />
  )}

  <style is:global>
    :root {
      --announcement-height: 40px;
    }
    body.has-announcement-bar .site-header {
      top: var(--announcement-height, 40px) !important;
    }
    body.has-announcement-bar .main-nav {
      top: var(--announcement-height, 40px) !important;
    }
    body.has-announcement-bar {
      padding-top: var(--announcement-height, 40px) !important;
    }

    .floating-actions-dock {
      position: fixed;
      bottom: 24px;
      right: 24px;
      display: flex;
      flex-direction: row-reverse;
      align-items: center;
      gap: 12px;
      z-index: 9990;
      pointer-events: none;
    }
    .floating-actions-dock > * {
      pointer-events: auto;
      position: static !important;
    }
    @media (max-width: 768px) {
      body.has-announcement-bar .site-header {
        top: var(--announcement-height, 44px) !important;
      }
      body.has-announcement-bar .main-nav {
        top: 0 !important;
      }
      body.has-announcement-bar {
        padding-top: var(--announcement-height, 44px) !important;
      }
      .floating-actions-dock {
        flex-direction: column-reverse;
        bottom: 20px;
        right: 20px;
        gap: 10px;
        align-items: flex-end;
      }
    }
  </style>

  <script is:inline src="/assets/js/main.js"></script>
</body>
</html>
