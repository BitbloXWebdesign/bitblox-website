---
import switches from '../data/switches.json';

interface Props {
  text?: string;
  badge?: string;
  link?: string;
  linkText?: string;
}

const {
  text = (switches as any).announcementText || "🚀 Nieuwe AI-Vindbaarheid (GEO) modules nu live voor ZZP & MKB websites!",
  badge = (switches as any).announcementBadge || "UPDATE",
  link = (switches as any).announcementLink || "/diensten/",
  linkText = "Bekijk Mogelijkheden &rarr;"
} = Astro.props;
---

<div id="bitblox-announcement-bar" class="bitblox-announcement-bar">
  <div class="announcement-inner">
    <span class="announcement-badge">{badge}</span>
    <span class="announcement-text">{text}</span>
    {link && (
      <a href={link} class="announcement-link" set:html={linkText} />
    )}
  </div>
  <button id="closeAnnouncementBtn" class="announcement-close" aria-label="Sluit melding">&times;</button>
</div>

<style>
  .bitblox-announcement-bar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 40px;
    background: linear-gradient(90deg, #0e121e 0%, #171c2d 50%, #0e121e 100%);
    border-bottom: 1px solid rgba(222, 193, 72, 0.35);
    padding: 0 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: fixed;
    z-index: 1002;
    font-size: 0.83rem;
    box-shadow: 0 4px 20px rgba(0,0,0,0.5);
  }

  .announcement-inner {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    justify-content: center;
    text-align: center;
    color: #e2e8f0;
  }

  .announcement-badge {
    background: rgba(222, 193, 72, 0.15);
    color: #dec148;
    border: 1px solid rgba(222, 193, 72, 0.4);
    font-size: 0.68rem;
    font-weight: 800;
    padding: 2px 8px;
    border-radius: 999px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .announcement-text {
    font-weight: 500;
  }

  .announcement-link {
    color: #dec148;
    font-weight: 700;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .announcement-link:hover {
    color: #ffd700;
    text-decoration: underline;
  }

  .announcement-close {
    position: absolute;
    right: 12px;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    color: #94a3b8;
    font-size: 1.25rem;
    line-height: 1;
    cursor: pointer;
    padding: 4px 8px;
    transition: color 0.2s ease;
  }

  .announcement-close:hover {
    color: #ffffff;
  }

  @media (max-width: 768px) {
    .bitblox-announcement-bar {
      padding-right: 36px;
      font-size: 0.78rem;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const bar = document.getElementById('bitblox-announcement-bar');
    const closeBtn = document.getElementById('closeAnnouncementBtn');

    if (closeBtn && bar) {
      closeBtn.addEventListener('click', () => {
        bar.style.transition = 'all 0.3s ease';
        bar.style.opacity = '0';
        bar.style.maxHeight = '0';
        bar.style.padding = '0';
        bar.style.overflow = 'hidden';
        setTimeout(() => {
          bar.style.display = 'none';
        }, 300);
      });
    }
  });
</script>
