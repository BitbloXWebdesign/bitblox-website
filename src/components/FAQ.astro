---
interface FAQItem {
  q: string;
  a: string;
}

interface Props {
  title?: string;
  subtitle?: string;
  items?: FAQItem[];
}

const defaultItems: FAQItem[] = [
  {
    q: "Wat kost een website laten maken bij BitbloX?",
    a: "Onze prijzen zijn transparant en eenmalig: Brons (€100) voor een strakke 1-page landingpage, Zilver (€250) voor een compacte website van 3 pagina's, Goud (€450 - Meest Gekozen) voor 5 pagina's met maatwerk en blog, en Platina vanaf €650 voor grotere maatwerk sites en regionale microsites."
  },
  {
    q: "Hoe snel staat mijn nieuwe website live?",
    a: "Na het aanleveren van uw wensen, teksten en eventueel logo staat de eerste versie vaak al binnen 3 tot 5 werkdagen klaar in een beveiligde testomgeving."
  },
  {
    q: "Zit ik vast aan maandelijkse abonnementskosten?",
    a: "Nee, de bouwkosten zijn 100% eenmalig. Als u ervoor kiest om ook de hosting, beveiliging en het beheer door BitbloX te laten verzorgen, betaalt u slechts €149 per jaar (Basis) of €210 per jaar (Zorgeloos Bewaakt met Kleine Wijzigingen Service en 24/7 Watchdog)."
  },
  {
    q: "Wordt mijn website goed gevonden in Google én AI (ChatGPT)?",
    a: "Ja! Alle websites worden standaard geleverd met sterke technische SEO (snelle laadtijd, mobiele responsiviteit, SSL). Daarnaast kunt u kiezen voor periodiek zoekmachine-onderhoud en onze AI-vindbaarheid (GEO) module voor ChatGPT en Perplexity."
  },
  {
    q: "Kan ik later mijn website uitbreiden met meer pagina's of functionaliteiten?",
    a: "Ja, al onze websites worden modulair gebouwd. U kunt op elk moment uitbreiden met extra stedenpagina's (microsites), een blog, of extra functies."
  },
  {
    q: "Wat gebeurt er als mijn e-mailbox of opslag na verloop van tijd vol raakt?",
    a: "Geen zorgen. Basis Hosting bevat standaard 3 GB opslag en Zorgeloos Bewaakt een royale 10 GB. Heeft u een zeer groot mailarchief met veel zware bijlagen of extra e-mailadressen nodig? Dan breidt u uw opslag eenvoudig uit (+5 GB voor € 2,95 p/m of +10 GB voor € 4,95 p/m), of stapt u eenvoudig over naar Zorgeloos Bewaakt."
  }
];

const { 
  title = "Veelgestelde vragen", 
  subtitle = "Heeft u vragen over onze werkwijze, tarieven of oplevering? Hier vindt u direct antwoord.",
  items = defaultItems 
} = Astro.props;

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": items.map((item) => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.a
    }
  }))
};
---

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<section class="section section--alt" itemscope itemtype="https://schema.org/FAQPage">
  <div class="container">
    <div class="section-head reveal">
      <span class="kicker">FAQ</span>
      <h2 set:html={title} />
      {subtitle && <p class="lead" set:html={subtitle} />}
    </div>

    <div class="faq-list">
      {items.map((item, index) => (
        <div class="faq-item reveal" itemscope itemprop="mainEntity" itemtype="https://schema.org/Question">
          <button class="faq-q" aria-expanded="false">
            <span itemprop="name">{item.q}</span>
            <span class="faq-chevron">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </span>
          </button>
          <div class="faq-a" itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
            <div class="faq-a-inner" itemprop="text">
              {item.a}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
