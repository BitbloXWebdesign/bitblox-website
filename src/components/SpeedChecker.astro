---
// BitbloX Gratis Website Prestatie & Snelheid Check (Realtime Live Scanner)
---

<section class="section section--alt" id="snelheidscheck">
  <div class="container">
    <div class="section-head reveal">
      <span class="kicker">Gratis Website Quickscan</span>
      <h2>Hoe snel is uw huidige website <span class="gold">op mobiel?</span></h2>
      <p class="lead">Onderzoek van Google toont aan dat meer dan de helft van de mobiele bezoekers afhaakt als een pagina langer dan 3 seconden moet laden. Test uw domein binnen enkele seconden.</p>
    </div>

    <div class="speed-checker-card reveal" style="max-width: 840px; margin: 0 auto; background: var(--surface); border: 1px solid var(--border-gold); border-radius: var(--radius); padding: 36px 28px; box-shadow: var(--shadow);">
      <!-- Invoerformulier -->
      <form id="speedCheckForm" class="speed-form" style="display: flex; gap: 12px; flex-wrap: wrap;">
        <div style="flex: 1; min-width: 260px; position: relative;">
          <input
            type="text"
            id="domainInput"
            name="domain"
            placeholder="Vul uw website in (bijv. uwbedrijf.nl)..."
            required
            autocomplete="off"
            style="width: 100%; padding: 16px 20px; border-radius: var(--radius-sm); background: var(--bg); border: 1px solid var(--border); color: var(--text); font-size: 1rem; outline: none; transition: border-color 0.2s;"
          />
        </div>
        <button
          type="submit"
          id="submitBtn"
          class="btn btn--gold"
          style="padding: 16px 28px; font-weight: 700; display: inline-flex; align-items: center; gap: 8px; white-space: nowrap; cursor: pointer; border: none;"
        >
          <span>⚡ Start Live Meting</span>
        </button>
      </form>

      <!-- Foutmelding -->
      <div id="checkError" style="display: none; margin-top: 16px; padding: 14px 18px; border-radius: var(--radius-sm); background: rgba(239, 68, 68, 0.12); border: 1px solid rgba(239, 68, 68, 0.3); color: #fca5a5; font-size: 0.95rem;">
      </div>

      <!-- Realistische Scanner Loading State (2.2s visual progress) -->
      <div id="checkLoading" style="display: none; text-align: center; padding: 44px 20px;">
        <div style="width: 64px; height: 64px; border: 4px solid var(--border); border-top-color: var(--gold); border-radius: 50%; margin: 0 auto 22px; animation: spin 0.8s linear infinite;"></div>
        <div style="display: inline-block; background: rgba(222, 193, 72, 0.1); border: 1px solid var(--border-gold); padding: 4px 12px; border-radius: 20px; font-size: 0.8rem; color: var(--gold); font-weight: 700; margin-bottom: 10px; text-transform: uppercase; letter-spacing: 0.08em;">
          Live Edge Analyse
        </div>
        <h4 id="loadingStep" style="font-size: 1.2rem; color: var(--text); margin-bottom: 8px;">Verbinding maken met server...</h4>
        <div style="max-width: 380px; height: 6px; background: var(--bg); border-radius: 3px; margin: 16px auto 0; overflow: hidden; border: 1px solid var(--border);">
          <div id="progressBar" style="width: 15%; height: 100%; background: linear-gradient(90deg, var(--gold-dark), var(--gold)); transition: width 0.6s ease;"></div>
        </div>
      </div>

      <!-- Resultaten Dashboard -->
      <div id="checkResults" style="display: none; margin-top: 32px; padding-top: 28px; border-top: 1px solid var(--border);">
        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 24px; flex-wrap: wrap; gap: 12px;">
          <div>
            <span style="font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--muted); font-weight: 600;">Geanalyseerde website:</span>
            <div style="display: flex; align-items: center; gap: 10px; margin-top: 2px;">
              <h3 id="resultDomain" style="font-size: 1.45rem; color: var(--text); margin: 0;">uwbedrijf.nl</h3>
              <span id="platformTag" style="font-size: 0.75rem; background: var(--bg); border: 1px solid var(--border); padding: 3px 8px; border-radius: 4px; color: var(--muted); font-weight: 600;">Platform</span>
            </div>
          </div>
          <button id="resetBtn" style="background: transparent; border: 1px solid var(--border); color: var(--muted); padding: 8px 14px; border-radius: var(--radius-sm); font-size: 0.85rem; cursor: pointer; display: inline-flex; align-items: center; gap: 6px;">
            🔄 Andere website testen
          </button>
        </div>

        <!-- 3 Hoofdkaarten -->
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; margin-bottom: 24px;">
          <!-- Score Card -->
          <div style="background: var(--bg); border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 22px 18px; text-align: center;">
            <span style="font-size: 0.85rem; color: var(--muted); display: block; margin-bottom: 8px;">Prestatiescore</span>
            <div id="scoreDisplay" style="font-size: 2.6rem; font-weight: 800; font-family: var(--font-display); line-height: 1;">--</div>
            <span id="scoreLabel" style="font-size: 0.8rem; font-weight: 600; display: inline-block; margin-top: 8px; padding: 2px 10px; border-radius: 4px;">--</span>
          </div>

          <!-- Laadtijd Card -->
          <div style="background: var(--bg); border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 22px 18px; text-align: center;">
            <span style="font-size: 0.85rem; color: var(--muted); display: block; margin-bottom: 8px;">Mobiele Laadtijd (4G)</span>
            <div id="loadTimeDisplay" style="font-size: 2.6rem; font-weight: 800; font-family: var(--font-display); line-height: 1; color: var(--text);">--</div>
            <span style="font-size: 0.8rem; color: var(--muted); display: inline-block; margin-top: 8px;">Google norm: &lt; 2,5s</span>
          </div>

          <!-- Bezoekersverlies Card -->
          <div style="background: var(--bg); border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 22px 18px; text-align: center;">
            <span style="font-size: 0.85rem; color: var(--muted); display: block; margin-bottom: 8px;">Geschat Klantverlies</span>
            <div id="lossDisplay" style="font-size: 2.6rem; font-weight: 800; font-family: var(--font-display); line-height: 1; color: #f87171;">--</div>
            <span style="font-size: 0.8rem; color: var(--muted); display: inline-block; margin-top: 8px;">Haakt af vóór de pagina laadt</span>
          </div>
        </div>

        <!-- Detail Breakdown Tabel (Transparant & Bewijsbaar) -->
        <div style="background: var(--bg); border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 18px 20px; margin-bottom: 24px;">
          <div style="font-size: 0.85rem; font-weight: 700; color: var(--text); margin-bottom: 12px; display: flex; align-items: center; justify-content: space-between;">
            <span>🔍 Technische Diagnostiek Details</span>
            <span style="font-size: 0.75rem; color: var(--muted); font-weight: 500;">Live gemeten via Edge Probe</span>
          </div>
          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 12px; font-size: 0.88rem;">
            <div>
              <span style="color: var(--muted); display: block; font-size: 0.75rem;">Server Reactietijd (TTFB)</span>
              <strong id="detailTtfb" style="color: var(--text);">-- ms</strong>
            </div>
            <div>
              <span style="color: var(--muted); display: block; font-size: 0.75rem;">HTML Paginagewicht</span>
              <strong id="detailSize" style="color: var(--text);">-- KB</strong>
            </div>
            <div>
              <span style="color: var(--muted); display: block; font-size: 0.75rem;">Externe Bestanden</span>
              <strong id="detailAssets" style="color: var(--text);">-- bestanden</strong>
            </div>
            <div>
              <span style="color: var(--muted); display: block; font-size: 0.75rem;">Gedetecteerde Architectuur</span>
              <strong id="detailPlatform" style="color: var(--gold);">--</strong>
            </div>
          </div>
        </div>

        <!-- Vergelijkingsbox met BitbloX -->
        <div style="background: rgba(222, 193, 72, 0.08); border: 1px solid var(--border-gold); border-radius: var(--radius-sm); padding: 24px; margin-bottom: 16px;">
          <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px;">
            <div style="flex: 1; min-width: 260px;">
              <h4 style="color: var(--gold); font-size: 1.15rem; margin-bottom: 6px; display: flex; align-items: center; gap: 8px;">
                <span>✨</span> Wat als deze website overstapt naar het BitbloX Cloud Netwerk?
              </h4>
              <p style="color: var(--text); font-size: 0.95rem; line-height: 1.5; margin: 0;">
                Uw laadtijd daalt gegarandeerd naar <strong>onder 0,3 seconde</strong> met een <strong>98-100 score</strong>. Nul database-vertraging, maximale mobiele conversie.
              </p>
            </div>
            <div style="display: flex; gap: 12px; flex-wrap: wrap;">
              <a
                id="whatsappCta"
                href="https://wa.me/31630523907"
                target="_blank"
                rel="noopener"
                class="btn btn--gold"
                style="padding: 12px 20px; font-size: 0.95rem; display: inline-flex; align-items: center; gap: 8px;"
              >
                <span>💬 Bespreek via WhatsApp</span>
              </a>
              <a
                id="contactCta"
                href="/contact/"
                class="btn btn--ghost"
                style="padding: 12px 20px; font-size: 0.95rem;"
              >
                Plan telefonisch adviesgesprek
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }
</style>

<script>
  const form = document.getElementById("speedCheckForm");
  const input = document.getElementById("domainInput");
  const loading = document.getElementById("checkLoading");
  const loadingStep = document.getElementById("loadingStep");
  const progressBar = document.getElementById("progressBar");
  const results = document.getElementById("checkResults");
  const errorBox = document.getElementById("checkError");
  const resetBtn = document.getElementById("resetBtn");

  const resultDomain = document.getElementById("resultDomain");
  const platformTag = document.getElementById("platformTag");
  const scoreDisplay = document.getElementById("scoreDisplay");
  const scoreLabel = document.getElementById("scoreLabel");
  const loadTimeDisplay = document.getElementById("loadTimeDisplay");
  const lossDisplay = document.getElementById("lossDisplay");
  const whatsappCta = document.getElementById("whatsappCta");

  const detailTtfb = document.getElementById("detailTtfb");
  const detailSize = document.getElementById("detailSize");
  const detailAssets = document.getElementById("detailAssets");
  const detailPlatform = document.getElementById("detailPlatform");

  if (form) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const rawDomain = input.value.trim();
      if (!rawDomain) return;

      errorBox.style.display = "none";
      form.style.display = "none";
      results.style.display = "none";
      loading.style.display = "block";
      if (progressBar) progressBar.style.width = "20%";

      const fetchPromise = fetch("/api/speedcheck", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ domain: rawDomain })
      }).then(r => r.json());

      if (loadingStep) loadingStep.textContent = "Verbinding maken met server & DNS controleren...";
      await new Promise(r => setTimeout(r, 650));
      if (progressBar) progressBar.style.width = "50%";

      if (loadingStep) loadingStep.textContent = "Server responstijd (TTFB) & paginagewicht meten...";
      await new Promise(r => setTimeout(r, 750));
      if (progressBar) progressBar.style.width = "80%";

      if (loadingStep) loadingStep.textContent = "Mobiele 4G netwerklatency & scripts analyseren...";
      await new Promise(r => setTimeout(r, 700));
      if (progressBar) progressBar.style.width = "100%";

      try {
        const data = await fetchPromise;
        loading.style.display = "none";

        if (!data.success) {
          form.style.display = "flex";
          errorBox.textContent = data.error || "Kon de website niet bereiken. Controleer of het adres klopt.";
          errorBox.style.display = "block";
          return;
        }

        resultDomain.textContent = data.domain;
        platformTag.textContent = data.platform || "Platform";
        const score = data.performanceScore;
        scoreDisplay.textContent = score + "/100";

        if (score >= 90) {
          scoreDisplay.style.color = "#34d399";
          scoreLabel.textContent = "Uitstekend";
          scoreLabel.style.background = "rgba(52, 211, 153, 0.15)";
          scoreLabel.style.color = "#34d399";
        } else if (score >= 50) {
          scoreDisplay.style.color = "#fbbf24";
          scoreLabel.textContent = "Aandacht vereist";
          scoreLabel.style.background = "rgba(251, 191, 36, 0.15)";
          scoreLabel.style.color = "#fbbf24";
        } else {
          scoreDisplay.style.color = "#f87171";
          scoreLabel.textContent = "Traag / Kritiek";
          scoreLabel.style.background = "rgba(248, 113, 113, 0.15)";
          scoreLabel.style.color = "#f87171";
        }

        loadTimeDisplay.textContent = data.mobileLoadSeconds + "s";
        lossDisplay.textContent = "~" + data.visitorLossPercent + "%";

        if (detailTtfb) detailTtfb.textContent = data.ttfbMs + " ms";
        if (detailSize) detailSize.textContent = data.htmlSizeKB + " KB";
        if (detailAssets) detailAssets.textContent = data.totalAssets + " bestanden";
        if (detailPlatform) detailPlatform.textContent = data.platform || "Maatwerk";

        const waMsg = encodeURIComponent("Hallo BitbloX, ik heb zojuist de website snelheidscheck gedaan voor " + data.domain + " (" + data.platform + ", score: " + score + "/100, laadtijd: " + data.mobileLoadSeconds + "s). Ik wil graag vrijblijvend advies over hoe we dit kunnen versnellen.");
        whatsappCta.href = "https://wa.me/31630523907?text=" + waMsg;

        results.style.display = "block";

      } catch(err) {
        loading.style.display = "none";
        form.style.display = "flex";
        errorBox.textContent = "Er is een time-out opgetreden bij het verbinden met de website.";
        errorBox.style.display = "block";
      }
    });
  }

  if (resetBtn) {
    resetBtn.addEventListener("click", () => {
      results.style.display = "none";
      errorBox.style.display = "none";
      form.style.display = "flex";
      input.value = "";
      input.focus();
    });
  }
</script>